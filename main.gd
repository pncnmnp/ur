const DIE_SHADER := """
shader_type spatial;
// Ivory tetrahedron die. Engravings are computed per pixel from the direction to each
// corner, so they stay crisp at any mesh resolution. Corners 0 and 1 are the marked ones.
varying vec3 lp;
const vec3 C[4] = vec3[4](
	vec3(0.57735, 0.57735, 0.57735), vec3(0.57735, -0.57735, -0.57735),
	vec3(-0.57735, 0.57735, -0.57735), vec3(-0.57735, -0.57735, 0.57735));

uniform float look_scale = 1.0;
void vertex() { lp = VERTEX * look_scale; }

float hash(vec3 p) {
	p = fract(p * 0.3183099 + 0.1);
	p *= 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}
float vnoise(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(hash(i), hash(i + vec3(1, 0, 0)), f.x), mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x), f.y),
		mix(mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x), mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}
float band(float t, float a, float b, float s) {
	return smoothstep(a - s, a, t) * (1.0 - smoothstep(b, b + s, t));
}

uniform float seed = 0.0;

void fragment() {
	vec3 d = normalize(lp);
	vec3 q = lp + vec3(seed * 7.13, seed * 3.71, seed * 5.29);
	// old bone: yellowed, blotchy brown stains, grain streaks
	vec3 col = vec3(0.6, 0.5, 0.34);
	float g = vnoise(q * 10.0) * 0.6 + vnoise(q * 34.0) * 0.4;
	col *= 0.86 + 0.18 * g;
	float stain = smoothstep(0.35, 0.7, vnoise(q * 6.5 + 9.0) * 0.7 + vnoise(q * 17.0) * 0.3);
	col = mix(col, vec3(0.38, 0.25, 0.13), stain * 0.75);
	float vein = 1.0 - smoothstep(0.0, 0.05, abs(vnoise(q * vec3(4.5, 14.0, 4.5) + 3.0) - 0.5));
	col = mix(col, col * vec3(0.78, 0.66, 0.48), vein * 0.45);
	// crazing: a fine network of age cracks
	float cz = (1.0 - smoothstep(0.0, 0.025, abs(vnoise(q * 16.0 + 1.7) - 0.5)))
		* smoothstep(0.35, 0.65, vnoise(q * 4.0 + 5.0));
	// scratches from centuries of throwing
	float sc = (1.0 - smoothstep(0.0, 0.018, abs(vnoise(q * vec3(80.0, 3.0, 3.0)) - 0.5))) * step(0.72, vnoise(q * 6.0 + 2.0))
		+ (1.0 - smoothstep(0.0, 0.018, abs(vnoise(q.zxy * vec3(70.0, 3.0, 4.0) + 4.0) - 0.5))) * step(0.75, vnoise(q * 5.0 + 8.0));
	// edges and corners (directions along the axes for this tetrahedron) are rubbed smooth and pale
	// on an edge the two largest face-normal dot products are nearly equal
	float s1 = -2.0;
	float s2 = -2.0;
	for (int k = 0; k < 4; k++) {
		float s = dot(d, -C[k]);
		if (s > s1) { s2 = s1; s1 = s; } else if (s > s2) { s2 = s; }
	}
	float edge = 1.0 - smoothstep(0.0, 0.16, s1 - s2);
	col = mix(col * (1.0 - 0.45 * cz) * (1.0 - 0.2 * sc), col * 1.06, edge * 0.5);
	// handling grime settles into the flat faces
	col *= 1.0 - 0.12 * (1.0 - edge) * vnoise(q * 7.0 + 13.0);

	float h = 0.0;
	float groove = 0.0;
	float inlay_amt = 0.0;
	for (int k = 0; k < 4; k++) {
		float marked = 1.0 - step(1.5, float(k));
		float th = acos(clamp(dot(d, C[k]), -1.0, 1.0));
		float thf = acos(clamp(dot(d, -C[k]), -1.0, 1.0));
		float w = fwidth(th) * 0.8 + 0.003;
		// corner: marked corners get a lapis inlay inside two engraved rings
		float inlay = (1.0 - smoothstep(0.17 - w, 0.17 + w, th)) * marked;
		float r1 = band(th, 0.215, 0.245, w) * marked + band(th, 0.19, 0.22, w) * (1.0 - marked);
		float r2 = band(th, 0.30, 0.322, w) * marked;
		float pit = (1.0 - smoothstep(0.05 - w, 0.05 + w, th)) * (1.0 - marked);
		// face: engraved circle with a centre dot
		float fr = band(thf, 0.47, 0.50, w);
		float fd = 1.0 - smoothstep(0.035 - w, 0.035 + w, thf);
		float gr = max(max(r1, r2), max(max(fr, fd), pit));
		// worn lapis inlay: faded, with chips missing that show the dark socket
		float chip = step(0.62, vnoise(q * 26.0 + float(k) * 3.0));
		vec3 lapis = mix(vec3(0.05, 0.09, 0.3), vec3(0.13, 0.16, 0.3), vnoise(q * 40.0)) * (0.8 + 0.3 * g);
		col = mix(col, mix(lapis, vec3(0.14, 0.09, 0.05), chip), inlay);
		// engravings packed with dark grime, the outer ring with traces of old red pigment
		col = mix(col, vec3(0.32, 0.13, 0.08), r2 * 0.7);
		col = mix(col, vec3(0.16, 0.1, 0.05), gr * (1.0 - r2 * 0.7));
		h -= inlay * (0.008 + chip * 0.006) + gr * 0.014;
		groove = max(groove, gr);
		inlay_amt = max(inlay_amt, inlay * (1.0 - chip));
	}
	h -= cz * 0.004 + sc * 0.003;
	ALBEDO = col;
	ROUGHNESS = clamp(0.62 + groove * 0.3 + cz * 0.15 - inlay_amt * 0.15 - edge * 0.25, 0.2, 1.0);
	SPECULAR = 0.3;

	// bump from the engraving height via screen-space derivatives
	vec3 dpdx = dFdx(VERTEX);
	vec3 dpdy = dFdy(VERTEX);
	vec3 r1v = cross(dpdy, NORMAL);
	vec3 r2v = cross(NORMAL, dpdx);
	float det = dot(dpdx, r1v);
	vec3 grad = sign(det) * (dFdx(h) * r1v + dFdy(h) * r2v);
	NORMAL = normalize(abs(det) * NORMAL - grad);
}
"""

const SAND_SHADER := """
shader_type spatial;
// Desert sand the board rests on. Sand mounds up against everything placed on it
// (rects = centre.xz, half-size.xz) and rolls into low dunes further away.
uniform sampler2D alb_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D nrm_tex : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec4 rects[8];
uniform float rect_rot[8];   // yaw of each rect (radians)
uniform int rect_count = 0;
uniform float tile = 4.0;
varying vec3 wp;

float hash2(vec2 p) {
	p = fract(p * vec2(123.34, 456.21));
	p += dot(p, p + 45.32);
	return fract(p.x * p.y);
}
float vnoise2(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash2(i), hash2(i + vec2(1, 0)), f.x), mix(hash2(i + vec2(0, 1)), hash2(i + vec2(1, 1)), f.x), f.y);
}
float sd_rect(vec2 p, vec4 r, float a) {
	vec2 q = p - r.xy;
	float c = cos(a);
	float s = sin(a);
	q = vec2(q.x * c - q.y * s, q.x * s + q.y * c);   // into the rect's own frame
	vec2 d = abs(q) - r.zw;
	return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
}
float height_at(vec2 p) {
	float d = 1e6;
	for (int i = 0; i < 8; i++) {
		if (i >= rect_count) break;
		d = min(d, sd_rect(p, rects[i], rect_rot[i]));
	}
	if (d < -0.15) return -0.25; // hidden under the object
	float o = max(d, 0.0);
	float berm = 0.034 * exp(-o / 0.28) + 0.014 * exp(-o / 0.07);
	float dunes = (vnoise2(p * 0.11) - 0.5) * 1.1 + (vnoise2(p * 0.37 + 7.0) - 0.5) * 0.18;
	return berm + smoothstep(1.2, 7.0, o) * dunes;
}
void vertex() {
	vec3 w = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	float e = 0.04;
	float h = height_at(w.xz);
	float sx = (height_at(w.xz + vec2(e, 0)) - height_at(w.xz - vec2(e, 0))) / (2.0 * e);
	float sz = (height_at(w.xz + vec2(0, e)) - height_at(w.xz - vec2(0, e))) / (2.0 * e);
	VERTEX.y += h;
	NORMAL = normalize(vec3(-sx, 1.0, -sz));
	TANGENT = normalize(vec3(1.0, sx, 0.0));
	BINORMAL = normalize(cross(NORMAL, TANGENT));
	wp = w + vec3(0.0, h, 0.0);
}
void fragment() {
	vec2 uv = wp.xz / tile;
	vec3 a = texture(alb_tex, uv).rgb;
	vec3 b = texture(alb_tex, uv * 0.29 + vec2(0.37, 0.71)).rgb;
	float macro = vnoise2(wp.xz * 0.22) * 0.6 + vnoise2(wp.xz * 0.8 + 3.0) * 0.4;
	vec3 col = mix(a, b, 0.3) * mix(0.9, 1.07, macro);
	col = mix(col, col * vec3(1.06, 0.96, 0.88), vnoise2(wp.xz * 0.13 + 11.0) * 0.6);
	ALBEDO = col;
	NORMAL_MAP = texture(nrm_tex, uv).rgb;
	NORMAL_MAP_DEPTH = 1.0;
	ROUGHNESS = 0.94;
	SPECULAR = 0.3;
}
"""


