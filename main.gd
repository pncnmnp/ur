## Sand ground, mounded against the board pieces and the dice tray.
func build_sand() -> void:
	var sm := ShaderMaterial.new()
	var sh := Shader.new()
	sh.code = SAND_SHADER
	sm.shader = sh
	sm.set_shader_parameter("alb_tex", tex("res://assets/sand_albedo.png"))
	sm.set_shader_parameter("nrm_tex", tex("res://assets/sand_normal.png"))
	var tc := tray_xf() * Vector3(TRAY.get_center().x, 0, TRAY.get_center().y)
	var rects := PackedVector4Array([
		Vector4(0, 0, 4.25, 1.75),                                                          # board
		Vector4(STRIP_PLACE[HUMAN].x, STRIP_PLACE[HUMAN].y, 3.7, 0.45),                     # reserve strips
		Vector4(STRIP_PLACE[AI].x, STRIP_PLACE[AI].y, 3.7, 0.45),
		Vector4(plate_xf(HUMAN).origin.x, plate_xf(HUMAN).origin.z, HOME_SIZE.x / 2, HOME_SIZE.y / 2),  # home plates
		Vector4(plate_xf(AI).origin.x, plate_xf(AI).origin.z, HOME_SIZE.x / 2, HOME_SIZE.y / 2),
		Vector4(tc.x, tc.z, TRAY.size.x / 2 + 0.3, TRAY.size.y / 2 + 0.3),                  # dice tray
		Vector4(TABLET_POS.x, TABLET_POS.z, TABLET_SIZE.x / 2 - 0.05, TABLET_SIZE.z / 2 - 0.1),  # clay tablet
		Vector4(BOWL_POS.x, BOWL_POS.z, 3.5 * DateBowl.CM, -1.0),                          # the bowl of dates (round)
	])
	var rots := PackedFloat32Array([BOARD_YAW, STRIP_PLACE[HUMAN].z, STRIP_PLACE[AI].z,
		PLATE_NUDGE[HUMAN].z, PLATE_NUDGE[AI].z, TRAY_NUDGE.z, 4.0, 0.0])
	var cs := PackedVector2Array()
	for r in rots:
		cs.append(Vector2(cos(deg_to_rad(r)), sin(deg_to_rad(r))))
	sm.set_shader_parameter("rects", rects)
	sm.set_shader_parameter("rect_cs", cs)
	sm.set_shader_parameter("rect_top", PackedFloat32Array([BY, BY, BY, BY, BY, TRAY_RIM_H, TABLET_POS.y + 0.06, 0.16]))
	sm.set_shader_parameter("rect_count", rects.size())
	sm.set_shader_parameter("wind", SAND_WIND)
	var mi := MeshInstance3D.new()
	mi.mesh = sand_mesh(Rect2(-29.5, -24.0, 56.0, 40.0), Rect2(-10.6, -5.2, 18.2, 12.0), 0.045, 0.12)
	mi.material_override = sm
	mi.extra_cull_margin = 1.0
	add_child(mi)


## A flat grid for the sand over `area` (x, z): `fine` spacing over `near` (the table,
## where the drifts against the board and tray need it), `coarse` beyond.
func sand_mesh(area: Rect2, near: Rect2, fine: float, coarse: float) -> ArrayMesh:
	var axis := func(lo: float, hi: float, nlo: float, nhi: float) -> PackedFloat32Array:
		var out := PackedFloat32Array()
		var x := lo
		while x < hi:
			out.append(x)
			x += fine if x >= nlo - coarse and x < nhi + coarse else coarse
		out.append(hi)
		return out
	var xs: PackedFloat32Array = axis.call(area.position.x, area.end.x, near.position.x, near.end.x)
	var zs: PackedFloat32Array = axis.call(area.position.y, area.end.y, near.position.y, near.end.y)
	var verts := PackedVector3Array()
	var uvs := PackedVector2Array()
	verts.resize(xs.size() * zs.size())
	uvs.resize(verts.size())
	var k := 0
	for z in zs:
		for x in xs:
			verts[k] = Vector3(x, 0.0, z)
			uvs[k] = Vector2(x, z)
			k += 1
	var idx := PackedInt32Array()
	var w := xs.size()
	idx.resize((xs.size() - 1) * (zs.size() - 1) * 6)
	k = 0
	for j in zs.size() - 1:
		for i in w - 1:
			var a := j * w + i
			idx[k] = a
			idx[k + 1] = a + 1
			idx[k + 2] = a + w
			idx[k + 3] = a + 1
			idx[k + 4] = a + w + 1
			idx[k + 5] = a + w
			k += 6
	var arr := []
	arr.resize(Mesh.ARRAY_MAX)
	arr[Mesh.ARRAY_VERTEX] = verts
	arr[Mesh.ARRAY_TEX_UV] = uvs
	var nrm := PackedVector3Array()
	nrm.resize(verts.size())
	nrm.fill(Vector3.UP)
	arr[Mesh.ARRAY_NORMAL] = nrm
	arr[Mesh.ARRAY_INDEX] = idx
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	mesh.custom_aabb = AABB(Vector3(area.position.x, -2.0, area.position.y), Vector3(area.size.x, 4.0, area.size.y))
	return mesh


## The tray's leather lining as a real surface: gently pillowed, and bulging up where
## the bitumen glue has failed (heights from assets/leather_lift.png, made by
## tools/make_textures.py). It is glued down everywhere else, so the dice, which roll
## on the flat floor collider, never notice the small difference.
const LEATHER_LIFT_MAX := 0.13
func leather_mesh(size: Vector2) -> ArrayMesh:
	var img: Image = (load("res://assets/leather_lift.png") as Texture2D).get_image()
	if img.is_compressed():
		img.decompress()
	var nx := 150
	var nz := 198
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for j in nz + 1:
		for i in nx + 1:
			var uv := Vector2(float(i) / nx, float(j) / nz)
			var px := uv * Vector2(img.get_width() - 1, img.get_height() - 1)
			# bilinear sample of the lift map
			var x0 := int(px.x)
			var y0 := int(px.y)
			var x1 := mini(x0 + 1, img.get_width() - 1)
			var y1 := mini(y0 + 1, img.get_height() - 1)
			var fx := px.x - x0
			var fy := px.y - y0
			var h := lerpf(lerpf(img.get_pixel(x0, y0).r, img.get_pixel(x1, y0).r, fx),
				lerpf(img.get_pixel(x0, y1).r, img.get_pixel(x1, y1).r, fx), fy)
			st.set_uv(uv)
			st.add_vertex(Vector3((uv.x - 0.5) * size.x, h * LEATHER_LIFT_MAX, (uv.y - 0.5) * size.y))
	for j in nz:
		for i in nx:
			var a := j * (nx + 1) + i
			var b := a + 1
			var c := a + nx + 1
			var d := c + 1
			for idx in [a, b, c, b, d, c]:
				st.add_index(idx)
	st.generate_normals()
	st.generate_tangents()
	return st.commit()


const RIM_SHADER := """
shader_type spatial;
// A rim board of the dice tray after generations of use. The weathered plank texture
// is mapped triplanar in the board's own space (grain along x); on top of it, wear that
// depends on where the surface is: dice dings on the inner face, edges rubbed pale and
// smooth by hands with chips knocked out, splits running in from the plank ends,
// scratches along the grain, a sun-bleached top, and grime and sand packed into the base.
uniform sampler2D alb_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D rough_tex : hint_roughness_r, filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec3 uv_scale = vec3(0.24, 0.9, 0.9);
uniform vec3 uv_off;
uniform vec3 half_size;
uniform vec3 inner_dir;   // the face that looks into the tray (board-local)
varying vec3 lp;
varying vec3 ln;

float hash(vec3 p) {
	p = fract(p * 0.3183099 + 0.1);
	p *= 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}
float vnoise(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(hash(i), hash(i + vec3(1, 0, 0)), f.x), mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x), f.y),
		mix(mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x), mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}
vec4 tri(sampler2D t, vec3 p, vec3 w) {
	return texture(t, p.xy) * w.z + texture(t, p.zy) * w.x + texture(t, p.xz) * w.y;
}
void vertex() {
	lp = VERTEX;
	ln = NORMAL;
}
void fragment() {
	vec3 w = pow(abs(ln), vec3(4.0));
	w /= (w.x + w.y + w.z);
	vec3 tp = lp * uv_scale + uv_off;
	vec3 col = tri(alb_tex, tp, w).rgb;
	float rough = tri(rough_tex, tp, w).r;
	float lum = dot(col, vec3(0.333));
	vec3 q = lp + uv_off * 7.0;

	// where on the board we are, from position (not interpolated normals):
	// distance in from each pair of faces gives the edges
	vec3 d = half_size - abs(lp);
	float e_yz = 1.0 - smoothstep(0.0, 0.085, max(d.y, d.z));
	float e_xy = 1.0 - smoothstep(0.0, 0.085, max(d.x, d.y));
	float e_xz = 1.0 - smoothstep(0.0, 0.085, max(d.x, d.z));
	float edge = max(e_yz, max(e_xy, e_xz));
	float top = smoothstep(half_size.y - 0.07, half_size.y - 0.01, lp.y);
	float inner = smoothstep(half_size.z - 0.07, half_size.z - 0.01, dot(lp, inner_dir));
	float base = 1.0 - smoothstep(-half_size.y, -half_size.y + 0.14, lp.y);
	float hand = edge * smoothstep(0.0, 0.5, lp.y / half_size.y + 0.4);   // upper edges get handled

	// domain-warped noise so chips and dings come out as irregular blobs, not grid squares
	vec3 wq = q + vec3(vnoise(q * 4.0), vnoise(q * 4.0 + 17.0), vnoise(q * 4.0 + 31.0)) * 0.35;
	float chip = edge * smoothstep(0.7, 0.8, vnoise(wq * 11.0)) * smoothstep(0.3, 0.6, vnoise(wq * 2.3 + 5.0));
	float ding = smoothstep(0.76, 0.84, vnoise(wq * 15.0 + 3.0)) * (0.2 + 0.8 * inner) * (1.0 - top * 0.6);
	float ding2 = smoothstep(0.88, 0.93, vnoise(wq * 41.0 + 9.0)) * inner;
	float scr = (1.0 - smoothstep(0.0, 0.035, abs(vnoise(wq * vec3(1.6, 55.0, 55.0)) - 0.5))) * smoothstep(0.55, 0.7, vnoise(wq * 3.0 + 7.0));
	float endz = smoothstep(half_size.x - 0.45, half_size.x - 0.04, abs(lp.x));
	float split = (1.0 - smoothstep(0.0, 0.022, abs(vnoise(q * vec3(2.5, 26.0, 26.0) + 11.0) - 0.5))) * endz;
	float grime_n = vnoise(q * 6.0 + 2.0);
	float sand_n = smoothstep(0.45, 0.8, vnoise(q * 18.0 + 5.0));

	// sun-bleached top, greyer and paler
	col = mix(col, vec3(lum) * vec3(1.12, 1.02, 0.88) * 1.15, top * 0.28);
	// hand-polished upper edges: paler, worn through the weathered surface
	col = mix(col, col * 1.15 + vec3(0.015, 0.01, 0.0), hand * 0.4);
	// chips expose fresher fibres, dings and splits hold dark grime
	col = mix(col, vec3(0.27, 0.17, 0.1) * (0.8 + 0.4 * grime_n), chip * 0.75);
	col *= 1.0 - 0.45 * ding - 0.35 * ding2;
	col *= 1.0 - 0.3 * scr;
	col *= 1.0 - 0.75 * split;
	// grime and sand packed into the base
	col = mix(col, col * 0.5, base * (0.55 + 0.3 * grime_n));
	col = mix(col, vec3(0.7, 0.56, 0.38), clamp(base * sand_n * 0.55 + ding * sand_n * 0.3, 0.0, 1.0));
	col *= 0.93 + 0.1 * grime_n;
	ALBEDO = col;
	ROUGHNESS = clamp(rough - hand * 0.3 + base * 0.15 + chip * 0.1 + ding * 0.1, 0.25, 1.0);
	SPECULAR = 0.4;

	// relief: raised weathered latewood (darker), dents, chips, scratches and splits
	float h = (0.5 - lum) * 0.0025 - ding * 0.014 - ding2 * 0.004 - chip * 0.012 - scr * 0.002 - split * 0.006;
	vec3 dpdx = dFdx(VERTEX);
	vec3 dpdy = dFdy(VERTEX);
	vec3 r1v = cross(dpdy, NORMAL);
	vec3 r2v = cross(NORMAL, dpdx);
	float det = dot(dpdx, r1v);
	vec3 grad = sign(det) * (dFdx(h) * r1v + dFdy(h) * r2v);
	NORMAL = normalize(abs(det) * NORMAL - grad);
}
"""


func rim_mat(offset: Vector3, half: Vector3, inner_dir: Vector3) -> ShaderMaterial:
	var m := ShaderMaterial.new()
	var sh := Shader.new()
	sh.code = RIM_SHADER
	m.shader = sh
	m.set_shader_parameter("alb_tex", tex("res://assets/plank_albedo.png"))
	m.set_shader_parameter("rough_tex", tex("res://assets/plank_rough.png"))
	m.set_shader_parameter("uv_off", offset)
	m.set_shader_parameter("half_size", half)
	m.set_shader_parameter("inner_dir", inner_dir)
	return m


func plank_mat(offset: Vector3) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_texture = tex("res://assets/plank_albedo.png")
	m.normal_enabled = true
	m.normal_texture = tex("res://assets/plank_normal.png")
	m.normal_scale = 1.3
	m.roughness = 1.0
	m.roughness_texture = tex("res://assets/plank_rough.png")
	m.uv1_triplanar = true
	m.uv1_triplanar_sharpness = 4.0
	m.uv1_scale = Vector3(0.24, 0.9, 0.9) # texture is 4 x 1 units, grain along local x
	m.uv1_offset = offset
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	return m


func build_tray() -> void:
	# everything is built in the square TRAY layout under a root that sets it down
	# slightly askew; the physics walls are children too, so the dice feel the real tray
	var tray_root := Node3D.new()
	tray_root.transform = tray_xf()
	add_child(tray_root)
	# tanned leather lining, tacked down along its edges
	var leather := StandardMaterial3D.new()
	leather.albedo_texture = tex("res://assets/leather_albedo.png")
	leather.normal_enabled = true
	leather.normal_texture = tex("res://assets/leather_normal.png")
	leather.normal_scale = 1.4
	leather.roughness = 1.0
	leather.roughness_texture = tex("res://assets/leather_rough.png")
	# real depth: grain, folds, dents and tacks shift with the viewing angle
	leather.heightmap_enabled = true
	leather.heightmap_texture = tex("res://assets/leather_height.png")
	leather.heightmap_scale = 0.9
	leather.heightmap_deep_parallax = true
	leather.heightmap_min_layers = 8
	leather.heightmap_max_layers = 24
	# a little burnished sheen from centuries of hands and dice
	leather.clearcoat_enabled = true
	leather.clearcoat = 0.18
	leather.clearcoat_roughness = 0.55
	leather.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	# (a little oversized so it tucks under the rim boards)
	var lm := MeshInstance3D.new()
	lm.mesh = leather_mesh(TRAY.size + Vector2(0.16, 0.16))
	lm.material_override = leather
	lm.position = Vector3(TRAY.get_center().x, 0.012, TRAY.get_center().y)
	lm.layers = 1 | DUSTED
	tray_root.add_child(lm)
	# sand blown over the rim lies on the boards' tops and along the foot of the walls inside
	add_dust("tray", tray_root, Vector3(TRAY.size.x + 2 * TRAY_RIM_T, 1.0, TRAY.size.y + 2 * TRAY_RIM_T),
		Vector3(TRAY.get_center().x, 0.3, TRAY.get_center().y))

	# rim: four weathered planks with rounded edges, grain running lengthwise.
	# The long side boards overlap the ends and are pinned with dowels.
	var cx := TRAY.get_center().x
	var cz := TRAY.get_center().y
	var t := TRAY_RIM_T
	var rim_h := TRAY_RIM_H
	var side_len := TRAY.size.y + 2 * t
	var walls := [
		[Vector3(t, 4, side_len), Vector3(TRAY.position.x - t / 2, 2, cz)],
		[Vector3(t, 4, side_len), Vector3(TRAY.end.x + t / 2, 2, cz)],
		[Vector3(TRAY.size.x, 4, t), Vector3(cx, 2, TRAY.position.y - t / 2)],
		[Vector3(TRAY.size.x, 4, t), Vector3(cx, 2, TRAY.end.y + t / 2)],
	]
	var side_mesh := rounded_box(Vector3(side_len, rim_h, t), 0.06)
	var end_mesh := rounded_box(Vector3(TRAY.size.x + 0.04, rim_h - 0.02, t), 0.06)
	var peg_mat := plank_mat(Vector3(0.5, 0.3, 0.1))
	peg_mat.albedo_color = Color(0.55, 0.45, 0.38)
	tray_walls.clear()
	for wi in 4:
		var w: Array = walls[wi]
		var board := MeshInstance3D.new()
		board.mesh = side_mesh if wi < 2 else end_mesh
		# board-local: length along x, height y, thickness z; the side boards are turned
		# 90 degrees, so "into the tray" is +z / -z in their own space
		var half: Vector3 = (Vector3(side_len, rim_h, t) if wi < 2 else Vector3(TRAY.size.x + 0.04, rim_h - 0.02, t)) / 2.0
		var inner_dir: Vector3 = [Vector3(0, 0, 1), Vector3(0, 0, -1), Vector3(0, 0, 1), Vector3(0, 0, -1)][wi]
		board.material_override = rim_mat(Vector3(0.37 * wi, 0.29 * wi, 0.11 * wi), half, inner_dir)
		board.position = Vector3(w[1].x, (rim_h if wi < 2 else rim_h - 0.02) / 2.0, w[1].z)
		if wi < 2:
			board.rotation_degrees.y = 90.0
		board.layers = 1 | DUSTED
		tray_root.add_child(board)
		if wi < 2:
			for zend in [TRAY.position.y - t / 2, TRAY.end.y + t / 2]:
				var peg := MeshInstance3D.new()
				var cyl := CylinderMesh.new()
				cyl.top_radius = 0.045
				cyl.bottom_radius = 0.045
				cyl.height = 0.03
				cyl.radial_segments = 20
				peg.mesh = cyl
				peg.material_override = peg_mat
				peg.position = Vector3(w[1].x, rim_h - 0.008, zend)
				tray_root.add_child(peg)
	for w in walls:
		var body := StaticBody3D.new()
		var cs := CollisionShape3D.new()
		var sh := BoxShape3D.new()
		sh.size = w[0]
		cs.shape = sh
		body.add_child(cs)
		body.position = w[1]
		var wpm := PhysicsMaterial.new()
		wpm.bounce = 0.2
		wpm.friction = 0.45
		body.physics_material_override = wpm
		tray_root.add_child(body)
		tray_walls.append(body)


func build_pieces() -> void:
	for p in 2:
		for i in UrGame.PIECES:
			var mi := MeshInstance3D.new()
			mi.mesh = make_stone(1000 * p + i * 7 + 3)
			var m := stone_mat(p == HUMAN)
			mi.material_override = m
			mi.rotation.y = randf() * TAU
			add_child(mi)
			pnodes[p].append(mi)
			pmats[p].append(m)


func build_dice() -> void:
	# regular tetrahedron corner directions; corners 0 and 1 are the marked ones
	var raw := [Vector3(1, 1, 1), Vector3(1, -1, -1), Vector3(-1, 1, -1), Vector3(-1, -1, 1)]
	var corners: Array = []
	var nrm: Array = []
	for v in raw:
		corners.append(v.normalized())
		nrm.append(-v.normalized())
	var s: float = DIE_R / die_radius(corners[0], nrm)
	for c in corners:
		die_verts.append(c * DIE_R)
	var fn := func(dir: Vector3) -> Vector3:
		return dir * die_radius(dir, nrm) * s
	var dmesh := grid_mesh(fn, 56, 112)
	var sm := ShaderMaterial.new()
	var sh := Shader.new()
	sh.code = DIE_SHADER
	sm.shader = sh
	var shape := dmesh.create_convex_shape(true, true)
	var dpm := PhysicsMaterial.new()
	dpm.friction = 0.8
	dpm.bounce = 0.08
	for i in 4:
		var rb := RigidBody3D.new()
		rb.mass = 0.6
		rb.linear_damp = 0.3
		rb.angular_damp = 1.4
		rb.continuous_cd = true
		rb.freeze_mode = RigidBody3D.FREEZE_MODE_KINEMATIC
		rb.contact_monitor = true
		rb.max_contacts_reported = 8
		rb.physics_material_override = dpm
		var cs := CollisionShape3D.new()
		cs.shape = shape
		rb.add_child(cs)
		var mi := MeshInstance3D.new()
		mi.mesh = dmesh
		var dm: ShaderMaterial = sm.duplicate()
		dm.set_shader_parameter("seed", float(i) * 1.7 + 0.3)
		dm.set_shader_parameter("look_scale", DIE_LOOK_R / DIE_R) # each die has its own stains and cracks
		mi.material_override = dm
		rb.add_child(mi)
		rb.position = tray_xf() * Vector3(TRAY.get_center().x + (i % 2) * 1.0 - 0.5, 0.5, TRAY.get_center().y + (i >> 1) * 1.2 - 0.6)
		add_child(rb)
		dice_bodies.append(rb)
		die_prev_v.append(Vector3.ZERO)
		die_prev_w.append(Vector3.ZERO)
	grip = DiceGrip.new(dice_bodies, corners, DIE_R, DIE_K, DIE_H)
	grip.tray = tray_xf()
	grip.tray_rect = TRAY
	grip.rim_top = TRAY_RIM_H
	grip.rim_t = TRAY_RIM_T


# ----------------------------------------------------------------------- UI
# Almost no screen UI: messages are scratched into a clay tablet lying in the sand,
# the dice are read by looking at them, and the title fades away once play starts.
# The only overlay is a faint "new game" link in the corner.

const TABLET_SHADER := """
shader_type spatial;
// Sun-dried clay tablet, old and handled. The current message (white on black, from a
// SubViewport) is pressed into the top face: darkened in the grooves and given real relief
// through the normal, so the low sun picks out every stroke. The slab is hand-formed (domed
// top, wavering outline), its edges and corners crumbled, a flake knocked out of the front
// edge and a nick off the far corner; drying cracks, pits and shallow spalls hold sand.
uniform sampler2D text_tex : filter_linear;
uniform vec3 size;
uniform float ink = 1.0;      // 0..1, fades a message in and out
varying vec3 lp;
varying vec3 ln;
varying float v_chip;         // 1 on the broken faces of a chip

float hash(vec3 p) {
	p = fract(p * 0.3183099 + 0.1);
	p *= 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}
float vnoise(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(hash(i), hash(i + vec3(1, 0, 0)), f.x), mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x), f.y),
		mix(mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x), mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}
float mask(vec2 uv, vec2 px) {
	// soft V-shaped groove profile from a small blur of the crisp text
	float m = 0.0;
	for (int i = -1; i <= 1; i++)
		for (int j = -1; j <= 1; j++)
			m += texture(text_tex, uv + vec2(float(i), float(j)) * px * 1.6).r;
	return m / 9.0;
}

// A chip: an ellipsoidal bite (centre c, radii r) with a ragged, stepped fracture surface.
// Points inside are pushed out onto it; returns how far they moved.
float chip(inout vec3 p, inout vec3 n, vec3 c, vec3 r, float seed) {
	vec3 q = (p - c) / r;
	float d = length(q);
	vec3 dir = q / max(d, 1e-4);
	// ragged outline and conchoidal steps
	float rr = 1.0 + 0.22 * (vnoise(dir * 3.0 + seed) - 0.5) + 0.1 * (vnoise(dir * 9.0 + seed * 2.0) - 0.5);
	rr += 0.035 * sin(d * 40.0 + vnoise(dir * 5.0 + seed) * 6.0);
	if (d < rr) {
		vec3 np = c + dir * rr * r;
		float moved = length(np - p);
		p = np;
		n = -normalize(dir / r);
		return moved + 1e-3;
	}
	return 0.0;
}

void vertex() {
	lp = VERTEX;
	vec3 h = size * 0.5;
	vec3 n = NORMAL;
	vec3 p = VERTEX;
	// crumbled edges and corners: the clay wears back most where two faces meet
	vec3 e = smoothstep(h - 0.16, h, abs(p));
	float edge = max(max(e.x * e.y, e.y * e.z), e.x * e.z);
	float corner = e.x * e.y * e.z;
	float crumb = vnoise(p * 7.0 + 3.0) * 0.7 + vnoise(p * 19.0) * 0.3;
	p -= n * (edge * (0.012 + 0.05 * crumb * crumb) + corner * 0.05 * crumb);
	// hand-formed: a softly domed (pillowed) top and a slightly wavering outline
	vec2 q = p.xz / (size.xz * 0.5);
	float topw = smoothstep(0.0, size.y * 0.5, p.y);
	float dome = 0.045 * (1.0 - q.x * q.x) * (1.0 - q.y * q.y);
	p.y += dome * topw;
	float wob = vnoise(vec3(p.xz * 1.3, 4.0)) - 0.5;
	p.xz += normalize(p.xz + 1e-4) * wob * 0.06;
	// a flake knocked out of the front edge, and a nick off the far left corner
	float c1 = chip(p, n, vec3(h.x * 0.6, h.y + 0.08, h.z + 0.05), vec3(0.36, 0.2, 0.24), 1.7);
	float c2 = chip(p, n, vec3(-h.x - 0.02, h.y + 0.06, -h.z - 0.02), vec3(0.2, 0.17, 0.18), 5.3);
	v_chip = clamp((c1 + c2) * 40.0, 0.0, 1.0);
	ln = n;
	VERTEX = p;
	NORMAL = n;
}

// relief of the weathered surface (local units): cracks and pits are dips, spalls are
// shallow scalloped hollows where a skin of clay has flaked away
float relief(vec3 x, out float crack, out float pit, out float spall) {
	crack = (1.0 - smoothstep(0.0, 0.03, abs(vnoise(x * 8.0 + 2.0) - 0.5))) * smoothstep(0.5, 0.72, vnoise(x * 1.6 + 9.0));
	float hair = (1.0 - smoothstep(0.0, 0.025, abs(vnoise(x * 21.0 + 7.0) - 0.5))) * smoothstep(0.55, 0.8, vnoise(x * 3.0 + 1.0));
	crack = max(crack, hair * 0.6);
	pit = smoothstep(0.74, 0.9, vnoise(x * 40.0)) + 0.6 * smoothstep(0.8, 0.95, vnoise(x * 13.0 + 5.0));
	spall = smoothstep(0.62, 0.7, vnoise(x * 3.3 + 17.0)) * smoothstep(0.35, 0.6, vnoise(x * 1.1 + 2.0));
	float grain = vnoise(x * 60.0) * 0.5 + vnoise(x * 24.0) * 0.5;
	return -0.012 * crack - 0.0035 * pit - 0.005 * spall + 0.0018 * grain;
}

float fracture(vec3 x) {
	return 0.006 * vnoise(x * 34.0) + 0.003 * vnoise(x * 80.0) + 0.01 * smoothstep(0.4, 0.6, vnoise(x * 11.0 + 3.0));
}

void fragment() {
	vec3 h = size * 0.5;
	float crack, pit, spall;
	float H = relief(lp, crack, pit, spall);
	float c_, p_, s_;
	float ee = 0.004;
	vec3 g = vec3(relief(lp + vec3(ee, 0, 0), c_, p_, s_) - H,
		relief(lp + vec3(0, ee, 0), c_, p_, s_) - H,
		relief(lp + vec3(0, 0, ee), c_, p_, s_) - H) / ee;

	// the clay as it was: unchanged colour, mottled by the firing sun and the hand
	vec3 col = vec3(0.36, 0.2, 0.11);
	float gr = vnoise(lp * 7.0) * 0.6 + vnoise(lp * 26.0) * 0.4;
	col *= 0.84 + 0.26 * gr;
	col = mix(col, col * vec3(0.82, 0.76, 0.7), smoothstep(0.5, 0.8, vnoise(lp * 2.2 + 4.0)) * 0.6);
	// worn edges: rubbed paler and smoother where hands and sand have scoured it
	vec3 e = smoothstep(h - 0.14, h, abs(lp));
	float edge = max(max(e.x * e.y, e.y * e.z), e.x * e.z);
	float rub = edge * (0.5 + 0.5 * vnoise(lp * 11.0));
	col = mix(col, col * vec3(1.22, 1.16, 1.08), rub * 0.6);
	// spalled hollows: a fresher, paler, coarser skin under the weathered one
	col = mix(col, col * vec3(1.18, 1.1, 1.0) * (0.92 + 0.16 * vnoise(lp * 50.0)), spall * 0.55);
	// faint salt bloom that has come up out of the clay
	float salt = smoothstep(0.62, 0.85, vnoise(lp * vec3(4.0, 9.0, 4.0) + 23.0)) * (0.4 + 0.6 * vnoise(lp * 30.0));
	col = mix(col, vec3(0.6, 0.5, 0.42), salt * 0.12);
	// cracks and pits are dark, then half-filled with fine sand
	col *= 1.0 - 0.5 * crack - 0.25 * pit;
	vec3 sand = vec3(0.6, 0.45, 0.29);
	col = mix(col, sand, (crack * 0.35 + pit * 0.25) * smoothstep(0.4, 0.7, vnoise(lp * 17.0 + 3.0)));
	// sand dusted up the lower sides where it lies half-buried
	float low = 1.0 - smoothstep(-h.y, h.y * 0.6, lp.y);
	col = mix(col, sand * 0.9, low * 0.35 * (0.5 + 0.5 * vnoise(lp * 9.0)));

	// the chip's broken faces: crisp, granular, the clay inside less weathered
	float ch = v_chip;
	vec3 inside = vec3(0.38, 0.21, 0.115) * (0.82 + 0.3 * vnoise(lp * 70.0)) * (0.9 + 0.2 * vnoise(lp * 12.0));
	col = mix(col, inside, ch);

	float top = smoothstep(0.75, 0.97, ln.y) * (1.0 - ch);
	col *= 1.0 - 0.12 * (1.0 - top);  // sides weathered darker
	vec2 uv = vec2(lp.x / size.x + 0.5, lp.z / size.z + 0.5);
	vec2 px = 1.0 / vec2(textureSize(text_tex, 0));
	float k = ink * top;
	float m = mask(uv, px) * k;
	float mx = (mask(uv + vec2(px.x * 2.0, 0.0), px) - mask(uv - vec2(px.x * 2.0, 0.0), px)) * k;
	float mz = (mask(uv + vec2(0.0, px.y * 2.0), px) - mask(uv - vec2(0.0, px.y * 2.0), px)) * k;
	col = mix(col, col * vec3(0.46, 0.36, 0.28), m * 0.8);
	// a little sand caught in the bottom of the strokes
	col = mix(col, sand * 0.75, smoothstep(0.55, 0.95, m) * 0.18 * smoothstep(0.45, 0.75, vnoise(lp * 23.0)));
	ALBEDO = col;
	ROUGHNESS = clamp(0.9 + 0.06 * m - 0.12 * rub + 0.06 * ch, 0.0, 1.0);
	SPECULAR = 0.2;

	// relief: weathering everywhere, text grooves on the top, facets on the broken faces
	vec3 n = normalize(ln);
	// the fracture has its own coarse, granular, stepped relief instead of cracks and pits
	if (ch > 0.0) {
		float f0 = fracture(lp);
		vec3 fg = vec3(fracture(lp + vec3(ee, 0, 0)) - f0, fracture(lp + vec3(0, ee, 0)) - f0, fracture(lp + vec3(0, 0, ee)) - f0) / ee;
		g = mix(g * 0.8, fg, ch);
	}
	n = normalize(n - (g - dot(g, n) * n) * 0.8);
	n = normalize(mix(n, normalize(vec3(mx * 3.0, 1.0, mz * 3.0)), top));
	NORMAL = normalize((VIEW_MATRIX * MODEL_MATRIX * vec4(n, 0.0)).xyz);
}
"""


func build_tablet() -> void:
	# the message is drawn white-on-black into a small offscreen viewport...
	var vp := SubViewport.new()
	vp.size = Vector2i(1024, int(1024 * TABLET_SIZE.z / TABLET_SIZE.x))
	vp.transparent_bg = false
	vp.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	add_child(vp)
	var bg := ColorRect.new()
	bg.color = Color.BLACK
	bg.size = Vector2(vp.size)
	vp.add_child(bg)
	tablet_label = Label.new()
	tablet_label.size = Vector2(vp.size) - Vector2(120, 60)
	tablet_label.position = Vector2(60, 30)
	tablet_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	tablet_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	tablet_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	tablet_label.add_theme_font_override("font", ui_font)
	tablet_label.add_theme_font_size_override("font_size", 90)
	tablet_label.add_theme_constant_override("line_spacing", -6)
	tablet_label.add_theme_color_override("font_color", Color.WHITE)
	vp.add_child(tablet_label)
	# ...and pressed into the clay
	tablet_mat = ShaderMaterial.new()
	var sh := Shader.new()
	sh.code = TABLET_SHADER
	tablet_mat.shader = sh
	tablet_mat.set_shader_parameter("text_tex", vp.get_texture())
	tablet_mat.set_shader_parameter("size", TABLET_SIZE)
	tablet_mat.set_shader_parameter("ink", 0.0)
	var mi := MeshInstance3D.new()
	mi.mesh = rounded_box(TABLET_SIZE, 0.09, 6, 0.035)   # fine enough to carve the chip
	mi.material_override = tablet_mat
	mi.position = TABLET_POS
	mi.rotation_degrees = Vector3(8, 4, 0) # propped toward the players, half sunk in the sand
	mi.layers = 1 | DUSTED
	add_child(mi)
	add_dust("tablet", mi, Vector3(TABLET_SIZE.x, 0.3, TABLET_SIZE.z), Vector3(0, TABLET_SIZE.y / 2, 0))


func build_ui() -> void:
	build_tablet()
	var layer := CanvasLayer.new()
	add_child(layer)
