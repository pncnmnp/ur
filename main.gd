extends Node3D
## Royal Game of Ur in 3D: human (white stones, near side) vs AI (black stones, far side).
## Roll the physics dice in the left tray, then drag a stone forward by the roll
## (or click the stone, then its destination square).
##
## Layout (world units, board squares are 1x1, x = column, z = row):
##   board        x -4..4,  z -1.5..1.5   (human lane z=+1, AI lane z=-1, shared z=0)
##   reserves     strips above/below the board (z = -2.4 AI, +2.4 human)
##   home stacks  right of the board (x = 5)
##   dice tray    left of the board
## Textures live in assets/ and are generated by tools/make_textures.py.

const HUMAN := 0
const AI := 1
const BY := 0.06            # board surface height
const PIECE_H := 0.26
const PIECE_R := 0.34
const LIFT := 0.55          # height of a stone carried by the mouse
const TRAY := Rect2(-8.6, -2.4, 3.6, 4.8)   # (x, z) rectangle of the dice tray
const DIE_R := 0.30         # distance from die centre to a corner (four fit inside a closed fist)
const DIE_LOOK_R := 0.52    # size the die's markings were drawn for (the shader is scaled to it)
const DIE_K := 14.0         # sharpness of the rounded tetrahedron
const DIE_H := 0.4
const DIE_GRIP_R := 1.45     # half-width of a die across the fingertips (cm)
# Hand-placed layout: nothing sits perfectly square. Each piece gets a small twist
# (degrees) and nudge, the way people actually set things down on the sand.
const BOARD_YAW := -0.6
const STRIP_PLACE := [Vector3(-0.43, 2.43, 1.8), Vector3(-0.59, -2.44, -1.3)]   # [HUMAN, AI]: x, z, yaw
const PLATE_NUDGE := [Vector3(0.05, 0.04, -2.8), Vector3(0.02, -0.05, 2.2)]    # dx, dz, yaw
const TRAY_NUDGE := Vector3(-0.05, 0.04, 2.4)                                  # dx, dz, yaw
const SLAB_R := 0.04    # worn, rounded edges of the wooden slabs
const DICE_CALL_TIME := 2.0  # after this many seconds, creeping dice are called as they lie
const HOME_X := 5.15
const DRAG_LEAN_CM := 5.0   # how far the human leans in while carrying a stone with the mouse
const HOME_SIZE := Vector2(1.7, 2.8)  # home plate (x, z); finished stones sit on it side by side

enum Phase { ROLL, MOVE, BUSY, OVER }

signal dice_settled

