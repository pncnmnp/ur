# ======================================================================
# Game flow
# ======================================================================

func new_game() -> void:
	epoch += 1
	for t in tweens:
		if t.is_valid():
			t.kill()
	tweens.clear()
	game = UrGame.new()
	roll = -1
	legal = []
	sel_idx = -1
	dragging = false
	rolling = false
	human_holding = false
	release_pending = null
	for h in hands:
		h.move_id += 1
		h.shake = Vector3.ZERO
		h.visible = false
	if slide_player:
		slide_player.stop()
	if grip and grip.active():
		grip.end()
	dice_hand = null
	for h in hands:
		h.aim_yaw = 0.0
		h.aim_roll = 0.0
	for b in dice_bodies:
		b.visible = true
		b.freeze = false
	for p in 2:
		for i in UrGame.PIECES:
			pnodes[p][i].position = rest(slot_pos(p, 0, i, 0))
			pnodes[p][i].rotation.x = 0.0
			pnodes[p][i].rotation.z = 0.0
	start_turn()


## Show a message on the clay tablet: the old one fades out of the clay, the new one in.
func set_status(s: String) -> void:
	if s == status:
		return
	status = s
	if tablet_tween and tablet_tween.is_valid():
		tablet_tween.kill()
	tablet_tween = create_tween()
	var cur: float = tablet_mat.get_shader_parameter("ink")
	tablet_tween.tween_method(func(v: float) -> void: tablet_mat.set_shader_parameter("ink", v), cur, 0.0, 0.22 * cur)
	tablet_tween.tween_callback(func() -> void: tablet_label.text = s)
	tablet_tween.tween_interval(0.06) # let the offscreen viewport redraw
	tablet_tween.tween_method(func(v: float) -> void: tablet_mat.set_shader_parameter("ink", v), 0.0, 1.0, 0.35)


func start_turn() -> void:
	var e := epoch
	legal = []
	sel_idx = -1
	if game.current == HUMAN:
		phase = Phase.ROLL
		set_status("Your turn\ncast the dice in the tray")
	else:
		phase = Phase.BUSY
		set_status("Al-Khasm's turn")
		await get_tree().create_timer(0.7).timeout
		if e != epoch:
			return
		do_roll()


func _on_roll_pressed() -> void:
	if phase == Phase.ROLL:
		do_roll()


func do_roll() -> void:
	var e := epoch
	phase = Phase.BUSY
	# the thrower gathers the dice into his fist, rattles them and casts them
	roll = -1
	await hand_throw(game.current)
	if e != epoch:
		return
	await dice_settled
	if e != epoch:
		return
	roll = 0
	for r in dice_result:
		roll += r
	var who := "You" if game.current == HUMAN else "Al-Khasm"
	legal = game.legal_moves(game.current, roll)
	if legal.is_empty():
		set_status("%s threw %d\nno move" % [who, roll])
		await get_tree().create_timer(1.3).timeout
		if e != epoch:
			return
		game.current = 1 - game.current
		start_turn()
		return
	if game.current == HUMAN:
		phase = Phase.MOVE
		set_status("You threw %d\nmove a stone %d" % [roll, roll])
	else:
		set_status("Al-Khasm threw %d" % roll)
		await get_tree().create_timer(0.8).timeout
		if e != epoch:
			return
		var src := UrAI.choose_move(game, roll)
		perform_move(game.pos[AI].find(src))


func perform_move(idx: int) -> void:
	var e := epoch
	var p := game.current
	var h: UrHand = hands[p]
	var who := "You" if p == HUMAN else "Al-Khasm"
	var src: int = game.pos[p][idx]
	var dst := src + roll
	var node: Node3D = pnodes[p][idx]
	var done_k := game.finished_count(p)
	var held := p == HUMAN and human_holding and sel_idx == idx
	legal = []
	phase = Phase.BUSY
	sel_idx = -1
	dragging = false
	human_holding = false

	var capt_idx := -1
	if dst >= UrGame.SHARED_FIRST and dst <= UrGame.SHARED_LAST:
		capt_idx = game.pos[1 - p].find(dst)
	var dst_pos := rest(slot_pos(p, dst, idx, done_k))
	var victim: Node3D = pnodes[1 - p][capt_idx] if capt_idx != -1 else null

	if held and victim:
		# set our stone down beside the one we are taking, lift that one off, then push ours across
		var beside := dst_pos + board_xf().basis * Vector3(0.0, 0.0, 0.85 if p == HUMAN else -0.85)
		await hand_move(h, beside + Vector3(0, LIFT, 0), 0.2, 0.0, 28.0, node)   # across, clear of it
		if e != epoch:
			return
		await hand_move(h, beside, 0.18, 0.0, 30.0, node)                         # then down
		if e != epoch:
			return
		await hand_let_go(h, node, "stone_place")
		if e != epoch:
			return
	if victim:
		# the captured stone goes back to its owner's strip
		await hand_take(h, victim)
		if e != epoch:
			return
		await hand_move(h, rest(slot_pos(1 - p, 0, capt_idx, 0)), randf_range(0.55, 0.75), 0.9, 24.0, victim, randf_range(-0.6, 0.6))
		if e != epoch:
			return
		await hand_let_go(h, victim, "stone_place")
		if e != epoch:
			return
	if not held or victim:
		await hand_take(h, node)
		if e != epoch:
			return

	if dst >= UrGame.FINISH:
		# turn it to lie in line with the others on the home plate
		var spin_tw := create_tween()
		tweens.append(spin_tw)
		spin_tw.tween_property(node, "rotation:y", home_yaw(node.rotation.y, done_k, p), 0.5) \
			.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	var land := "stone_place"
	if held and not victim:
		# already over the square: lower it in
		await hand_move(h, dst_pos, randf_range(0.18, 0.26), 0.0, 30.0, node)
	elif (held and victim) or can_slide(p, src, dst):
		# pushed along the board, square by square
		var pts: Array = []
		if held and victim:
			pts.append(dst_pos)
		else:
			for i in range(src + 1, dst + 1):
				pts.append(rest(cell_pos(path_cell(p, i))))
		await hand_slide(h, node, pts)
		land = ""
	else:
		# lifted over other stones, or from one slab to another
		await hand_move(h, dst_pos, randf_range(0.5, 0.75), randf_range(0.7, 1.0), 26.0, node, randf_range(-0.5, 0.5))
	if e != epoch:
		return
	await hand_let_go(h, node, land)
	if e != epoch:
		return
	hand_leave(h)

	var r := game.apply_move(p, src, roll, idx)
	var msg := "%s moved %d" % [who, roll]
	if r.captured:
		msg = "%s captured a stone" % who
	if game.has_won(p):
		phase = Phase.OVER
		set_status("You win!" if p == HUMAN else "Al-Khasm wins")
		return
	if r.extra_turn:
		msg = "Rosette\n%s again" % ("you throw" if p == HUMAN else "Al-Khasm throws")
	set_status(msg)
	await get_tree().create_timer(0.8).timeout
	if e != epoch:
		return
	if not r.extra_turn:
		game.current = 1 - p
	start_turn()


## A move slides along the board when it stays on the board and every square it
## passes over is empty; otherwise the stone has to be lifted.
func can_slide(p: int, src: int, dst: int) -> bool:
	if src == 0 or dst >= UrGame.FINISH:
		return false
	for i in range(src + 1, dst):
		if game.pos[p].has(i):
			return false
		if i >= UrGame.SHARED_FIRST and i <= UrGame.SHARED_LAST and game.pos[1 - p].has(i):
			return false
	return true


# ======================================================================
# Hands: every stone is moved, and every throw made, by a player's hand
# ======================================================================

var hands: Array = [null, null]
var human_holding := false          # the human's fingers hold the selected stone (dragging)
var release_pending: Variant = null  # mouse released before the hand had reached the stone
var drag_target := Vector3.ZERO
var slide_player: AudioStreamPlayer3D
var last_throw: Array = []
var dice_hand: UrHand = null        # the dice are in this hand (they ride along with it)
var grip: DiceGrip                  # the dice as solid things in that hand
var hand_knock_cool := 0.0


func build_hands() -> void:
	# white robe across the table from the AI's black; each reaches from his right shoulder
	# (the human's arm comes in from low on the right, so it does not hide what his hand is doing)
	hands[HUMAN] = UrHand.new(UrHand.Style.WHITE, Vector3(3.0, 3.4, 10.0), Vector3(1, 0, 0))
	hands[HUMAN].lean = 0.15
	hands[AI] = UrHand.new(UrHand.Style.BLACK, Vector3(-1.0, 4.8, -12.0), Vector3(-1, 0, 0))
	for h in hands:
		add_child(h)
	slide_player = AudioStreamPlayer3D.new()
	slide_player.attenuation_model = AudioStreamPlayer3D.ATTENUATION_DISABLED
	slide_player.attenuation_filter_db = 0.0
	slide_player.panning_strength = 0.6
	add_child(slide_player)


## Fingers point from his shoulder toward the hand; near or behind the shoulder
## (coming in, going away) they keep pointing at the table.
func hand_fwd(h: UrHand, at: Vector3) -> Vector3:
	var table := Vector3(-1.0, 0.0, 0.0) - h.shoulder
	table.y = 0.0
	table = table.normalized()
	var d := at - h.shoulder
	d.y = 0.0
	var reach := d.dot(table)
	if reach < 2.0:
		return table
	return table.lerp(d.normalized(), clampf((reach - 2.0) / 3.0, 0.0, 1.0)).normalized()


## A resting place for the hand just past the player's shoulder, outside the camera's view.
func offstage(h: UrHand, toward: Vector3) -> Vector3:
	var back := h.shoulder - toward
	back.y = 0.0
	var q := h.shoulder + back.normalized() * 2.0
	q.y = h.shoulder.y - 0.5
	return q


func hand_enter(h: UrHand, toward: Vector3) -> void:
	if h.visible:
		return
	# start just beyond his shoulder, out of view
	var start := offstage(h, toward)
	h.set_pose("relaxed", true)
	h.aim_yaw = 0.0
	h.place(start, hand_fwd(h, toward), 10.0)
	h.visible = true


## Move the hand's grip point to `to` over dur seconds (eased), arcing up by `arc`.
## A carried stone follows the grip, turning by `twist` radians on the way.
## A newer move on the same hand takes over from this one.
## The hand also turns to `yaw` and rolls to `roll` (degrees) on the way, if given.
func hand_move(h: UrHand, to: Vector3, dur: float, arc := 0.0, pitch := NAN, carry: Node3D = null, twist := 0.0,
		yaw := NAN, roll := NAN) -> void:
	h.move_id += 1
	var my := h.move_id
	var from := h.grip_target
	var p0 := h.aim_pitch
	var p1 := p0 if is_nan(pitch) else pitch
	var yw0 := h.aim_yaw
	var yw1 := yw0 if is_nan(yaw) else yaw
	var rl0 := h.aim_roll
	var rl1 := rl0 if is_nan(roll) else roll
	var y0 := carry.rotation.y if carry else 0.0
	var tw := create_tween()
	tweens.append(tw)
	tw.tween_method(func(t: float) -> void:
		if h.move_id != my:
			return
		var g := from.lerp(to, t) + Vector3(0, sin(t * PI) * arc, 0)
		h.aim_yaw = lerpf(yw0, yw1, t)
		h.place(g, hand_fwd(h, g), lerpf(p0, p1, t), lerpf(rl0, rl1, t))
		if carry:
			carry.position = g
			carry.rotation.y = y0 + twist * t,
		0.0, 1.0, dur).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	await tw.finished


## Push a held stone along the board through the given points, the wood whispering under it.
func hand_slide(h: UrHand, node: Node3D, pts: Array) -> void:
	var path: Array = [node.position]
	path.append_array(pts)
	var lens: Array = [0.0]
	for i in range(1, path.size()):
		lens.append(float(lens[-1]) + (path[i] as Vector3).distance_to(path[i - 1]))
	var total: float = lens[-1]
	if total < 0.01:
		return
	var dur := 0.2 + total * randf_range(0.16, 0.22)
	var y0 := node.rotation.y
	var twist := randf_range(-0.3, 0.3)
	var arr: Array = sfx.get("stone_slide", [])
	if not arr.is_empty():
		slide_player.stream = arr[randi() % arr.size()]
		slide_player.volume_db = SFX_DB["stone_slide"]
		slide_player.pitch_scale = randf_range(0.9, 1.1)
		slide_player.position = node.position
		slide_player.play()
	h.move_id += 1
	var my := h.move_id
	var tw := create_tween()
	tweens.append(tw)
	tw.tween_method(func(t: float) -> void:
		if h.move_id != my:
			return
		var s := t * total
		var k := 1
		while k < lens.size() - 1 and float(lens[k]) < s:
			k += 1
		var seg := clampf((s - float(lens[k - 1])) / maxf(float(lens[k]) - float(lens[k - 1]), 0.0001), 0.0, 1.0)
		var g: Vector3 = (path[k - 1] as Vector3).lerp(path[k], seg)
		h.place(g, hand_fwd(h, g), 30.0, h.aim_roll)
		node.position = g
		node.rotation.y = y0 + twist * t
		slide_player.position = g,
		0.0, 1.0, dur).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	await tw.finished
	var fade := create_tween()
	fade.tween_property(slide_player, "volume_db", -50.0, 0.08)
	fade.tween_callback(slide_player.stop)


## Reach for a stone and take it: the hand comes down with thumb and fingers spread
## round it, then closes until the finger pads and the thumb press on its sides.
func hand_take(h: UrHand, node: Node3D, quick := false) -> void:
	var at := node.position
	hand_enter(h, at)
	h.grip_override = UrHand.GRASP_C
	h.set_pose_dict(h.grasp_pose(UrHand.STONE_OPEN_R))
	var k := 0.65 if quick else 1.0
	await hand_move(h, at + Vector3(0, 1.1, 0), randf_range(0.45, 0.7) * k, 0.5, 30.0, null, 0.0, 0.0, 0.0)
	await hand_move(h, at + Vector3(0, 0.03, 0), randf_range(0.2, 0.28) * k, 0.0, 32.0)
	h.pose_rate = 16.0
	h.set_pose_dict(h.grasp_pose(UrHand.STONE_GRIP_R))
	await get_tree().create_timer(randf_range(0.16, 0.22) * k).timeout
	h.pose_rate = 9.0
	play_sfx("stone_lift", at)


## Open the fingers off a stone (already on the wood): it rocks and settles; the hand lifts away.
func hand_let_go(h: UrHand, node: Node3D, land := "") -> void:
	if land != "":
		play_sfx(land, node.position)
	else:
		play_sfx("stone_place", node.position, -12.0)
	h.pose_rate = 16.0
	h.set_pose_dict(h.grasp_pose(UrHand.STONE_OPEN_R))
	settle(node)
	await get_tree().create_timer(0.12).timeout
	h.pose_rate = 9.0
	await hand_move(h, h.grip_target + Vector3(0, 0.8, 0), randf_range(0.2, 0.3), 0.0, 24.0)


func hand_leave(h: UrHand) -> void:
	h.set_pose("relaxed")
	var end := offstage(h, h.grip_target)
	var my := h.move_id + 1
	await hand_move(h, end, randf_range(0.5, 0.7), 0.0, 8.0, null, 0.0, 0.0, 0.0)
	if h.move_id == my:
		h.visible = false


## A pebble set down never lands perfectly flat: it rocks a little and comes to rest.
func settle(node: Node3D) -> void:
	var tw := create_tween()
	tweens.append(tw)
	var ax := randf_range(-0.08, 0.08)
	var az := randf_range(-0.08, 0.08)
	var yaw := node.rotation.y
	tw.tween_method(func(t: float) -> void:
		var k := sin(t * TAU * 1.5) * (1.0 - t)
		node.rotation = Vector3(ax * k, yaw, az * k), 0.0, 1.0, 0.45)


## The thrower gathers the dice and casts them. For each die in turn his hand turns to
## line up with it, comes down with thumb and fingers spread round it, and closes until
## the finger pads and the thumb meet its faces; he lifts it and rolls it back into his
## palm, where the curled ring and little fingers keep it, and goes on to the next. Then
## his fingers close round all four until each one meets a die, he rattles them and
## flings them across the tray from his side. The dice are solid all the while (see
## DiceGrip): nothing passes through the hand, the floor or another die, and only the
## hand moves them.
func hand_throw(p: int) -> void:
	var e := epoch
	var h: UrHand = hands[p]
	var txf := tray_xf()
	var c := dice_centroid()
	hand_enter(h, c)
	for b in dice_bodies:
		b.visible = true
	grip.begin(h)
	dice_hand = h
	# 1. pick them up one by one, nearest first
	h.grip_override = UrHand.GRASP_C
	var open := h.grasp_pose(UrHand.STONE_OPEN_R)
	pose_digits(h, open, PINCH_DIGITS)
	var fist := h.pose_dict("fist")
	# the ring and little fingers half curl, out of the way of the tray but leaving the
	# hollow of the hand open for the dice; they close round them as they come
	var cup := h.pose_dict("cup")
	var half := {}
	for b in fist:
		half[b] = (cup[b] as Vector2).lerp(fist[b], 0.45)
	for d in ["ring", "pinky"]:
		grip.drive(d, h.pose_cur.duplicate(), half, 1.5)
	var order := gather_order(h.shoulder)
	for k in order.size():
		var i: int = order[k]
		var plan: Dictionary = await plan_pick(h, i, open)
		if e != epoch:
			return
		# thumb and fingers spread to come down round it (as for a pebble), never
		# sweeping through a die already in the palm
		for d in PINCH_DIGITS:
			grip.drive(d, h.pose_cur.duplicate(), open, 4.0)
		var at: Vector3 = plan.grip
		if k == 0:
			await hand_move(h, at + Vector3(0, 1.0, 0), randf_range(0.45, 0.6), 0.5, plan.pitch, null, 0.0, plan.yaw)
		else:
			await hand_move(h, at + Vector3(0, 0.6, 0), randf_range(0.3, 0.36), 0.2, plan.pitch, null, 0.0, plan.yaw)
		if e != epoch:
			return
		await hand_move(h, at, randf_range(0.18, 0.24), 0.0, plan.pitch + 2.0)
		if e != epoch:
			return
		# thumb, index and middle pads close on it and stop as they meet its faces
		for d in PINCH_DIGITS:
			grip.drive(d, h.pose_cur.duplicate(), plan.touch, 6.0)
		var t := 0.0
		while t < 0.4 and not grip.closed(PINCH_DIGITS):
			await get_tree().physics_frame
			t += get_physics_process_delta_time()
		if e != epoch:
			return
		for d in PINCH_DIGITS:
			grip.let_go(d)          # the pinch holds as it is
		grip.carry(i)
		play_sfx("stone_lift" if k == 0 else "die_die", at, 0.0 if k == 0 else -12.0)
		await get_tree().create_timer(0.06).timeout
		await hand_move(h, at + Vector3(0, 0.4, 0), randf_range(0.18, 0.22), 0.0, plan.pitch - 6.0)
		if e != epoch:
			return
		# the thumb and fingers curl in, carrying it, and set it in the palm, then let go
		# of it there, where the curled ring and little fingers keep it
		grip.pinch_loose(i)
		var tuck := h.grasp_at(POCKET[k], maxf(plan.r - 0.3, 0.5))
		for d in PINCH_DIGITS:
			grip.drive(d, h.pose_cur.duplicate(), tuck, 3.2)
		await get_tree().create_timer(0.38).timeout
		if e != epoch:
			return
		grip.loosen(i, POCKET[k], 500.0)
		play_sfx("die_die", h.grip_world(), -18.0)
	# 2. close the hand round all four, palm down, each finger stopping on a die, and
	# lift the fist off the tray toward his side
	# (first the thumb and fingers ease off the last one and it settles up into the
	# palm, so the fingers close under it)
	for d in PINCH_DIGITS:
		grip.drive(d, h.pose_cur.duplicate(), half, 5.0)
	var w := 0.0
	var last: int = order[order.size() - 1]
	while w < 0.35 and (grip.pos[last] as Vector3).distance_to(grip.anchor[last]) > 0.5:
		await get_tree().physics_frame
		w += get_physics_process_delta_time()
	if e != epoch:
		return
	var now := h.pose_cur.duplicate()
	for d in UrHand.DIGITS:
		grip.drive(d, now, fist, 2.0)
	for k in order.size():
		grip.pull[order[k]] = 400.0
	await get_tree().create_timer(0.2).timeout
	if e != epoch:
		return
	var at_grip := h.global_transform * UrHand.PALM_C
	h.grip_override = UrHand.PALM_C      # same hand position, now steered by the palm
	h.grip_target = at_grip
	var near_z := TRAY.end.y - 1.1 if p == HUMAN else TRAY.position.y + 1.1
	var start := txf * Vector3(TRAY.get_center().x + randf_range(-0.4, 0.4), 1.7, near_z)
	await hand_move(h, start, 0.5, 0.25, FIST_PITCH, null, 0.0, 0.0, FIST_ROLL)
	if e != epoch:
		return
	# 3. rattle them in the closed fist: they knock about inside it
	play_sfx("dice_shake", start)
	var tw := create_tween()
	tweens.append(tw)
	tw.tween_method(func(t: float) -> void:
		h.shake = Vector3(sin(t * TAU * 3.0) * 0.07, sin(t * TAU * 6.0) * 0.06, cos(t * TAU * 3.0) * 0.16) * sin(t * PI),
		0.0, 1.0, 0.7)
	await tw.finished
	h.shake = Vector3.ZERO
	if e != epoch:
		return
	# 4. cast: the fist swings forward and down and opens, the dice drop out of it
	var dir := txf.basis * Vector3(0, 0, -1.0 if p == HUMAN else 1.0)
	hand_move(h, start + dir * 1.0 + Vector3(0, -0.45, 0), 0.24, 0.0, FIST_PITCH + 12.0)
	await get_tree().create_timer(0.1).timeout
	if e != epoch:
		return
	grip.let_go_all()
	grip.end()
	dice_hand = null
	throw_dice(dice_centroid(), dir, true)
	h.set_pose("throw")
	h.pose_rate = 22.0
	await get_tree().create_timer(0.3).timeout
	h.pose_rate = 9.0
	hand_leave(h)


const PINCH_DIGITS := ["index", "middle", "thumb"]
# Where the gathered dice are drawn while he picks up the rest: under the palm, by the
# heel of the hand and the curled ring and little fingers (hand-local cm)
# (each is set there by thumb and fingers, pressed up against the palm in the hollow
# just behind the knuckles, where the fingers fold round them when the fist closes)
const POCKET := [Vector3(-2.5, -2.1, 8.2), Vector3(-1.0, -2.1, 6.0), Vector3(-0.3, -2.1, 8.4), Vector3(1.9, -2.1, 8.1)]
const FIST_PITCH := 18.0     # the fist held a little knuckles-forward
const FIST_ROLL := 20.0      # and turned a little thumb-up, as a fist naturally is


## Set only these digits of the hand toward a pose (the others keep what they are doing).
func pose_digits(h: UrHand, d: Dictionary, ds: Array) -> void:
	var part := {}
	for name in ds:
		for s in 3:
			var i: int = h.bones["%s_%d" % [name, s]]
			part[i] = d[i]
	h.set_pose_dict(part)


## How to take die i, the way a pebble is taken: the hand turns (no more than ~30
## degrees from where it naturally points) so thumb and fingers close across the die,
## tips forward enough that the palm, the spread fingers and the dice already in the
## hand clear the dice beside it, the floor and the rim, and pinches it just above its
## middle (the finger pads clear of the floor). The pinch is sized to the die's real
## width along it.
func plan_pick(h: UrHand, i: int, open: Dictionary) -> Dictionary:
	var X: Transform3D = (dice_bodies[i] as Node3D).global_transform
	var c := X.origin
	var f0 := hand_fwd(h, c)
	f0.y = 0.0
	f0 = f0.normalized()
	var cands: Array = []
	for n in [grip.n0, grip.n1, grip.n2, grip.n3]:
		var nw: Vector3 = X.basis.orthonormalized() * n
		var nh := Vector3(nw.x, 0.0, nw.z)
		if nh.length() < 0.35:
			continue
		nh = nh.normalized()
		for fwd in [-nh, nh]:
			var yaw := rad_to_deg(f0.signed_angle_to(fwd, Vector3.UP))
			if absf(yaw) <= 32.0:
				cands.append(yaw)
	if cands.is_empty():
		cands.append(0.0)
	# the ring and little fingers as they will be: curled round the dice in the palm, or tight
	var rest := h.pose_cur.duplicate()
	if not grip.ctl.has("ring"):
		var fist := h.pose_dict("fist")
		for d in ["ring", "pinky"]:
			for k in 3:
				rest[h.bones["%s_%d" % [d, k]]] = fist[h.bones["%s_%d" % [d, k]]]
	for d in PINCH_DIGITS:
		for k in 3:
			rest[h.bones["%s_%d" % [d, k]]] = open[h.bones["%s_%d" % [d, k]]]
	# pinch height: the pads (about a finger's thickness) just clear of the floor
	var gy := maxf(c.y, grip.floor_y + 0.95 * UrHand.CM)
	var opts: Array = []
	for yaw in cands:
		for pitch in [32.0, 40.0, 48.0]:
			opts.append([absf(yaw) / 40.0 + (pitch - 32.0) / 30.0, yaw, pitch])
	opts.sort_custom(func(a: Array, b: Array) -> bool: return a[0] < b[0])
	var best: Array = opts[0]
	var best_s := INF
	for o in opts:
		var T := h.xf_at(Vector3(c.x, gy, c.z), f0, o[2], o[1], UrHand.GRASP_C)
		var sc: float = o[0] + grip.clash(T, rest, [], i, rim_pen) * 25.0
		if sc < best_s:
			best_s = sc
			best = o
		if sc - o[0] < 0.01:
			break
	await get_tree().process_frame
	# the die's width along the pinch, through the pinch point: centre the grip on it
	var g := Vector3(c.x, gy, c.z)
	var T := h.xf_at(g, f0, best[2], best[1], UrHand.GRASP_C)
	var lr := grip.local_under(T, i)
	var dr: Basis = lr[1]
	var o_l: Vector3 = dr.transposed() * (UrHand.GRASP_C - (lr[0] as Vector3))
	var zf: Vector3 = dr.transposed() * Vector3(0, 0, 1)
	var rf := grip.ray_from(o_l, zf)
	var rn := grip.ray_from(o_l, -zf)
	var r := (rf + rn) * 0.5
	g += T.basis * Vector3(0, 0, (rf - rn) * 0.5)
	# close past the die: the pads stop where they meet it
	var touch := h.grasp_pose(snappedf(maxf(r - 0.35, 0.5), 0.05))
	return {"grip": g, "yaw": best[1], "pitch": best[2], "touch": touch, "r": snappedf(r, 0.05)}


## How far a ball of radius r (world) at world point q is inside the tray's rim boards.
func rim_pen(q: Vector3, r: float) -> float:
	var top := 0.42
	if q.y - r > top:
		return 0.0
	var l := tray_xf().affine_inverse() * q
	var dx := maxf(TRAY.position.x - (l.x - r), (l.x + r) - TRAY.end.x)
	var dz := maxf(TRAY.position.y - (l.z - r), (l.z + r) - TRAY.end.y)
	return maxf(0.0, minf(maxf(dx, dz), top - (q.y - r)))


func dice_centroid() -> Vector3:
	var c := Vector3.ZERO
	for b in dice_bodies:
		c += (b as Node3D).global_position
	c /= 4.0
	c.y = 0.0
	return c


## A world point pulled inside the tray, `mx` / `mz` (world units) clear of the walls.
func in_tray(q: Vector3, mz: float, mx: float) -> Vector3:
	var txf := tray_xf()
	var l := txf.affine_inverse() * q
	l.x = clampf(l.x, TRAY.position.x + 0.5 + mx, TRAY.end.x - 0.5 - mx)
	l.z = clampf(l.z, TRAY.position.y + mz, TRAY.end.y - mz)
	l.y = q.y
	var w := txf * l
	w.y = q.y if q.y != 0.0 else 0.35
	return w


## Dice in the order a hand gathers them: nearest the player first, then each time
## the one nearest the last.
func gather_order(from: Vector3) -> Array:
	var left := [0, 1, 2, 3]
	var out := []
	var q := from
	while not left.is_empty():
		var best: int = left[0]
		var bd := INF
		for i in left:
			var d := Vector2(q.x, q.z).distance_to(Vector2((dice_bodies[i] as Node3D).global_position.x, (dice_bodies[i] as Node3D).global_position.z))
			if d < bd:
				bd = d
				best = i
		left.erase(best)
		out.append(best)
		q = (dice_bodies[best] as Node3D).global_position
	return out


# ======================================================================
# Geometry helpers
# ======================================================================

func path_cell(p: int, i: int) -> Vector2i:
	var row := 2 if p == HUMAN else 0
	if i <= 4:
		return Vector2i(4 - i, row)
	if i <= 12:
		return Vector2i(i - 5, 1)
	return Vector2i(20 - i, row)


func cell_pos(c: Vector2i) -> Vector3:
	return board_xf() * Vector3(c.x - 3.5, BY, c.y - 1.0)


func home_z(p: int) -> float:
	return (0.1 + HOME_SIZE.y / 2.0) * (1.0 if p == HUMAN else -1.0)


## Yaw that lays a stone's long axis along x (so the rows pack neatly), with a little
## hand-placed wobble, choosing the nearest such angle so it turns as little as possible.
func home_yaw(cur: float, k: int, p: int) -> float:
	var target := sin(k * 5.1 + p * 2.3) * 0.08 + deg_to_rad(PLATE_NUDGE[p].z)
	return target + roundf((cur - target) / PI) * PI


func row_z(p: int) -> float:
	return 1.0 if p == HUMAN else -1.0


func rest(base: Vector3) -> Vector3:
	return base + Vector3(0, PIECE_H / 2.0, 0)


## Surface position where stone idx of player p sits at path position `where`.
## done_k = how many of p's stones are already home (picks its spot on the home plate).
func slot_pos(p: int, where: int, idx: int, done_k: int) -> Vector3:
	if where == 0:
		return strip_xf(p) * Vector3((idx - 3) * 0.95, BY, 0)
	if where >= UrGame.FINISH:
		# 2 columns x 4 rows, filled from the board side outward, loosely placed by hand
		var col := done_k % 2
		var row := done_k / 2
		var s := 1.0 if p == HUMAN else -1.0
		return plate_xf(p) * Vector3((col - 0.5) * 0.82 + sin(done_k * 12.9 + p) * 0.02, BY,
			s * ((row - 1.5) * 0.7 + cos(done_k * 7.3 + p) * 0.015))
	return cell_pos(path_cell(p, where))


func ground_point(pt: Vector2, y := BY) -> Variant:
	var o := cam.project_ray_origin(pt)
	var d := cam.project_ray_normal(pt)
	return Plane(Vector3.UP, y).intersects_ray(o, d)


## Is screen point pt over the drop zone for path position dst?
## While carrying a stone we test at carrying height so its own footprint counts.
func drop_ok(pt: Vector2, dst: int, y := BY) -> bool:
	var g: Variant = ground_point(pt, y)
	if g == null:
		return false
	if dst >= UrGame.FINISH:
		var h: Vector3 = plate_xf(HUMAN).affine_inverse() * (g as Vector3)
		return absf(h.x) < HOME_SIZE.x / 2 + 0.25 and absf(h.z) < HOME_SIZE.y / 2 + 0.25
	var c := cell_pos(path_cell(HUMAN, dst))
	return absf(g.x - c.x) < 0.6 and absf(g.z - c.z) < 0.6


func movable_indices() -> Array:
	var out: Array = []
	if phase != Phase.MOVE:
		return out
	for i in UrGame.PIECES:
		if legal.has(game.pos[HUMAN][i]):
			out.append(i)
	return out


func pick(pt: Vector2, candidates: Array) -> int:
	var best := -1
	var best_d := 48.0
	for i in candidates:
		var wp: Vector3 = pnodes[HUMAN][i].global_position
		if cam.is_position_behind(wp):
			continue
		var d := pt.distance_to(cam.unproject_position(wp))
		if d < best_d:
			best_d = d
			best = i
	return best


# ======================================================================
# Dice physics
# ======================================================================

## Cast the dice from `origin` along `dir` (world). With no arguments, the last throw
## is repeated (used when a die jumps out of the tray).
func throw_dice(origin: Variant = null, dir: Variant = null, keep := false) -> void:
	if origin == null:
		if last_throw.is_empty():
			var txf0 := tray_xf()
			last_throw = [txf0 * Vector3(TRAY.get_center().x, 1.5, TRAY.end.y - 1.1), txf0.basis * Vector3(0, 0, -1)]
		origin = last_throw[0]
		dir = last_throw[1]
	last_throw = [origin, dir]
	var o: Vector3 = origin
	var d: Vector3 = (dir as Vector3).normalized()
	var side := Vector3.UP.cross(d).normalized()
	roll = -1
	rolling = true
	throw_time = 0.0
	still_time = 0.0
	for i in 4:
		die_cool[i] = 0.08
	for i in 4:
		var b: RigidBody3D = dice_bodies[i]
		b.freeze = false
		b.sleeping = false
		b.linear_velocity = Vector3.ZERO
		b.angular_velocity = Vector3.ZERO
		# out of the opening hand, a little spread, kept inside the tray walls
		var txf := tray_xf()
		var lp := txf.affine_inverse() * (b.global_position if keep else o + side * randf_range(-0.45, 0.45) + d * randf_range(-0.2, 0.25) + Vector3(0, randf_range(-0.1, 0.15), 0))
		lp.x = clampf(lp.x, TRAY.position.x + 0.55, TRAY.end.x - 0.55)
		lp.z = clampf(lp.z, TRAY.position.y + 0.55, TRAY.end.y - 0.55)
		lp.y = maxf(lp.y, 0.75)
		b.global_position = txf * lp
		if not keep:
			b.rotation = Vector3(randf() * TAU, randf() * TAU, randf() * TAU)
		# (out of an opening fist they drop forward and down)
		var vy := randf_range(-1.2, 0.2) if keep else randf_range(-1.5, 0.8)
		b.linear_velocity = d * randf_range(5.0, 8.0) + side * randf_range(-1.6, 1.6) + Vector3(0, vy, 0)
		b.angular_velocity = Vector3(randf_range(-12, 12), randf_range(-12, 12), randf_range(-12, 12))
		b.visible = true
		die_prev_v[i] = b.linear_velocity
		die_prev_w[i] = b.angular_velocity


## Index (0..3) of the tetrahedron corner currently pointing up, and how upright it is.
func top_vertex(b: RigidBody3D) -> Dictionary:
	var best := 0
	var best_y := -INF
	var second_y := -INF
	for k in 4:
		var wy := (b.global_transform * (die_verts[k] as Vector3)).y
		if wy > best_y:
			second_y = best_y
			best_y = wy
			best = k
		elif wy > second_y:
			second_y = wy
	var up_dir := ((b.global_transform.basis * (die_verts[best] as Vector3))).normalized()
	# lead = how far the top corner stands above the next one (0 = a tie, the top could still change)
	return {"index": best, "upright": up_dir.dot(Vector3.UP), "lead": best_y - second_y}


## Once the throw is effectively over, a die that is only creeping (sliding off the rim
## or another die, rocking slowly) is stopped and read as it lies, so nobody waits for it.
## A die still tumbling fast, or with two corners nearly level (the top could still
## change), is left alone to finish.
func call_creeping_dice() -> void:
	for b in dice_bodies:
		if b.freeze:
			continue
		var lin: float = b.linear_velocity.length()
		var ang: float = b.angular_velocity.length()
		if lin > 1.2 or ang > 3.0:
			continue
		# only a die lying on something: never one caught at the slow top of a bounce
		if b.get_colliding_bodies().is_empty() or absf(b.linear_velocity.y) > 0.5:
			continue
		if top_vertex(b).lead < DIE_R * 0.15:
			continue
		b.linear_velocity = Vector3.ZERO
		b.angular_velocity = Vector3.ZERO
		# freeze where it lies: a kinematic freeze would otherwise snap the die back to the
		# last place a hand carried it
		var xf: Transform3D = b.global_transform
		b.freeze = true
		b.global_transform = xf


func _physics_process(delta: float) -> void:
	if grip.active():
		grip.step(delta)
		# dice knocking together in his hand (the rattle itself has its own sound)
		hand_knock_cool -= delta
		if grip.knock > 22.0 and hand_knock_cool <= 0.0 and dice_hand and dice_hand.shake == Vector3.ZERO:
			hand_knock_cool = 0.12
			play_sfx("die_die", dice_hand.grip_world(), clampf(-20.0 + grip.knock * 0.12, -20.0, -9.0), 0.12)
	dice_sounds(delta)
	if not rolling:
		return
	throw_time += delta
	if throw_time > DICE_CALL_TIME:
		call_creeping_dice()
	var still := true
	for b in dice_bodies:
		if b.freeze:
			continue
		if b.linear_velocity.length() > 0.08 or b.angular_velocity.length() > 0.25:
			still = false
	# wait until the dice have stayed put for a moment, so a wobbling die is not read mid-wobble
	still_time = still_time + delta if still else 0.0
	var timed_out := throw_time > 8.0
	if not (still_time > 0.2 and throw_time > 0.7) and not timed_out:
		return
	# everything has stopped. Dice are read exactly as they lie: one leaning on the rim
	# or on another die counts whichever corner is highest, just as players would read it.
	var inner := TRAY.grow(0.3)
	for i in 4:
		var b: RigidBody3D = dice_bodies[i]
		var gp := b.global_position
		if not inner.has_point(tray_local(gp)) or gp.y < -0.5 or gp.y > 1.5:
			throw_dice() # a die left the tray: throw everything again
			return
		dice_result[i] = 1 if top_vertex(b).index < 2 else 0
	rolling = false
	dice_settled.emit()


# ======================================================================
# Sound
# ======================================================================

func build_audio() -> void:
	for name in SFX_DB:
		var arr: Array = []
		for v in 8:
			var path := "res://assets/sfx/%s_%d.wav" % [name, v]
			if ResourceLoader.exists(path):
				arr.append(load(path))
		sfx[name] = arr
	for i in 20:
		var p := AudioStreamPlayer3D.new()
		p.attenuation_model = AudioStreamPlayer3D.ATTENUATION_DISABLED
		p.attenuation_filter_db = 0.0
		p.panning_strength = 0.6
		add_child(p)
		sfx_pool.append(p)


## Play a random variant of a sound at a world position.
func play_sfx(name: String, at: Vector3, vol_db := 0.0, pitch_var := 0.05) -> void:
	var arr: Array = sfx.get(name, [])
	if arr.is_empty():
		return
	var p: AudioStreamPlayer3D = sfx_pool[sfx_next]
	sfx_next = (sfx_next + 1) % sfx_pool.size()
	p.stream = arr[randi() % arr.size()]
	p.position = at
	p.volume_db = SFX_DB[name] + vol_db
	p.pitch_scale = randf_range(1.0 - pitch_var, 1.0 + pitch_var)
	p.play()


## Detect dice impacts from sudden velocity changes (beyond gravity) and play the
## sound of whatever was struck: the other dice, the wooden rim, or the leather floor.
func dice_sounds(delta: float) -> void:
	var g := Vector3(0, -float(ProjectSettings.get_setting("physics/3d/default_gravity")), 0)
	for i in 4:
		var b: RigidBody3D = dice_bodies[i]
		var v := b.linear_velocity
		var w := b.angular_velocity
		var dv: Vector3 = v - die_prev_v[i] - g * delta
		var spin_hit: float = (w - die_prev_w[i]).length() * DIE_R * 0.3
		# a die simply lying on the floor feels g*dt every step: that is not a hit
		var resting: bool = v.length() < 0.3 and (die_prev_v[i] as Vector3).length() < 0.3
		die_prev_v[i] = v
		die_prev_w[i] = w
		die_cool[i] -= delta
		var hit := maxf(dv.length(), spin_hit)
		if hit < 1.4 or resting or die_cool[i] > 0.0 or not b.visible:
			continue
		var kind := ""
		for other in b.get_colliding_bodies():
			var j := dice_bodies.find(other)
			if j != -1:
				kind = "die_die"
				die_cool[j] = 0.06 # one click per collision, not one per die
				break
			if other in tray_walls:
				kind = "die_wall"
		if kind == "":
			# contact already broken this step: judge by position and direction of the kick
			var gp := tray_local(b.global_position)
			var near_wall := gp.x < TRAY.position.x + 0.6 or gp.x > TRAY.end.x - 0.6 \
				or gp.y < TRAY.position.y + 0.6 or gp.y > TRAY.end.y - 0.6
			var sideways := Vector2(dv.x, dv.z).length() > absf(dv.y)
			kind = "die_wall" if near_wall and sideways else "die_floor"
		var strength := clampf(hit / 11.0, 0.03, 1.0)
		play_sfx(kind, b.global_position, linear_to_db(strength), 0.07)
		die_cool[i] = 0.045


# ======================================================================
# Input and per-frame visuals
# ======================================================================

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseMotion:
		mouse_pos = event.position
		if dragging:
			_carry(mouse_pos)
	elif event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		mouse_pos = event.position
		if event.pressed:
			_on_press(event.position)
		else:
			_on_release(event.position)


func _carry(pt: Vector2) -> void:
	var g: Variant = ground_point(pt, BY + LIFT)
	if g != null:
		drag_target = Vector3(g.x, BY + LIFT, g.z)
		# the stone stays in his fingers: it goes no further than his arm can reach, leaning
		# only as much as the furthest square takes (~3 cm), so it stops just past the board
		var h: UrHand = hands[HUMAN]
		drag_target = h.reachable(drag_target, hand_fwd(h, drag_target), 26.0, 0.0, DRAG_LEAN_CM)


## The human's hand reaches in and takes the stone they pressed on; once it is in his
## fingers it follows the mouse (see _process).
func human_grab(idx: int) -> void:
	var e := epoch
	var h: UrHand = hands[HUMAN]
	var node: Node3D = pnodes[HUMAN][idx]
	await hand_take(h, node, true)
	if e != epoch or sel_idx != idx or phase != Phase.MOVE:
		return
	human_holding = true
	if release_pending != null:
		var pt: Vector2 = release_pending
		release_pending = null
		_release_held(pt)


func _on_press(pt: Vector2) -> void:
	if phase == Phase.ROLL:
		if _over_tray(pt):
			_on_roll_pressed()
		return
	if phase != Phase.MOVE:
		return
	if sel_idx != -1 and drop_ok(pt, game.pos[HUMAN][sel_idx] + roll):
		perform_move(sel_idx) # click-to-place
		return
	var hit := pick(pt, movable_indices())
	if hit != -1 and not human_holding:
		sel_idx = hit
		dragging = true
		release_pending = null
		press_pos = pt
		_carry(pt)
		human_grab(hit)
	else:
		sel_idx = -1


func _on_release(pt: Vector2) -> void:
	if not dragging:
		return
	dragging = false
	if not human_holding:
		release_pending = pt   # the hand is still reaching for it
		return
	_release_held(pt)


func _release_held(pt: Vector2) -> void:
	var src: int = game.pos[HUMAN][sel_idx]
	if drop_ok(pt, src + roll, BY + LIFT):
		perform_move(sel_idx)
		return
	# not dropped on a target: the hand puts the stone back where it came from
	human_holding = false
	var idx := sel_idx
	if pt.distance_to(press_pos) > 12.0:
		sel_idx = -1   # a click (no drag) keeps it selected for click-to-place
	var h: UrHand = hands[HUMAN]
	var node: Node3D = pnodes[HUMAN][idx]
	await hand_move(h, rest(slot_pos(HUMAN, src, idx, 0)), 0.22, 0.0, 30.0, node)
	await hand_let_go(h, node, "stone_place")
	hand_leave(h)


func _process(delta: float) -> void:
	update_clouds(delta)
	if dragging and human_holding and sel_idx != -1:
		# the stone in the human's fingers follows the mouse, with a hand's slight lag
		var node: Node3D = pnodes[HUMAN][sel_idx]
		node.position = node.position.lerp(drag_target, 1.0 - exp(-16.0 * delta))
		var h: UrHand = hands[HUMAN]
		h.move_id += 1
		h.place(node.position, hand_fwd(h, node.position), 26.0)
	var mov := movable_indices()
	var hover := -1
	if dragging:
		hover = sel_idx
	elif phase == Phase.MOVE:
		hover = pick(mouse_pos, mov)
	var want_hand := hover != -1 or (phase == Phase.ROLL and _over_tray(mouse_pos))
	Input.set_default_cursor_shape(Input.CURSOR_POINTING_HAND if want_hand else Input.CURSOR_ARROW)


func _over_tray(pt: Vector2) -> bool:
	var g: Variant = ground_point(pt)
	return g != null and TRAY.has_point(tray_local(g))
