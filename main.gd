	root.add_child(b)
	return b


# ======================================================================
# Game flow
# ======================================================================

func new_game() -> void:
	set_up(UrGame.new())


## Write the position at the start of this turn to the single save slot.
func save_game() -> void:
	if phase == Phase.OVER or turn_state == null:
		flash(save_button, "game over")
		return
	var data := {"pos": turn_state.pos, "current": turn_state.current}
	var f := FileAccess.open(SAVE_PATH, FileAccess.WRITE)
	if f == null:
		push_warning("could not save: %s" % error_string(FileAccess.get_open_error()))
		return
	f.store_string(JSON.stringify(data))
	f.close()
	load_button.disabled = false
	flash(save_button, "saved")


## Lay the table out as the save slot has it, and play on from the start of that turn.
func load_game() -> void:
	var g := read_save()
	if g == null:
		flash(load_button, "no save")
		return
	set_up(g)


func read_save() -> UrGame:
	if not FileAccess.file_exists(SAVE_PATH):
		return null
	var data: Variant = JSON.parse_string(FileAccess.get_file_as_string(SAVE_PATH))
	if not data is Dictionary or not data.has("pos") or not data.has("current"):
		return null
	var g := UrGame.new()
	for p in 2:
		var row: Variant = data.pos[p] if data.pos is Array and data.pos.size() == 2 else null
		if not row is Array or row.size() != UrGame.PIECES:
			return null
		for i in UrGame.PIECES:
			var w := int(row[i])
			if w < 0 or w > UrGame.FINISH:
				return null
			g.pos[p][i] = w
	g.current = clampi(int(data.current), 0, 1)
	return g


## Briefly show a word in place of a corner link's label.
func flash(b: Button, word: String) -> void:
	var text: String = b.get_meta("label", b.text)
	b.set_meta("label", text)
	b.text = word
	var tw := create_tween()
	tw.tween_interval(1.2)
	tw.tween_callback(func() -> void: b.text = text)


func set_up(g: UrGame) -> void:
	epoch += 1
	for t in tweens:
		if t.is_valid():
			t.kill()
	tweens.clear()
	game = g
	roll = -1
	legal = []
	sel_idx = -1
	dragging = false
	rolling = false
	human_holding = false
	release_pending = null
	for h in hands:
		h.move_id += 1
		h.shake = Vector3.ZERO
		h.visible = false
	if slide_player:
		slide_player.stop()
	if grip and grip.active():
		grip.end()
	dice_hand = null
	for h in hands:
		h.aim_yaw = 0.0
		h.aim_roll = 0.0
	for b in dice_bodies:
		b.visible = true
		b.freeze = false
	for p in 2:
		var done_k := 0
		for i in UrGame.PIECES:
			var node: Node3D = pnodes[p][i]
			var w: int = game.pos[p][i]
			node.position = rest(slot_pos(p, w, i, done_k))
			node.rotation.x = 0.0
			node.rotation.z = 0.0
			if w >= UrGame.FINISH:
				node.rotation.y = home_yaw(node.rotation.y, done_k, p)
				done_k += 1
	start_turn()


## Show a message on the clay tablet: the old one fades out of the clay, the new one in.
func set_status(s: String) -> void:
	if s == status:
		return
	status = s
	if tablet_tween and tablet_tween.is_valid():
		tablet_tween.kill()
	tablet_tween = create_tween()
	var cur: float = tablet_mat.get_shader_parameter("ink")
	tablet_tween.tween_method(func(v: float) -> void: tablet_mat.set_shader_parameter("ink", v), cur, 0.0, 0.22 * cur)
	tablet_tween.tween_callback(func() -> void: tablet_label.text = s)
	tablet_tween.tween_interval(0.06) # let the offscreen viewport redraw
	tablet_tween.tween_method(func(v: float) -> void: tablet_mat.set_shader_parameter("ink", v), 0.0, 1.0, 0.35)


func start_turn() -> void:
	var e := epoch
	legal = []
	sel_idx = -1
	turn_state = game.clone()
	if game.current == HUMAN:
		phase = Phase.ROLL
		set_status("Your turn\ncast the dice in the tray")
		# while you think, he may help himself to a date
		snack_while_waiting(e)
	else:
		phase = Phase.BUSY
		set_status("Al-Khasm's turn")
		await get_tree().create_timer(0.7).timeout
		if e != epoch:
			return
		# he may take a date first; if he is already eating one, he finishes it before playing
		if eating:
			await ate
		elif may_snack(0.3):
			await eat_date()
		else:
			do_roll()
			return
		await get_tree().create_timer(randf_range(0.3, 0.6)).timeout
		if e != epoch:
			return
		do_roll()


func _on_roll_pressed() -> void:
	if phase == Phase.ROLL:
		do_roll()


func do_roll() -> void:
	var e := epoch
	phase = Phase.BUSY
	# the thrower gathers the dice into his fist, rattles them and casts them
	roll = -1
	await hand_throw(game.current)
	if e != epoch:
		return
	await dice_settled
	if e != epoch:
		return
	roll = 0
	for r in dice_result:
		roll += r
	var who := "You" if game.current == HUMAN else "Al-Khasm"
	legal = game.legal_moves(game.current, roll)
	if legal.is_empty():
		set_status("%s threw %d\nno move" % [who, roll])
		await get_tree().create_timer(1.3).timeout
		if e != epoch:
			return
		game.current = 1 - game.current
		start_turn()
		return
	if game.current == HUMAN:
		phase = Phase.MOVE
		set_status("You threw %d\nmove a stone %d" % [roll, roll])
	else:
		set_status("Al-Khasm threw %d" % roll)
		await get_tree().create_timer(0.8).timeout
		if e != epoch:
			return
		var src := UrAI.choose_move(game, roll)
		perform_move(game.pos[AI].find(src))


func perform_move(idx: int) -> void:
	var e := epoch
	var p := game.current
	var h: UrHand = hands[p]
	var who := "You" if p == HUMAN else "Al-Khasm"
	var src: int = game.pos[p][idx]
	var dst := src + roll
	var node: Node3D = pnodes[p][idx]
	var done_k := game.finished_count(p)
	var held := p == HUMAN and human_holding and sel_idx == idx
	legal = []
	phase = Phase.BUSY
	sel_idx = -1
	dragging = false
	human_holding = false

	var slide_back := true   # set aside mid-capture: can it be pushed straight back in?
	var capt_idx := -1
	if dst >= UrGame.SHARED_FIRST and dst <= UrGame.SHARED_LAST:
		capt_idx = game.pos[1 - p].find(dst)
	var dst_pos := rest(slot_pos(p, dst, idx, done_k))
	var victim: Node3D = pnodes[1 - p][capt_idx] if capt_idx != -1 else null

	if held and victim:
		# set our stone down beside the one we are taking, lift that one off, then push ours across
		var aside := free_spot_beside(dst_pos, p, [node, victim])
		var beside: Vector3 = aside.spot
		slide_back = aside.slide
		await hand_move(h, beside + Vector3(0, LIFT, 0), 0.2, 0.0, 28.0, node)   # across, clear of it
		if e != epoch:
			return
		await hand_move(h, beside, 0.18, 0.0, 30.0, node)                         # then down
		if e != epoch:
			return
		await hand_let_go(h, node, "stone_place")
		if e != epoch:
			return
	if victim:
		# the captured stone goes back to its owner's strip
		await hand_take(h, victim)
		if e != epoch:
			return
		await hand_move(h, rest(slot_pos(1 - p, 0, capt_idx, 0)), randf_range(0.55, 0.75), 0.9, 24.0, victim, randf_range(-0.6, 0.6))
		if e != epoch:
			return
		await hand_let_go(h, victim, "stone_place")
		if e != epoch:
			return
	if not held or victim:
		await hand_take(h, node)
		if e != epoch:
			return

	if dst >= UrGame.FINISH:
		# turn it to lie in line with the others on the home plate
		var spin_tw := create_tween()
		tweens.append(spin_tw)
		spin_tw.tween_property(node, "rotation:y", home_yaw(node.rotation.y, done_k, p), 0.5) \
			.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	var land := "stone_place"
	if held and not victim:
		# already over the square: lower it in
		await hand_move(h, dst_pos, randf_range(0.18, 0.26), 0.0, 30.0, node)
	elif (held and victim and slide_back) or (not held and can_slide(p, src, dst)):
		# pushed along the board, square by square
		var pts: Array = []
		if held and victim:
			pts.append(dst_pos)
		else:
			for i in range(src + 1, dst + 1):
				pts.append(rest(cell_pos(path_cell(p, i))))
		await hand_slide(h, node, pts)
		land = ""
	else:
		# lifted over other stones, or from one slab to another
		await hand_move(h, dst_pos, randf_range(0.5, 0.75), randf_range(0.7, 1.0), 26.0, node, randf_range(-0.5, 0.5))
	if e != epoch:
		return
	await hand_let_go(h, node, land)
	if e != epoch:
		return
	hand_leave(h)

	var r := game.apply_move(p, src, roll, idx)
	# a save from here on keeps this move, and whose turn comes of it
	turn_state = game.clone()
	if not r.extra_turn:
		turn_state.current = 1 - p
	var msg := "%s moved %d" % [who, roll]
	if r.captured:
		msg = "%s captured a stone" % who
	if game.has_won(p):
		phase = Phase.OVER
		set_status("You win!" if p == HUMAN else "Al-Khasm wins")
		return
	if r.extra_turn:
		msg = "Rosette\n%s again" % ("you throw" if p == HUMAN else "Al-Khasm throws")
	set_status(msg)
	await get_tree().create_timer(0.8).timeout
	if e != epoch:
		return
	if not r.extra_turn:
		game.current = 1 - p
	start_turn()


# ======================================================================
# Al-Khasm's dates
# ======================================================================

## Whether he takes a date now, with the given chance: only if there are any left, his
## left hand is free and he has not just had one.
func may_snack(chance: float) -> bool:
	if not snack_ok or left_busy or bowl.remaining() == 0:
		return false
	if Time.get_ticks_msec() / 1000.0 - last_eat < 9.0:
		return false
	return randf() < chance * snack_rate


## On your turn he may reach for a date while he waits for you.
func snack_while_waiting(e: int) -> void:
	await get_tree().create_timer(randf_range(1.2, 4.5)).timeout
	if e != epoch or game.current != HUMAN or not (phase == Phase.ROLL or phase == Phase.MOVE):
		return
	if may_snack(0.35):
		eat_date()


## Move his left hand's grip to `to` over dur seconds (eased), arcing up by `arc`, its
## fingers turning to point along fwd and tipping to `pitch` degrees on the way. Not one
## of the game's tweens: a new game does not stop him eating.
func lh_move(h: UrHand, to: Vector3, dur: float, arc: float, pitch: float, fwd: Vector3) -> void:
	h.move_id += 1
	var my := h.move_id
	var from := h.grip_target
	var p0 := h.aim_pitch
	var f0 := Vector3(h.aim_fwd.x, 0.0, h.aim_fwd.z).normalized()
	var f1 := Vector3(fwd.x, 0.0, fwd.z).normalized()
	var turn := f0.signed_angle_to(f1, Vector3.UP)
	var tw := create_tween()
	tw.tween_method(func(t: float) -> void:
		if h.move_id != my:
			return
		var g := from.lerp(to, t) + Vector3(0, sin(t * PI) * arc, 0)
		h.place(g, f0.rotated(Vector3.UP, turn * t), lerpf(p0, pitch, t), h.aim_roll),
		0.0, 1.0, dur).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	await tw.finished


## Where thumb and fingers meet on a date (hand-local cm): as on a stone on the board.
func pinch_point(_pitch: float) -> Vector3:
	return UrHand.GRASP_C


## Thumb, index and middle finger pinching something of half-width r with the hand tipped
## `pitch` degrees, their pads meeting across it level (so as they open and close they
## stay at its middle height); the ring and little finger hang loosely curled (not tucked
## tight into the palm, as for a stone on the board: in a bowl they would catch the lip).
var date_poses := {}
func date_pose(h: UrHand, r: float, pitch: float) -> Dictionary:
	var key := "%.2f_%.0f" % [r, pitch]
	if date_poses.has(key):
		return date_poses[key]
	var d: Dictionary = h.grasp_level(r, pitch).duplicate()
	var loose := {"ring": [40.0, 52.0, 28.0, -3.0], "pinky": [44.0, 56.0, 30.0, -7.0]}
	for f in loose:
		var v: Array = loose[f]
		d[h.bones[f + "_0"]] = Vector2(v[0], v[3])
		d[h.bones[f + "_1"]] = Vector2(v[1], 0.0)
		d[h.bones[f + "_2"]] = Vector2(v[2], 0.0)
	date_poses[key] = d
	return d


## The way across a date (horizontal, world) on his side of it.
func date_across(h: UrHand, d: Node3D) -> Vector3:
	var nat := d.global_position - h.shoulder
	nat.y = 0.0
	nat = nat.normalized()
	var ax := d.global_transform.basis.z
	ax.y = 0.0
	if ax.length() < 0.01:
		return nat
	ax = ax.normalized()
	var across := Vector3(-ax.z, 0.0, ax.x)
	return across if across.dot(nat) >= 0.0 else -across


## Before he reaches, the hand works out how: which of the dates lying free on top, the
## fingers turned which way and tipped how steeply, so that coming straight down onto it,
## open, and closing on it, nothing of the hand (or the sleeve) touches the clay, and the
## fingers push as little as possible into the dates round it (least of all the ones
## underneath, which cannot give way). He likes to take a date across its middle, thumb
## on one side and fingers on the other, with the wrist turned no more than it must from
## the way his arm reaches; by a wall he turns it more, or comes down steeper, or takes
## the date slantwise (wider between thumb and fingers). Spread over a few frames.
func plan_date(h: UrHand) -> Dictionary:
	var cands := bowl.candidates(bowl.global_position - h.shoulder, 7)
	var n := 0
	h.grip_override = UrHand.GRASP_C
	# (tried out unseen, and without being pushed out of the clay: that is what is measured)
	var solid := h.solid
	h.solid = Callable()
	# first, quickly, every way: the hand closed on the date, as it is, fingers unbent
	var tries: Array = []
	for d in cands:
		var c: Vector3 = d.global_position
		var nat := c - h.shoulder
		nat.y = 0.0
		nat = nat.normalized()
		var across := date_across(h, d)
		var half: Vector2 = bowl.date_half(d)        # (across, along) in cm
		for k in 7:
			var turn := (k - 3) * 0.3
			var fwd := nat.rotated(Vector3.UP, turn)
			# how slantwise that takes the date: 0 straight across, 90 degrees end to end
			var slant := acos(clampf(absf(fwd.dot(across)), 0.0, 1.0))
			var half_w := Vector2(half.x * cos(slant), half.y * sin(slant)).length()
			for pitch: float in [26.0, 34.0, 42.0]:
				h.set_pose_dict(date_pose(h, half_w * 0.9, pitch), true)
				for lift_cm: float in [0.0, 0.6]:
					var g := c + Vector3(0, lift_cm * DateBowl.CM, 0)
					h.place(g, fwd, pitch)
					var parts: Vector2 = bowl.hand_clear_parts(h.global_transform, h)   # (fingers, the rest)
					var crowd := bowl.date_crowding(h.global_transform, h, d, c.y / DateBowl.CM - 0.3)
					var score: float = -0.3 * crowd - 0.7 * absf(turn) - 1.2 * slant - 0.6 * lift_cm + randf() * 0.2
					score -= 2.0 * maxf(-parts.x / DateBowl.CM, 0.0)               # fingers that will have to bend
					if parts.y < -0.05 * DateBowl.CM:
						score -= 100.0 + 300.0 * (-0.05 * DateBowl.CM - parts.y) / DateBowl.CM
					tries.append({"score": score, "date": d, "fwd": fwd, "pitch": pitch, "half_w": half_w, "grip": g,
						"crowd": crowd, "c": c})
					n += 1
					if n % 24 == 0:
						await get_tree().process_frame
	tries.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return float(a.score) > float(b.score))
	# then the best few properly: open above it and closing as it comes down the last
	# little way onto it, the fingers giving way where they meet the clay or a date
	var best := {}
	for t in tries.slice(0, 10):
		var g: Vector3 = t.grip
		var fwd: Vector3 = t.fwd
		var pitch: float = t.pitch
		var half_w: float = t.half_w
		var clear := 1e9
		h.set_pose_dict(date_pose(h, half_w + 1.3, pitch), true)
		for j in [3, 2, 1]:
			h.place(g + Vector3(0, 0.35 * j, 0), fwd, pitch)
			bowl.conform(h.global_transform, h)
			clear = minf(clear, bowl.hand_clear(h.global_transform, h))
		h.set_pose_dict(date_pose(h, half_w + 0.5, pitch), true)
		h.place(g + Vector3(0, 0.15, 0), fwd, pitch)
		bowl.conform(h.global_transform, h)
		clear = minf(clear, bowl.hand_clear(h.global_transform, h))
		h.set_pose_dict(date_pose(h, half_w * 0.9, pitch), true)
		h.place(g, fwd, pitch)
		bowl.conform(h.global_transform, h)
		clear = minf(clear, bowl.hand_clear(h.global_transform, h))
		var score: float = t.score
		# fingertips may rest on the clay; never press into it
		if clear < -0.05 * DateBowl.CM:
			score -= 100.0 + 300.0 * (-0.05 * DateBowl.CM - clear) / DateBowl.CM
		t["clear"] = clear
		t["score"] = score
		if best.is_empty() or score > float(best.score):
			best = t
		await get_tree().process_frame
	h.set_pose("relaxed", true)
	h.solid = solid
	return best


## He reaches into the bowl at his left, takes a date and lifts it away to his mouth. Back
## when the date is gone from view (his game can go on); the stone comes out later.
## Everything is solid: his hand comes down over the clay, never into it; his fingers
## push the dates beside the one he takes out of their way, and when it comes out the
## others slump into the gap it leaves.
func eat_date() -> void:
	if left_busy or bowl.remaining() == 0:
		return
	eating = true
	left_busy = true
	var h := lhand
	var plan: Dictionary = await plan_date(h)
	if plan.is_empty():
		eating = false
		left_busy = false
		ate.emit()
		return
	var d: Node3D = plan.date
	var grip_at: Vector3 = plan.grip
	bowl.spare_date = d
	if OS.get_environment("PLAN_LOG") != "":
		print("plan: clear %.2f cm, crowd %.2f, pitch %.0f, score %.2f" % [float(plan.clear) / DateBowl.CM, plan.crowd, plan.pitch, plan.score])
	bowl.hold_still(d, true)        # lying in the heap, it does not go anywhere by itself
	var c := d.global_position
	var fwd: Vector3 = plan.fwd
	var pitch: float = plan.pitch
	var half_w: float = plan.half_w
	# in from beyond his shoulder, fingers and thumb opening as the hand comes over the bowl
	h.effort = 0.0
	h.set_pose("relaxed", true)
	h.aim_yaw = 0.0
	h.aim_roll = 0.0
	h.grip_override = pinch_point(pitch)
	h.place(offstage(h, c), fwd, 10.0)
	h.visible = true
	h.set_pose_dict(date_pose(h, half_w + 1.3, pitch))
	await lh_move(h, grip_at + Vector3(0, 1.3, 0), randf_range(0.75, 0.95), 0.6, pitch, fwd)
	# down among them, slowing as it goes in: from here on the hand is solid to the dates
	bowl.set_hand_solid(true, d)
	await lh_move(h, grip_at + Vector3(0, 0.35, 0), randf_range(0.3, 0.38), 0.0, pitch, fwd)
	# closing round it as the hand settles onto it
	h.pose_rate = 7.0
	h.set_pose_dict(date_pose(h, half_w + 0.5, pitch))
	await lh_move(h, grip_at, randf_range(0.3, 0.38), 0.0, pitch, fwd)
	# the fingers close on it; it is soft, and gives a little
	h.pose_rate = 12.0
	h.set_pose_dict(date_pose(h, half_w * 0.9, pitch))
	h.effort = 0.45
	await get_tree().create_timer(randf_range(0.2, 0.28)).timeout
	play_sfx("date_pick", c)
	h.pose_rate = 9.0
	bowl.remove(d)
	var rel := h.global_transform.affine_inverse() * d.global_transform
	d.reparent(self)
	var follow := func() -> void: d.global_transform = h.global_transform * rel
	h.placed.connect(follow)
	bowl.stir()
	# drawn up out of the heap (slowly at first: it is a little stuck to the others), then
	# clear of the bowl, then away to his mouth
	await lh_move(h, grip_at + Vector3(0, 0.35, 0), randf_range(0.3, 0.38), 0.0, pitch, fwd)
	await lh_move(h, grip_at + Vector3(0, 1.6, 0), randf_range(0.3, 0.4), 0.0, pitch, fwd)
	bowl.set_hand_solid(false)
	var to_mouth := MOUTH - c
	await lh_move(h, MOUTH, randf_range(0.85, 1.05), 0.8, -15.0, to_mouth)
	h.placed.disconnect(follow)
	d.queue_free()
	h.visible = false
	h.grip_override = null
	last_eat = Time.get_ticks_msec() / 1000.0
	eating = false
	ate.emit()
	spit_stone()


## He chews a while, then his hand comes back with the stone and puts it down on the sand
## beside the bowl.
func spit_stone(wait := -1.0) -> void:
	await get_tree().create_timer(randf_range(chew.x, chew.y) if wait < 0.0 else wait).timeout
	var h := lhand
	var spot := bowl.pit_spot()
	var pit := bowl.make_pit()
	add_child(pit)
	var pitch := 38.0
	var fwd := spot - h.shoulder
	fwd.y = 0.0
	h.grip_override = UrHand.GRASP_C
	h.aim_yaw = 0.0
	h.aim_roll = 0.0
	h.set_pose_dict(h.grasp_level(0.42, pitch), true)
	h.effort = 0.35
	h.place(offstage(h, spot), fwd, 10.0)
	h.visible = true
	# the stone lies across his fingertips, pinched by its middle
	var rel := Transform3D(Basis(Vector3(0, 0, -1), Vector3(0, 1, 0), Vector3(1, 0, 0)), UrHand.GRASP_C)
	var follow := func() -> void: pit.global_transform = h.global_transform * rel
	follow.call()
	h.placed.connect(follow)
	await lh_move(h, spot + Vector3(0.1, 1.2, -0.6), randf_range(0.9, 1.1), 0.5, pitch, fwd)
	await lh_move(h, spot + Vector3(0, 0.4, 0), randf_range(0.3, 0.4), 0.0, pitch, fwd)
	h.placed.disconnect(follow)
	h.pose_rate = 16.0
	h.set_pose_dict(h.grasp_level(1.4, pitch))
	h.effort = 0.0
	# it drops to the sand and lies on its side
	var from := pit.global_transform
	var rest_b := (Basis(Vector3.UP, randf() * TAU) * Basis(Vector3.BACK, randf_range(-0.6, 0.6) + (PI if randf() < 0.5 else 0.0))) \
		.scaled(Vector3.ONE * DateBowl.CM)
	var to := Transform3D(rest_b, spot + Vector3(0, float(pit.get_meta("half_h")) * DateBowl.CM, 0))
	var tw := create_tween()
	tw.tween_method(func(t: float) -> void:
		var q := from.interpolate_with(to, t)
		q.origin = from.origin.lerp(to.origin, t)
		q.origin.y = lerpf(from.origin.y, to.origin.y, t * t)
		pit.global_transform = q, 0.0, 1.0, 0.17)
	await tw.finished
	play_sfx("pit_drop", spot)
	pits.append(pit)
	await get_tree().create_timer(0.12).timeout
	h.pose_rate = 9.0
	h.set_pose("relaxed")
	await lh_move(h, offstage(h, spot), randf_range(0.6, 0.8), 0.3, 10.0, fwd)
	h.visible = false
	h.grip_override = null
	left_busy = false


# ======================================================================
# Flies
# ======================================================================

## He keeps half an eye on the flies at his elbow. One on his dates he waves off almost
## at once; one on the stones he has spat out he lets be a good long while, and then only
## waves a lazy hand at it. Having just shooed one, he lets the next sit a while before
## he can be bothered again.
func watch_flies(delta: float) -> void:
	fly_clock += delta
	if not shoo_ok or flies == null or left_busy or eating or fly_clock < shoo_next:
		shoo_free = fly_clock
		return
	for f in flies.sitting():
		# his patience runs from when the fly sat down, or from when he was ready to be
		# bothered again, whichever came later: never the very moment he is free
		var seen := minf(float(f.sat), fly_clock - shoo_free)
		if seen < float(f.patience):
			continue
		shooing.emit("pit" if f.kind == "pit" else "bowl", seen)
		if f.kind == "pit":
			shoo_pits(f.pos)
		else:
			shoo_bowl(f.pos)
		return


## Move his left hand along a path: at(t) gives [grip, fwd, pitch, roll] for t from 0 to 1.
func lh_path(h: UrHand, at: Callable, dur: float, ease := Tween.EASE_IN_OUT) -> void:
	h.move_id += 1
	var my := h.move_id
	var tw := create_tween()
	tw.tween_method(func(t: float) -> void:
		if h.move_id != my:
			return
		var a: Array = at.call(t)
		h.place(a[0], a[1], a[2], a[3]), 0.0, 1.0, dur).set_trans(Tween.TRANS_SINE).set_ease(ease)
	await tw.finished


## The way from his left shoulder to `at`, level.
func lh_fwd(at: Vector3) -> Vector3:
	var fwd := at - lhand.shoulder
	fwd.y = 0.0
	return fwd.normalized()


## How high his hand must keep over the bowl to pass over the dates heaped in it.
func heap_top() -> float:
	var y := bowl.global_position.y + 3.9 * DateBowl.CM
	for d in bowl.dates:
		y = maxf(y, (d.node as Node3D).global_position.y + 1.0 * DateBowl.CM)
	return y


## A fly on his dates: a quick flick of the hand across over the bowl, fingers loose and
## open, the wrist snapping the palm round as it goes, and straight back.
func shoo_bowl(at: Vector3) -> void:
	left_busy = true
	var h := lhand
	var fwd := lh_fwd(at)
	var out := Vector3.UP.cross(fwd).normalized()        # his left: out past the bowl
	var y := maxf(at.y, heap_top())
	var start := Vector3(at.x, y, at.z) + out * randf_range(1.0, 1.3) + Vector3(0, randf_range(1.35, 1.6), 0)
	var stop := Vector3(at.x, y, at.z) - out * randf_range(0.9, 1.2) + Vector3(0, randf_range(1.05, 1.25), 0)
	h.effort = 0.0
	h.grip_override = null
	h.aim_yaw = 0.0
	h.set_pose("relaxed", true)
	h.place(offstage(h, at), fwd, 10.0)
	h.visible = true
	h.pose_rate = 14.0
	h.set_pose("reach")
	var from := h.grip_target
	var p0 := h.aim_pitch
	await lh_path(h, func(t: float) -> Array:
		return [from.lerp(start, t) + Vector3(0, sin(t * PI) * 0.4, 0), fwd, lerpf(p0, 6.0, t), lerpf(0.0, 25.0, t)],
		randf_range(0.36, 0.46), Tween.EASE_OUT)
	# the flick: palm round to lead, across and a little down over the dates
	h.effort = 0.25
	await lh_path(h, func(t: float) -> Array:
		return [start.lerp(stop, t) - Vector3(0, sin(t * PI) * 0.2, 0), fwd, 6.0 + 8.0 * t, lerpf(25.0, 72.0, t)],
		randf_range(0.17, 0.23))
	shoo_next = fly_clock + randf_range(7.0, 16.0)
	await get_tree().create_timer(randf_range(0.05, 0.12)).timeout
	h.effort = 0.0
	h.pose_rate = 9.0
	h.set_pose("relaxed")
	var back := offstage(h, at)
	await lh_path(h, func(t: float) -> Array:
		return [stop.lerp(back, t) + Vector3(0, sin(t * PI) * 0.3, 0), fwd, lerpf(14.0, 10.0, t), lerpf(72.0, 0.0, t)],
		randf_range(0.5, 0.65), Tween.EASE_IN)
	h.visible = false
	left_busy = false


## A fly on the date stones in the sand: in the end he lifts a slow hand over, and gives
## a lazy wave or two over them, not much caring whether it goes, and takes the hand back.
func shoo_pits(at: Vector3) -> void:
	left_busy = true
	var h := lhand
	var fwd := lh_fwd(at)
	var out := Vector3.UP.cross(fwd).normalized()
	var over := at + out * 0.35 + Vector3(0, randf_range(1.2, 1.5), 0)
	h.effort = 0.0
	h.grip_override = null
	h.aim_yaw = 0.0
	h.set_pose("relaxed", true)
	h.place(offstage(h, at), fwd, 10.0)
	h.visible = true
	h.pose_rate = 4.0
	var from := h.grip_target
	var p0 := h.aim_pitch
	await lh_path(h, func(t: float) -> Array:
		return [from.lerp(over, t) + Vector3(0, sin(t * PI) * 0.3, 0), fwd, lerpf(p0, 18.0, t), lerpf(0.0, 15.0, t)],
		randf_range(1.3, 1.7))
	# the wave: side to side, sinking a little nearer them, the wrist loose
	var waves := randf_range(1.0, 2.0)
	var amp := randf_range(0.55, 0.75)
	var low := randf_range(0.8, 1.0)
	await lh_path(h, func(t: float) -> Array:
		var s := sin(t * waves * TAU)
		var g := over + out * (s * amp - 0.35 * t) - Vector3(0, (over.y - at.y - low) * sin(t * PI), 0)
		return [g, fwd, 18.0, 15.0 + 22.0 * absf(s) + 8.0 * sin(t * PI)],
		randf_range(1.3, 1.7) * waves / 1.5)
	shoo_next = fly_clock + randf_range(12.0, 25.0)
	var here := h.grip_target
	var r0 := h.aim_roll
	var back := offstage(h, at)
	await lh_path(h, func(t: float) -> Array:
		return [here.lerp(back, t) + Vector3(0, sin(t * PI) * 0.3, 0), fwd, lerpf(18.0, 10.0, t), lerpf(r0, 0.0, t)],
		randf_range(1.0, 1.3))
	h.pose_rate = 9.0
	h.visible = false
	left_busy = false


## (Tests) He has eaten one: the date is gone and its stone lies by the bowl.
func eat_instantly() -> void:
	var d := bowl.take_date()
	if d == null:
		return
	d.queue_free()
	var pit := bowl.make_pit()
	add_child(pit)
	var spot := bowl.pit_spot()
	var b := (Basis(Vector3.UP, randf() * TAU) * Basis(Vector3.BACK, randf_range(-0.6, 0.6))).scaled(Vector3.ONE * DateBowl.CM)
	pit.global_transform = Transform3D(b, spot + Vector3(0, float(pit.get_meta("half_h")) * DateBowl.CM, 0))
	pits.append(pit)


## A move slides along the board when it stays on the board and every square it
## passes over is empty; otherwise the stone has to be lifted.
## Is board-local point (x, z) on one of the board's squares (not off the edge, not in the
## gap where the side rows have no squares)?
func on_board_local(lx: float, lz: float) -> bool:
	var cx := roundi(lx + 3.5)
	var cy := roundi(lz + 1.0)
	if absf(lx) > 3.85 or absf(lz) > 1.35 or cx < 0 or cx > 7 or cy < 0 or cy > 2:
		return false
	return cy == 1 or (cx != 4 and cx != 5)


## Shortest distance from point c to segment a-b on the table (xz plane).
func seg_dist_xz(a: Vector3, b: Vector3, c: Vector3) -> float:
	var a2 := Vector2(a.x, a.z)
	var ab := Vector2(b.x, b.z) - a2
	var c2 := Vector2(c.x, c.z)
	var t := clampf((c2 - a2).dot(ab) / maxf(ab.length_squared(), 1e-6), 0.0, 1.0)
	return (a2 + ab * t).distance_to(c2)


## A spot near `at` where player p can set a stone down for a moment, clear of every other
## stone (including the one still sitting on `at`). Returns {"spot": Vector3, "slide": bool}:
## slide is true when the stone can then be pushed straight back onto `at` without brushing
## anything; otherwise it has to be lifted back over. Prefers near, slidable, on our own side.
func free_spot_beside(at: Vector3, p: int, ignore: Array) -> Dictionary:
	var bx := board_xf()
	var local := bx.affine_inverse() * at
	var s := 1.0 if p == HUMAN else -1.0
	var others: Array = []
	for q in 2:
		for n in pnodes[q]:
			if not ignore.has(n):
				others.append(n.global_position)
	var need := 2.0 * PIECE_R + 0.1
	var best := {"spot": at + bx.basis * Vector3(0, 0, 0.85 * s), "slide": false}
	var best_cost := INF
	var best_clear := -INF   # only used if nowhere is clear (cannot happen: 20 squares, 14 stones)
	for gx in range(-15, 16):
		for gz in range(-5, 6):
			var lx := gx * 0.25
			var lz := gz * 0.25
			if not on_board_local(lx, lz):
				continue
			var spot: Vector3 = bx * Vector3(lx, local.y, lz)
			var d := Vector2(spot.x - at.x, spot.z - at.z).length()
			var clear := d
			var path_clear := INF
			for o in others:
				clear = minf(clear, Vector2(o.x - spot.x, o.z - spot.z).length())
				path_clear = minf(path_clear, seg_dist_xz(spot, at, o))
			if clear < need:
				if best_cost == INF and clear > best_clear:
					best_clear = clear
					best = {"spot": spot, "slide": false}
				continue
			var slide := path_clear >= need
			var cost := d + (0.0 if slide else 1.0) + (0.15 if (lz - local.z) * s < 0.0 else 0.0)
			if cost < best_cost:
				best_cost = cost
				best = {"spot": spot, "slide": slide}
	return best


func can_slide(p: int, src: int, dst: int) -> bool:
	if src == 0 or dst >= UrGame.FINISH:
		return false
	for i in range(src + 1, dst):
		if game.pos[p].has(i):
			return false
		if i >= UrGame.SHARED_FIRST and i <= UrGame.SHARED_LAST and game.pos[1 - p].has(i):
			return false
	return true


# ======================================================================
# Hands: every stone is moved, and every throw made, by a player's hand
# ======================================================================

var hands: Array = [null, null]
var bowl: DateBowl
var lhand: UrHand                   # Al-Khasm's left hand: it takes his dates
var eating := false                 # he is taking a date to his mouth: his game waits for it
var left_busy := false              # his left hand is about something (a date, or putting its stone down)
var snack_ok := true                # (the tests turn his snacking off)
var snack_rate := 1.0               # (and can make him hungrier)
var chew := Vector2(16.0, 26.0)     # how long a date takes him, mouth to stone (s): a dried date is
									# bitten, chewed round the stone, the stone worked clean
var last_eat := -100.0              # when he last took one (seconds)
var pits: Array = []                # the date stones he has put down on the sand
var flies: Flies                    # drawn to his dates and to those stones
var shoo_ok := true                 # (the tests can stop him shooing them)
var shoo_next := 0.0                # (fly_clock) he has only just shooed one: not again before this
var fly_clock := 0.0                # seconds of game time, for the above
var shoo_free := 0.0                # (fly_clock) since when he has been free to shoo one
signal shooing(kind: String, sat: float)   # (tests) he is about to shoo a fly: off the "bowl" or the "pit"s
signal ate
const AI_LEFT_SHOULDER := Vector3(7.4, 4.8, -12.0)
const MOUTH := Vector3(3.3, 9.4, -10.4)   # where his mouth is, well out of view
var human_holding := false          # the human's fingers hold the selected stone (dragging)
var release_pending: Variant = null  # mouse released before the hand had reached the stone
var drag_target := Vector3.ZERO
var slide_player: AudioStreamPlayer3D
var last_throw: Array = []
var dice_hand: UrHand = null        # the dice are in this hand (they ride along with it)
var grip: DiceGrip                  # the dice as solid things in that hand
var hand_knock_cool := 0.0


func build_hands() -> void:
	# white robe across the table from the AI's black; each reaches from his right shoulder
	# (the human's arm comes in from low on the right, so it does not hide what his hand is doing)
	hands[HUMAN] = UrHand.new(UrHand.Style.WHITE, Vector3(3.0, 3.4, 10.0), Vector3(1, 0, 0))
	hands[HUMAN].lean = 0.15
	hands[AI] = UrHand.new(UrHand.Style.BLACK, Vector3(-1.0, 4.8, -12.0), Vector3(-1, 0, 0))
	for h in hands:
		add_child(h)
		h.solid = grip.hand_push    # the dice tray is wood and leather: hands rest on it
	# and his left, which only ever goes to the bowl of dates at his left side
	lhand = UrHand.new(UrHand.Style.BLACK, AI_LEFT_SHOULDER, Vector3(1, 0, 0), true)
	lhand.lean = 0.3
	add_child(lhand)
	lhand.solid = bowl.hand_push    # the clay is solid to it
	bowl.attach_hand(lhand)         # and it is solid to the dates
	flies = Flies.new(bowl, pits, [lhand, hands[AI], hands[HUMAN]])
	add_child(flies)
	slide_player = AudioStreamPlayer3D.new()
	slide_player.attenuation_model = AudioStreamPlayer3D.ATTENUATION_DISABLED
	slide_player.attenuation_filter_db = 0.0
	slide_player.panning_strength = 0.6
	add_child(slide_player)


## Fingers point from his shoulder toward the hand; near or behind the shoulder
## (coming in, going away) they keep pointing at the table.
func hand_fwd(h: UrHand, at: Vector3) -> Vector3:
	var table := Vector3(-1.0, 0.0, 0.0) - h.shoulder
	table.y = 0.0
	table = table.normalized()
	var d := at - h.shoulder
	d.y = 0.0
	var reach := d.dot(table)
	if reach < 2.0:
		return table
	return table.lerp(d.normalized(), clampf((reach - 2.0) / 3.0, 0.0, 1.0)).normalized()


## A resting place for the hand just past the player's shoulder, outside the camera's view.
func offstage(h: UrHand, toward: Vector3) -> Vector3:
	var back := h.shoulder - toward
	back.y = 0.0
	var q := h.shoulder + back.normalized() * 2.0
	q.y = h.shoulder.y - 0.5
	return q


func hand_enter(h: UrHand, toward: Vector3) -> void:
	if h.visible:
		return
	# start just beyond his shoulder, out of view
	var start := offstage(h, toward)
	h.effort = 0.0
	h.set_pose("relaxed", true)
	h.aim_yaw = 0.0
	h.place(start, hand_fwd(h, toward), 10.0)
	h.visible = true


## Move the hand's grip point to `to` over dur seconds (eased), arcing up by `arc`.
## A carried stone follows the grip, turning by `twist` radians on the way.
## A newer move on the same hand takes over from this one.
## The hand also turns to `yaw` and rolls to `roll` (degrees) on the way, if given.
func hand_move(h: UrHand, to: Vector3, dur: float, arc := 0.0, pitch := NAN, carry: Node3D = null, twist := 0.0,
		yaw := NAN, roll := NAN) -> void:
	h.move_id += 1
	var my := h.move_id
	var from := h.grip_target
	var p0 := h.aim_pitch
	var p1 := p0 if is_nan(pitch) else pitch
	var yw0 := h.aim_yaw
	var yw1 := yw0 if is_nan(yaw) else yaw
	var rl0 := h.aim_roll
	var rl1 := rl0 if is_nan(roll) else roll
	var y0 := carry.rotation.y if carry else 0.0
	var tw := create_tween()
	tweens.append(tw)
	tw.tween_method(func(t: float) -> void:
		if h.move_id != my:
			return
		var g := from.lerp(to, t) + Vector3(0, sin(t * PI) * arc, 0)
		h.aim_yaw = lerpf(yw0, yw1, t)
		h.place(g, hand_fwd(h, g), lerpf(p0, p1, t), lerpf(rl0, rl1, t))
		if carry:
			carry.position = g
			carry.rotation.y = y0 + twist * t,
		0.0, 1.0, dur).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	await tw.finished


## Push a held stone along the board through the given points, the wood whispering under it.
func hand_slide(h: UrHand, node: Node3D, pts: Array) -> void:
	var path: Array = [node.position]
	path.append_array(pts)
	var lens: Array = [0.0]
	for i in range(1, path.size()):
		lens.append(float(lens[-1]) + (path[i] as Vector3).distance_to(path[i - 1]))
	var total: float = lens[-1]
	if total < 0.01:
		return
	var dur := 0.2 + total * randf_range(0.16, 0.22)
	var y0 := node.rotation.y
	var twist := randf_range(-0.3, 0.3)
	# the grind of stone on wood swells as the push gets going and dies as it slows, a
	# touch higher while it moves fastest; each slide starts somewhere else in the clip
	var arr: Array = sfx.get("stone_slide", [])
	var pitch0 := randf_range(0.93, 1.07)
	if not arr.is_empty():
		var st: AudioStream = arr[randi() % arr.size()]
		slide_player.stream = st
		slide_player.volume_db = -50.0
		slide_player.pitch_scale = pitch0
		slide_player.position = node.position
		slide_player.play(randf_range(0.0, maxf(st.get_length() - dur * pitch0 * 1.05 - 0.1, 0.0)))
	h.move_id += 1
	var my := h.move_id
	var tw := create_tween()
	tweens.append(tw)
	tw.tween_method(func(u: float) -> void:
		if h.move_id != my:
			return
		var t := (1.0 - cos(u * PI)) * 0.5     # eased: starts and stops gently
		var speed := sin(u * PI)               # how fast the stone is going (0..1)
		slide_player.volume_db = SFX_DB["stone_slide"] + linear_to_db(0.12 + 0.88 * speed)
		slide_player.pitch_scale = pitch0 * (0.95 + 0.08 * speed)
		var s := t * total
		var k := 1
		while k < lens.size() - 1 and float(lens[k]) < s:
			k += 1
		var seg := clampf((s - float(lens[k - 1])) / maxf(float(lens[k]) - float(lens[k - 1]), 0.0001), 0.0, 1.0)
		var g: Vector3 = (path[k - 1] as Vector3).lerp(path[k], seg)
		h.place(g, hand_fwd(h, g), 30.0, h.aim_roll)
		node.position = g
		node.rotation.y = y0 + twist * t
		slide_player.position = g,
		0.0, 1.0, dur)
	await tw.finished
	var fade := create_tween()
	fade.tween_property(slide_player, "volume_db", -50.0, 0.06)
	fade.tween_callback(slide_player.stop)


## Reach for a stone and take it: the hand comes down with thumb and fingers spread
## round it, then closes until the finger pads and the thumb press on its sides.
func hand_take(h: UrHand, node: Node3D, quick := false) -> void:
	var at := node.position
	hand_enter(h, at)
	h.grip_override = UrHand.GRASP_C
	h.set_pose_dict(h.grasp_pose(UrHand.STONE_OPEN_R))
	var k := 0.65 if quick else 1.0
	await hand_move(h, at + Vector3(0, 1.1, 0), randf_range(0.45, 0.7) * k, 0.5, 30.0, null, 0.0, 0.0, 0.0)
	await hand_move(h, at + Vector3(0, 0.03, 0), randf_range(0.2, 0.28) * k, 0.0, 32.0)
	h.pose_rate = 16.0
	h.set_pose_dict(h.grasp_pose(UrHand.STONE_GRIP_R))
	h.effort = 0.9
	await get_tree().create_timer(randf_range(0.16, 0.22) * k).timeout
	h.pose_rate = 9.0
	h.effort = 0.6        # once it is up, a pebble is light to carry
	play_sfx("stone_lift", at)


## Open the fingers off a stone (already on the wood): it rocks and settles; the hand lifts away.
func hand_let_go(h: UrHand, node: Node3D, land := "") -> void:
	if land != "":
		play_sfx(land, node.position)
	else:
		play_sfx("stone_place", node.position, -12.0)
	h.pose_rate = 16.0
	h.set_pose_dict(h.grasp_pose(UrHand.STONE_OPEN_R))
	h.effort = 0.0
	settle(node)
	await get_tree().create_timer(0.12).timeout
	h.pose_rate = 9.0
	await hand_move(h, h.grip_target + Vector3(0, 0.8, 0), randf_range(0.2, 0.3), 0.0, 24.0)


func hand_leave(h: UrHand) -> void:
	h.effort = 0.0
	h.set_pose("relaxed")
	var end := offstage(h, h.grip_target)
	var my := h.move_id + 1
	await hand_move(h, end, randf_range(0.5, 0.7), 0.0, 8.0, null, 0.0, 0.0, 0.0)
	if h.move_id == my:
		h.visible = false


## A pebble set down never lands perfectly flat: it rocks a little and comes to rest.
func settle(node: Node3D) -> void:
	var tw := create_tween()
	tweens.append(tw)
	var ax := randf_range(-0.08, 0.08)
	var az := randf_range(-0.08, 0.08)
	var yaw := node.rotation.y
	tw.tween_method(func(t: float) -> void:
		var k := sin(t * TAU * 1.5) * (1.0 - t)
		node.rotation = Vector3(ax * k, yaw, az * k), 0.0, 1.0, 0.45)


## The thrower gathers the dice and casts them. For each die in turn his hand turns to
## line up with it, comes down with thumb and fingers spread round it, and closes until
## the finger pads and the thumb meet its faces; he lifts it and rolls it back into his
## palm, where the curled ring and little fingers keep it, and goes on to the next. Then
## his fingers close round all four until each one meets a die, he rattles them and
## flings them across the tray from his side. The dice are solid all the while (see
## DiceGrip): nothing passes through the hand, the floor or another die, and only the
## hand moves them.
func hand_throw(p: int) -> void:
	var e := epoch
	var h: UrHand = hands[p]
	var txf := tray_xf()
	var c := dice_centroid()
	hand_enter(h, c)
	for b in dice_bodies:
		b.visible = true
	grip.begin(h)
	dice_hand = h
	# 1. pick them up one by one, nearest first
	h.grip_override = UrHand.GRASP_C
	pose_digits(h, h.grasp_level(PICK_OPEN_R, PICK_PITCHES[0]), PINCH_DIGITS)
	var fist := h.pose_dict("fist")
	# the ring and little fingers half curl, out of the way of the tray but leaving the
	# hollow of the hand open for the dice; they close round them as they come
	var cup := h.pose_dict("cup")
	var half := {}
	for b in fist:
		half[b] = (cup[b] as Vector2).lerp(fist[b], 0.45)
	for d in ["ring", "pinky"]:
		grip.drive(d, h.pose_cur.duplicate(), half, 1.5)
	var order := gather_order(h.shoulder)
	for k in order.size():
		var i: int = order[k]
		var plan: Dictionary = await plan_pick(h, i)
		if e != epoch:
			return
		# thumb and fingers spread to come down round it (as for a pebble), never
		# sweeping through a die already in the palm
		for d in PINCH_DIGITS:
			grip.drive(d, h.pose_cur.duplicate(), plan.open, 4.0)
		var at: Vector3 = plan.grip
		if k == 0:
			await hand_move(h, at + Vector3(0, 1.0, 0), randf_range(0.45, 0.6), 0.5, plan.pitch, null, 0.0, plan.yaw)
		else:
			await hand_move(h, at + Vector3(0, 0.6, 0), randf_range(0.3, 0.36), 0.2, plan.pitch, null, 0.0, plan.yaw)
		if e != epoch:
			return
		await hand_move(h, at, randf_range(0.18, 0.24), 0.0, plan.pitch)
		if e != epoch:
			return
		# thumb, index and middle pads close on it and stop as they meet its faces
		for d in PINCH_DIGITS:
			grip.drive(d, h.pose_cur.duplicate(), plan.touch, 6.0)
		h.effort = 0.85
		var t := 0.0
		while t < 0.4 and not grip.closed(PINCH_DIGITS):
			await get_tree().physics_frame
			t += get_physics_process_delta_time()
		if e != epoch:
			return
		for d in PINCH_DIGITS:
			grip.let_go(d)          # the pinch holds as it is
		grip.carry(i)
		play_sfx("stone_lift", at, randf_range(-2.0, 1.0), 0.08)   # a soft lift off the leather
		await get_tree().create_timer(0.06).timeout
		await hand_move(h, at + Vector3(0, 0.4, 0), randf_range(0.18, 0.22), 0.0, plan.pitch - 6.0)
		if e != epoch:
			return
		# the thumb and fingers curl in, carrying it, and set it in the palm, then let go
		# of it there, where the curled ring and little fingers keep it
		grip.pinch_loose(i)
		var tuck := h.grasp_at(POCKET[k], maxf(plan.r - 0.3, 0.5))
		for d in PINCH_DIGITS:
			grip.drive(d, h.pose_cur.duplicate(), tuck, 3.2)
		await get_tree().create_timer(0.38).timeout
		if e != epoch:
			return
		grip.loosen(i, POCKET[k], 500.0)
		h.effort = 0.3 if k > 0 else 0.15   # only the curled fingers keeping them now
		if k > 0:
			# it meets the dice already in his palm: one muffled click (skin damps it)
			play_sfx("die_die", h.grip_world(), randf_range(-17.0, -13.0), 0.1)
	# 2. close the hand round all four, palm down, each finger stopping on a die, and
	# lift the fist off the tray toward his side
	# (first the thumb and fingers ease off the last one and it settles up into the
	# palm, so the fingers close under it)
	for d in PINCH_DIGITS:
		grip.drive(d, h.pose_cur.duplicate(), half, 5.0)
	var w := 0.0
	var last: int = order[order.size() - 1]
	while w < 0.35 and (grip.pos[last] as Vector3).distance_to(grip.anchor[last]) > 0.5:
		await get_tree().physics_frame
		w += get_physics_process_delta_time()
	if e != epoch:
		return
	var now := h.pose_cur.duplicate()
	for d in UrHand.DIGITS:
		grip.drive(d, now, fist, 2.0)
	h.effort = 1.0
	for k in order.size():
		grip.pull[order[k]] = 400.0
	await get_tree().create_timer(0.2).timeout
	if e != epoch:
		return
	var at_grip := h.global_transform * UrHand.PALM_C
	h.grip_override = UrHand.PALM_C      # same hand position, now steered by the palm
	h.grip_target = at_grip
	var near_z := TRAY.end.y - 1.1 if p == HUMAN else TRAY.position.y + 1.1
	var start := txf * Vector3(TRAY.get_center().x + randf_range(-0.4, 0.4), 1.7, near_z)
	await hand_move(h, start, 0.5, 0.25, FIST_PITCH, null, 0.0, 0.0, FIST_ROLL)
	if e != epoch:
		return
	# 3. rattle them in the closed fist: they knock about inside it
	# A real shake is a pump of the forearm toward and away from him, the fist tracing a
	# short tilted arc, the wrist flicking a beat ahead of the arm; it builds over the first
	# stroke and dies away into the cast. A little roll and sideways drift keep it human.
	play_sfx("dice_shake", start)
	var dur := randf_range(0.8, 1.0)
	var hz := randf_range(4.0, 4.6)
	var toward := txf.basis * Vector3(0, 0, 1.0 if p == HUMAN else -1.0)   # back toward him
	var side := Vector3.UP.cross(toward).normalized()
	var amp := randf_range(0.34, 0.42)          # world (~1.6-2 cm each way)
	var drift := randf_range(-1.0, 1.0)
	var sounds := [false]
	var tw := create_tween()
	tweens.append(tw)
	tw.tween_method(func(t: float) -> void:
		var s := t * dur
		var env := smoothstep(0.0, 0.16, s) * (1.0 - smoothstep(dur - 0.22, dur, s))
		var ph := s * TAU * hz
		var pump := sin(ph) * env
		h.shake = (toward * pump * amp + Vector3.UP * (sin(ph - 0.5) * 0.55) * amp * env
			+ side * (sin(ph * 0.5) * 0.12 + drift * 0.05) * amp * env)
		h.aim_pitch = FIST_PITCH + 9.0 * sin(ph + 0.9) * env
		h.aim_roll = FIST_ROLL + 4.0 * sin(ph * 0.5 + 0.3) * env
		if not sounds[0] and s > 0.5:
			sounds[0] = true
			play_sfx("dice_shake", start, -3.0),
		0.0, 1.0, dur)
	await tw.finished
	h.shake = Vector3.ZERO
	h.aim_pitch = FIST_PITCH
	h.aim_roll = FIST_ROLL
	if e != epoch:
		return
	# 4. cast: the fist swings forward and down and opens, the dice drop out of it
	var dir := txf.basis * Vector3(0, 0, -1.0 if p == HUMAN else 1.0)
	hand_move(h, start + dir * 1.0 + Vector3(0, -0.45, 0), 0.24, 0.0, FIST_PITCH + 12.0)
	await get_tree().create_timer(0.1).timeout
	if e != epoch:
		return
	grip.let_go_all()
	h.effort = 0.0
	grip.end()
	dice_hand = null
	throw_dice(dice_centroid(), dir, true)
	h.set_pose("throw")
	h.pose_rate = 22.0
	await get_tree().create_timer(0.3).timeout
	h.pose_rate = 9.0
	hand_leave(h)


const PINCH_DIGITS := ["index", "middle", "thumb"]
const PICK_PITCHES := [36.0, 28.0, 44.0, 52.0, 60.0]   # how steeply the hand may come down on a die
const PICK_OPEN_R := 2.3     # thumb and fingers spread this far (cm, half-width) to come down round one
const PICK_RISE_MAX := 0.8   # the pinch may sit this much (cm) above the die's middle to keep clear of the leather
# Where the gathered dice are drawn while he picks up the rest: under the palm, by the
# heel of the hand and the curled ring and little fingers (hand-local cm)
# (each is set there by thumb and fingers, pressed up against the palm in the hollow
# just behind the knuckles, where the fingers fold round them when the fist closes)
const POCKET := [Vector3(-2.5, -2.1, 8.2), Vector3(-1.0, -2.1, 6.0), Vector3(-0.3, -2.1, 8.4), Vector3(1.9, -2.1, 8.1)]
const FIST_PITCH := 18.0     # the fist held a little knuckles-forward
const FIST_ROLL := 20.0      # and turned a little thumb-up, as a fist naturally is


## Set only these digits of the hand toward a pose (the others keep what they are doing).
func pose_digits(h: UrHand, d: Dictionary, ds: Array) -> void:
	var part := {}
	for name in ds:
		for s in 3:
			var i: int = h.bones["%s_%d" % [name, s]]
			part[i] = d[i]
	h.set_pose_dict(part)


## How to take die i, the way a pebble is taken: the hand turns (no more than ~50
## degrees from where it naturally points, preferring less) so thumb and fingers close
## across the die, tips forward enough that the palm, the spread fingers and the dice
## already in the hand clear the dice beside it, the floor and the rim, and pinches it
## level across its middle. Thumb and finger pads open and close level with the leather,
## and the pinch rises (a little) until no fingertip, knuckle or held die would touch the
## floor or the rim, so the hand comes down onto the die rather than into the tray. The
## pinch is sized to the die's real width along it.
func plan_pick(h: UrHand, i: int) -> Dictionary:
	var X: Transform3D = (dice_bodies[i] as Node3D).global_transform
	var c := X.origin
	var f0 := hand_fwd(h, c)
	f0.y = 0.0
	f0 = f0.normalized()
	var cands: Array = []
	for n in [grip.n0, grip.n1, grip.n2, grip.n3]:
		var nw: Vector3 = X.basis.orthonormalized() * n
		var nh := Vector3(nw.x, 0.0, nw.z)
		if nh.length() < 0.35:
			continue
		nh = nh.normalized()
		for fwd in [-nh, nh]:
			var yaw := rad_to_deg(f0.signed_angle_to(fwd, Vector3.UP))
			if absf(yaw) <= 50.0:
				cands.append(yaw)
	if cands.is_empty():
		cands.append(0.0)
	# the ring and little fingers as they will be: curled round the dice in the palm, or tight
	var rest := h.pose_cur.duplicate()
	if not grip.ctl.has("ring"):
		var fist := h.pose_dict("fist")
		for d in ["ring", "pinky"]:
			for k in 3:
				rest[h.bones["%s_%d" % [d, k]]] = fist[h.bones["%s_%d" % [d, k]]]
	var with_digits := func(pose: Dictionary) -> Dictionary:
		var out := rest.duplicate()
		for d in PINCH_DIGITS:
			for k in 3:
				var bi: int = h.bones["%s_%d" % [d, k]]
				out[bi] = pose[bi]
		return out
	# pinch height: the pads (about a finger's thickness) just clear of the floor
	var gy0 := maxf(c.y, grip.floor_y + 0.95 * UrHand.CM)
	var opts: Array = []
	for yaw in cands:
		for pitch in PICK_PITCHES:
			opts.append([absf(yaw) / 40.0 + maxf(absf(yaw) - 32.0, 0.0) / 10.0 + absf(pitch - 36.0) / 30.0, yaw, pitch])
	opts.sort_custom(func(a: Array, b: Array) -> bool: return a[0] < b[0])
	var best: Array = [opts[0][0], opts[0][1], opts[0][2], gy0]
	var best_s := INF
	var tried := 0
	for o in opts:
		var open: Dictionary = with_digits.call(h.grasp_level(PICK_OPEN_R, o[2]))
		var shut: Dictionary = with_digits.call(h.grasp_level(0.9, o[2]))
		var T := h.xf_at(Vector3(c.x, gy0, c.z), f0, o[2], o[1], UrHand.GRASP_C)
		# rise until neither the open hand nor the closing one would touch the leather
		var up := 0.0
		for pose in [open, shut]:
			var d := grip.solve_push(grip.solid_contacts(T, h, grip.pose_caps(pose), true))
			up = maxf(up, d.y)
		up = minf(up, PICK_RISE_MAX * UrHand.CM)
		T.origin.y += up
		var sc: float = o[0] + up / UrHand.CM * 0.8 + (grip.clash(T, open, [], i) + grip.clash(T, shut, ["index", "middle", "thumb"], i)) * 25.0
		if sc < best_s:
			best_s = sc
			best = [o[0], o[1], o[2], gy0 + up]
		if sc - o[0] - up / UrHand.CM * 0.8 < 0.01 and up < 0.3 * UrHand.CM:
			break
		tried += 1
		if tried % 4 == 0:
			await get_tree().process_frame
	await get_tree().process_frame
	# the die's width along the pinch, through the pinch point: centre the grip on it
	var g := Vector3(c.x, best[3], c.z)
	var T := h.xf_at(g, f0, best[2], best[1], UrHand.GRASP_C)
	var lr := grip.local_under(T, i)
	var dr: Basis = lr[1]
	var o_l: Vector3 = dr.transposed() * (UrHand.GRASP_C - (lr[0] as Vector3))
	var p := deg_to_rad(float(best[2]))
	var zf: Vector3 = dr.transposed() * Vector3(0, sin(p), cos(p))
	var rf := grip.ray_from(o_l, zf)
	var rn := grip.ray_from(o_l, -zf)
	var r := (rf + rn) * 0.5
	g += T.basis.orthonormalized() * Vector3(0, sin(p), cos(p)) * ((rf - rn) * 0.5 * UrHand.CM)
	# close past the die: the pads stop where they meet it
	var touch := h.grasp_level(snappedf(maxf(r - 0.35, 0.5), 0.05), best[2])
	var open := h.grasp_level(PICK_OPEN_R, best[2])
	return {"grip": g, "yaw": best[1], "pitch": best[2], "touch": touch, "open": open, "r": snappedf(r, 0.05)}


func dice_centroid() -> Vector3:
	var c := Vector3.ZERO
	for b in dice_bodies:
		c += (b as Node3D).global_position
	c /= 4.0
	c.y = 0.0
	return c


## A world point pulled inside the tray, `mx` / `mz` (world units) clear of the walls.
func in_tray(q: Vector3, mz: float, mx: float) -> Vector3:
	var txf := tray_xf()
	var l := txf.affine_inverse() * q
	l.x = clampf(l.x, TRAY.position.x + 0.5 + mx, TRAY.end.x - 0.5 - mx)
	l.z = clampf(l.z, TRAY.position.y + mz, TRAY.end.y - mz)
	l.y = q.y
	var w := txf * l
	w.y = q.y if q.y != 0.0 else 0.35
	return w


## Dice in the order a hand gathers them: nearest the player first, then each time
## the one nearest the last.
func gather_order(from: Vector3) -> Array:
	var left := [0, 1, 2, 3]
	var out := []
	var q := from
	while not left.is_empty():
		var best: int = left[0]
		var bd := INF
		for i in left:
			var d := Vector2(q.x, q.z).distance_to(Vector2((dice_bodies[i] as Node3D).global_position.x, (dice_bodies[i] as Node3D).global_position.z))
			if d < bd:
				bd = d
				best = i
		left.erase(best)
		out.append(best)
		q = (dice_bodies[best] as Node3D).global_position
	return out


# ======================================================================
# Geometry helpers
# ======================================================================

func path_cell(p: int, i: int) -> Vector2i:
	var row := 2 if p == HUMAN else 0
	if i <= 4:
		return Vector2i(4 - i, row)
	if i <= 12:
		return Vector2i(i - 5, 1)
	return Vector2i(20 - i, row)


func cell_pos(c: Vector2i) -> Vector3:
	return board_xf() * Vector3(c.x - 3.5, BY, c.y - 1.0)


func home_z(p: int) -> float:
	return (0.1 + HOME_SIZE.y / 2.0) * (1.0 if p == HUMAN else -1.0)


## Yaw that lays a stone's long axis along x (so the rows pack neatly), with a little
## hand-placed wobble, choosing the nearest such angle so it turns as little as possible.
func home_yaw(cur: float, k: int, p: int) -> float:
	var target := sin(k * 5.1 + p * 2.3) * 0.08 + deg_to_rad(PLATE_NUDGE[p].z)
	return target + roundf((cur - target) / PI) * PI


func row_z(p: int) -> float:
	return 1.0 if p == HUMAN else -1.0


func rest(base: Vector3) -> Vector3:
	return base + Vector3(0, PIECE_H / 2.0, 0)


## Surface position where stone idx of player p sits at path position `where`.
## done_k = how many of p's stones are already home (picks its spot on the home plate).
func slot_pos(p: int, where: int, idx: int, done_k: int) -> Vector3:
	if where == 0:
		return strip_xf(p) * Vector3((idx - 3) * 0.95, BY, 0)
	if where >= UrGame.FINISH:
		# 2 columns x 4 rows, filled from the board side outward, loosely placed by hand
		var col := done_k % 2
		var row := done_k / 2
		var s := 1.0 if p == HUMAN else -1.0
		return plate_xf(p) * Vector3((col - 0.5) * 0.82 + sin(done_k * 12.9 + p) * 0.02, BY,
			s * ((row - 1.5) * 0.7 + cos(done_k * 7.3 + p) * 0.015))
	return cell_pos(path_cell(p, where))


func ground_point(pt: Vector2, y := BY) -> Variant:
	var o := cam.project_ray_origin(pt)
	var d := cam.project_ray_normal(pt)
	return Plane(Vector3.UP, y).intersects_ray(o, d)


## Is screen point pt over the drop zone for path position dst?
## While carrying a stone we test at carrying height so its own footprint counts.
func drop_ok(pt: Vector2, dst: int, y := BY) -> bool:
	var g: Variant = ground_point(pt, y)
	if g == null:
		return false
	if dst >= UrGame.FINISH:
		var h: Vector3 = plate_xf(HUMAN).affine_inverse() * (g as Vector3)
		return absf(h.x) < HOME_SIZE.x / 2 + 0.25 and absf(h.z) < HOME_SIZE.y / 2 + 0.25
	var c := cell_pos(path_cell(HUMAN, dst))
	return absf(g.x - c.x) < 0.6 and absf(g.z - c.z) < 0.6


func movable_indices() -> Array:
	var out: Array = []
	if phase != Phase.MOVE:
		return out
	for i in UrGame.PIECES:
		if legal.has(game.pos[HUMAN][i]):
			out.append(i)
	return out


func pick(pt: Vector2, candidates: Array) -> int:
	var best := -1
	var best_d := 48.0
	for i in candidates:
		var wp: Vector3 = pnodes[HUMAN][i].global_position
		if cam.is_position_behind(wp):
			continue
		var d := pt.distance_to(cam.unproject_position(wp))
		if d < best_d:
			best_d = d
			best = i
	return best


# ======================================================================
# Dice physics
# ======================================================================

## Cast the dice from `origin` along `dir` (world). With no arguments, the last throw
## is repeated (used when a die jumps out of the tray).
func throw_dice(origin: Variant = null, dir: Variant = null, keep := false) -> void:
	if origin == null:
		if last_throw.is_empty():
			var txf0 := tray_xf()
			last_throw = [txf0 * Vector3(TRAY.get_center().x, 1.5, TRAY.end.y - 1.1), txf0.basis * Vector3(0, 0, -1)]
		origin = last_throw[0]
		dir = last_throw[1]
	last_throw = [origin, dir]
	var o: Vector3 = origin
	var d: Vector3 = (dir as Vector3).normalized()
	var side := Vector3.UP.cross(d).normalized()
	roll = -1
	rolling = true
	throw_time = 0.0
	still_time = 0.0
	for i in 4:
		die_cool[i] = 0.08
	for i in 4:
		var b: RigidBody3D = dice_bodies[i]
		b.freeze = false
		b.sleeping = false
		b.linear_velocity = Vector3.ZERO
		b.angular_velocity = Vector3.ZERO
		# out of the opening hand, a little spread, kept inside the tray walls
		var txf := tray_xf()
		var lp := txf.affine_inverse() * (b.global_position if keep else o + side * randf_range(-0.45, 0.45) + d * randf_range(-0.2, 0.25) + Vector3(0, randf_range(-0.1, 0.15), 0))
		lp.x = clampf(lp.x, TRAY.position.x + 0.55, TRAY.end.x - 0.55)
		lp.z = clampf(lp.z, TRAY.position.y + 0.55, TRAY.end.y - 0.55)
		lp.y = maxf(lp.y, 0.75)
		b.global_position = txf * lp
		if not keep:
			b.rotation = Vector3(randf() * TAU, randf() * TAU, randf() * TAU)
		# (out of an opening fist they drop forward and down)
		var vy := randf_range(-1.2, 0.2) if keep else randf_range(-1.5, 0.8)
		b.linear_velocity = d * randf_range(5.0, 8.0) + side * randf_range(-1.6, 1.6) + Vector3(0, vy, 0)
		b.angular_velocity = Vector3(randf_range(-12, 12), randf_range(-12, 12), randf_range(-12, 12))
		b.visible = true
		die_prev_v[i] = b.linear_velocity
		die_prev_w[i] = b.angular_velocity


## Index (0..3) of the tetrahedron corner currently pointing up, and how upright it is.
func top_vertex(b: RigidBody3D) -> Dictionary:
	var best := 0
	var best_y := -INF
	var second_y := -INF
	for k in 4:
		var wy := (b.global_transform * (die_verts[k] as Vector3)).y
		if wy > best_y:
			second_y = best_y
			best_y = wy
			best = k
		elif wy > second_y:
			second_y = wy
	var up_dir := ((b.global_transform.basis * (die_verts[best] as Vector3))).normalized()
	# lead = how far the top corner stands above the next one (0 = a tie, the top could still change)
	return {"index": best, "upright": up_dir.dot(Vector3.UP), "lead": best_y - second_y}


## Once the throw is effectively over, a die that is only creeping (sliding off the rim
## or another die, rocking slowly) is stopped and read as it lies, so nobody waits for it.
## A die still tumbling fast, or with two corners nearly level (the top could still
## change), is left alone to finish.
func call_creeping_dice() -> void:
	for b in dice_bodies:
		if b.freeze:
			continue
		var lin: float = b.linear_velocity.length()
		var ang: float = b.angular_velocity.length()
		if lin > 1.2 or ang > 3.0:
			continue
		# only a die lying on something: never one caught at the slow top of a bounce
		if b.get_colliding_bodies().is_empty() or absf(b.linear_velocity.y) > 0.5:
			continue
		if top_vertex(b).lead < DIE_R * 0.15:
			continue
		b.linear_velocity = Vector3.ZERO
		b.angular_velocity = Vector3.ZERO
		# freeze where it lies: a kinematic freeze would otherwise snap the die back to the
		# last place a hand carried it
		var xf: Transform3D = b.global_transform
		b.freeze = true
		b.global_transform = xf


func _physics_process(delta: float) -> void:
	if grip.active():
		grip.step(delta)
		# dice knocking together in his hand (the rattle itself has its own sound)
		hand_knock_cool -= delta
		if grip.knock > 22.0 and hand_knock_cool <= 0.0 and dice_hand and dice_hand.shake == Vector3.ZERO:
			hand_knock_cool = 0.12
			play_sfx("die_die", dice_hand.grip_world(), clampf(-20.0 + grip.knock * 0.12, -20.0, -9.0), 0.12)
	dice_sounds(delta)
	if not rolling:
		return
	throw_time += delta
	if throw_time > DICE_CALL_TIME:
		call_creeping_dice()
	var still := true
	for b in dice_bodies:
		if b.freeze:
			continue
		if b.linear_velocity.length() > 0.08 or b.angular_velocity.length() > 0.25:
			still = false
	# wait until the dice have stayed put for a moment, so a wobbling die is not read mid-wobble
	still_time = still_time + delta if still else 0.0
	var timed_out := throw_time > 8.0
	if not (still_time > 0.2 and throw_time > 0.7) and not timed_out:
		return
	# everything has stopped. Dice are read exactly as they lie: one leaning on the rim
	# or on another die counts whichever corner is highest, just as players would read it.
	var inner := TRAY.grow(0.3)
	for i in 4:
		var b: RigidBody3D = dice_bodies[i]
		var gp := b.global_position
		if not inner.has_point(tray_local(gp)) or gp.y < -0.5 or gp.y > 1.5:
			throw_dice() # a die left the tray: throw everything again
			return
		dice_result[i] = 1 if top_vertex(b).index < 2 else 0
	rolling = false
	dice_settled.emit()


# ======================================================================
# Sound
# ======================================================================

func build_audio() -> void:
	for name in SFX_DB:
		var arr: Array = []
		for v in 8:
			var path := "res://assets/sfx/%s_%d.wav" % [name, v]
			if ResourceLoader.exists(path):
				arr.append(load(path))
		sfx[name] = arr
	for i in 20:
		var p := AudioStreamPlayer3D.new()
		p.attenuation_model = AudioStreamPlayer3D.ATTENUATION_DISABLED
		p.attenuation_filter_db = 0.0
		p.panning_strength = 0.6
		add_child(p)
		sfx_pool.append(p)


## Play a random variant of a sound at a world position.
func play_sfx(name: String, at: Vector3, vol_db := 0.0, pitch_var := 0.05) -> void:
	var arr: Array = sfx.get(name, [])
	if arr.is_empty():
		return
	var p: AudioStreamPlayer3D = sfx_pool[sfx_next]
	sfx_next = (sfx_next + 1) % sfx_pool.size()
	p.stream = arr[randi() % arr.size()]
	p.position = at
	p.volume_db = SFX_DB[name] + vol_db
	p.pitch_scale = randf_range(1.0 - pitch_var, 1.0 + pitch_var)
	p.play()


## Detect dice impacts from sudden velocity changes (beyond gravity) and play the
## sound of whatever was struck: the other dice, the wooden rim, or the leather floor.
func dice_sounds(delta: float) -> void:
	var g := Vector3(0, -float(ProjectSettings.get_setting("physics/3d/default_gravity")), 0)
	for i in 4:
		var b: RigidBody3D = dice_bodies[i]
		var v := b.linear_velocity
		var w := b.angular_velocity
		var dv: Vector3 = v - die_prev_v[i] - g * delta
		var spin_hit: float = (w - die_prev_w[i]).length() * DIE_R * 0.3
		# a die simply lying on the floor feels g*dt every step: that is not a hit
		var resting: bool = v.length() < 0.3 and (die_prev_v[i] as Vector3).length() < 0.3
		die_prev_v[i] = v
		die_prev_w[i] = w
		die_cool[i] -= delta
		# while a hand is gathering the dice they are frozen and moved by it: Godot reports
		# that as velocity, but nothing has struck them (the hand's own clicks cover it)
		if grip.active() or b.freeze:
			continue
		var hit := maxf(dv.length(), spin_hit)
		if hit < 1.4 or resting or die_cool[i] > 0.0 or not b.visible:
			continue
		var kind := ""
		for other in b.get_colliding_bodies():
			var j := dice_bodies.find(other)
			if j != -1:
				kind = "die_die"
				die_cool[j] = 0.06 # one click per collision, not one per die
				break
			if other in tray_walls:
				kind = "die_wall"
		if kind == "":
			# contact already broken this step: judge by position and direction of the kick
			var gp := tray_local(b.global_position)
			var near_wall := gp.x < TRAY.position.x + 0.6 or gp.x > TRAY.end.x - 0.6 \
				or gp.y < TRAY.position.y + 0.6 or gp.y > TRAY.end.y - 0.6
			var sideways := Vector2(dv.x, dv.z).length() > absf(dv.y)
			kind = "die_wall" if near_wall and sideways else "die_floor"
		var strength := clampf(hit / 11.0, 0.03, 1.0)
		play_sfx(kind, b.global_position, linear_to_db(strength), 0.07)
		die_cool[i] = 0.045


# ======================================================================
# Input and per-frame visuals
# ======================================================================

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseMotion:
		mouse_pos = event.position
		if dragging:
			_carry(mouse_pos)
	elif event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		mouse_pos = event.position
		if event.pressed:
			_on_press(event.position)
		else:
			_on_release(event.position)


func _carry(pt: Vector2) -> void:
	var g: Variant = ground_point(pt, BY + LIFT)
	if g != null:
		drag_target = Vector3(g.x, BY + LIFT, g.z)
		# the stone stays in his fingers: it goes no further than his arm can reach, leaning
		# only as much as the furthest square takes (~3 cm), so it stops just past the board
		var h: UrHand = hands[HUMAN]
		drag_target = h.reachable(drag_target, hand_fwd(h, drag_target), 26.0, 0.0, DRAG_LEAN_CM)


## The human's hand reaches in and takes the stone they pressed on; once it is in his
## fingers it follows the mouse (see _process).
func human_grab(idx: int) -> void:
	var e := epoch
	var h: UrHand = hands[HUMAN]
	var node: Node3D = pnodes[HUMAN][idx]
	await hand_take(h, node, true)
	if e != epoch or sel_idx != idx or phase != Phase.MOVE:
		return
	human_holding = true
	if release_pending != null:
		var pt: Vector2 = release_pending
		release_pending = null
		_release_held(pt)


func _on_press(pt: Vector2) -> void:
	if phase == Phase.ROLL:
		if _over_tray(pt):
			_on_roll_pressed()
		return
	if phase != Phase.MOVE:
		return
	if sel_idx != -1 and drop_ok(pt, game.pos[HUMAN][sel_idx] + roll):
		perform_move(sel_idx) # click-to-place
		return
	var hit := pick(pt, movable_indices())
	if hit != -1 and not human_holding:
		sel_idx = hit
		dragging = true
		release_pending = null
		press_pos = pt
		_carry(pt)
		human_grab(hit)
	else:
		sel_idx = -1


func _on_release(pt: Vector2) -> void:
	if not dragging:
		return
	dragging = false
	if not human_holding:
		release_pending = pt   # the hand is still reaching for it
		return
	_release_held(pt)


func _release_held(pt: Vector2) -> void:
	var src: int = game.pos[HUMAN][sel_idx]
	if drop_ok(pt, src + roll, BY + LIFT):
		perform_move(sel_idx)
		return
	# not dropped on a target: the hand puts the stone back where it came from
	human_holding = false
	var idx := sel_idx
	if pt.distance_to(press_pos) > 12.0:
		sel_idx = -1   # a click (no drag) keeps it selected for click-to-place
	var h: UrHand = hands[HUMAN]
	var node: Node3D = pnodes[HUMAN][idx]
	await hand_move(h, rest(slot_pos(HUMAN, src, idx, 0)), 0.22, 0.0, 30.0, node)
	await hand_let_go(h, node, "stone_place")
	hand_leave(h)


func _process(delta: float) -> void:
	update_clouds(delta)
	watch_flies(delta)
	if dragging and human_holding and sel_idx != -1:
		# the stone in the human's fingers follows the mouse, with a hand's slight lag
		var node: Node3D = pnodes[HUMAN][sel_idx]
		node.position = node.position.lerp(drag_target, 1.0 - exp(-16.0 * delta))
		var h: UrHand = hands[HUMAN]
		h.move_id += 1
		h.place(node.position, hand_fwd(h, node.position), 26.0)
	var mov := movable_indices()
	var hover := -1
	if dragging:
		hover = sel_idx
	elif phase == Phase.MOVE:
		hover = pick(mouse_pos, mov)
	var want_hand := hover != -1 or (phase == Phase.ROLL and _over_tray(mouse_pos))
	Input.set_default_cursor_shape(Input.CURSOR_POINTING_HAND if want_hand else Input.CURSOR_ARROW)


func _over_tray(pt: Vector2) -> bool:
	var g: Variant = ground_point(pt)
	return g != null and TRAY.has_point(tray_local(g))
