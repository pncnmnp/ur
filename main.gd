	env.fog_density = 0.004
	env.fog_sky_affect = 0.0
	world_env = env
	var we := WorldEnvironment.new()
	we.environment = env
	add_child(we)

	# low, warm late-afternoon sun from the front left: long shadows rake across
	# the grain, the carving, the leather and the sand ripples
	sun = DirectionalLight3D.new()
	sun.rotation_degrees = Vector3(-24, -66, 0)
	sun.light_color = Color(1.0, 0.8, 0.58)
	sun.light_energy = SUN_ENERGY
	sun.light_angular_distance = SUN_ANGLE
	sun.shadow_enabled = true
	sun.shadow_blur = 1.2
	sun.shadow_normal_bias = 1.2
	sun.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_4_SPLITS
	sun.directional_shadow_max_distance = 30.0
	add_child(sun)
	build_clouds()

	cam = Camera3D.new()
	cam.fov = 43
	cam.position = Vector3(-1.75, 10.5, 7.2)
	add_child(cam)
	cam.look_at(Vector3(-1.75, 0, 0.5), Vector3.UP)
	cam.current = true


## Passing clouds, at true scale. A real cloud shadow is hundreds of metres across,
## thousands of times the size of this table, so the whole scene falls into shade at
## once: the light fades over a few seconds as the cloud's soft edge arrives, stays
## dim for a while, then fades back. The afternoon is mostly clear: long sunny spells,
## then a cloud now and then. Under a cloud the direct sun drops but the sky light
## stays (and even lifts a little as the cloud scatters light), so shadows go soft and
## faint rather than everything just getting darker.
const SUN_ENERGY := 2.3
const SUN_ANGLE := 0.6          # sun's angular size (degrees): crisp shadows in clear sun
const SKY_ENERGY := 0.32
const CLOUD_SUN := 0.24         # fraction of direct sun that gets through a cloud
const CLOUD_EDGE_TIME := 4.0    # seconds for a cloud's edge to pass over the table
var sun: DirectionalLight3D
var world_env: Environment
var cloud_cover := 0.0          # 0 = clear sun, 1 = under a cloud
var cloud_from := 0.0
var cloud_to := 0.0
var cloud_t := 0.0              # seconds into the current fade
var cloud_wait := 0.0           # seconds until the next change
var cloud_thick := 1.0


func build_clouds() -> void:
	cloud_wait = randf_range(45.0, 100.0) # always start in sunshine
	cloud_t = CLOUD_EDGE_TIME               # no fade in progress
	apply_cloud(0.0)


func update_clouds(delta: float) -> void:
	if cloud_t < CLOUD_EDGE_TIME:
		cloud_t += delta
		var k := smoothstep(0.0, 1.0, minf(cloud_t / CLOUD_EDGE_TIME, 1.0))
		cloud_cover = lerpf(cloud_from, cloud_to, k)
	else:
		cloud_wait -= delta
		if cloud_wait <= 0.0:
			cloud_from = cloud_cover
			if cloud_to > 0.0:
				cloud_to = 0.0                                   # cloud moves off
				cloud_wait = randf_range(60.0, 150.0)            # clear spell
			else:
				cloud_thick = randf_range(0.75, 1.0)             # some clouds are thinner
				cloud_to = cloud_thick                           # cloud comes over
				cloud_wait = randf_range(20.0, 60.0)             # time in shade
			cloud_t = 0.0
	# a cloud is never perfectly even: its thickness drifts a little while it passes
	var wobble := 1.0 - 0.12 * cloud_cover * (0.5 + 0.5 * sin(Time.get_ticks_msec() * 0.00031))
	apply_cloud(clampf(cloud_cover * wobble, 0.0, 1.0))


func apply_cloud(c: float) -> void:
	sun.light_energy = SUN_ENERGY * lerpf(1.0, CLOUD_SUN, c)
	sun.light_angular_distance = lerpf(SUN_ANGLE, 6.0, c)     # diffuse light: soft shadows
	world_env.ambient_light_energy = SKY_ENERGY * lerpf(1.0, 1.35, c)


func build_board() -> void:
	# table: collision floor for the dice (top surface at y = 0) + dark wood top
	var table := StaticBody3D.new()
	var tcol := CollisionShape3D.new()
	var tshape := BoxShape3D.new()
	tshape.size = Vector3(60, 1, 40)
	tcol.shape = tshape
	table.add_child(tcol)
	table.position = Vector3(0, -0.5, 0)
	var pm := PhysicsMaterial.new()
	pm.friction = 0.9
	pm.bounce = 0.02
	table.physics_material_override = pm
	add_child(table)
	build_sand()

	var slab_mat := wood_mat(Color(0.75, 0.62, 0.5), 0.45)
	# the carved board, the reserve strips (near = human, far = AI) and the home plates
	add_slab(Vector2(8.5, 3.5), board_xf(), slab_mat, panel_mat("board"), "board")
	for p in 2:
