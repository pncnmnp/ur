const DIE_R := 0.30         # distance from die centre to a corner (four fit inside a closed fist)
const DIE_LOOK_R := 0.52    # size the die's markings were drawn for (the shader is scaled to it)
const DIE_K := 14.0         # sharpness of the rounded tetrahedron
const DIE_H := 0.4
const DIE_GRIP_R := 1.45     # half-width of a die across the fingertips (cm)
# Hand-placed layout: nothing sits perfectly square. Each piece gets a small twist
# (degrees) and nudge, the way people actually set things down on the sand.
const BOARD_YAW := -0.6
const STRIP_PLACE := [Vector3(-0.43, 2.43, 1.8), Vector3(-0.59, -2.44, -1.3)]   # [HUMAN, AI]: x, z, yaw
const PLATE_NUDGE := [Vector3(0.05, 0.04, -2.8), Vector3(0.02, -0.05, 2.2)]    # dx, dz, yaw
