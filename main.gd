# ======================================================================
# Materials and meshes
# ======================================================================

func tex(path: String) -> ImageTexture:
	if tex_cache.has(path):
		return tex_cache[path]
	var img: Image = (load(path) as Texture2D).get_image()
	if img.is_compressed():
		img.decompress()
	img.generate_mipmaps()
	var t := ImageTexture.create_from_image(img)
	tex_cache[path] = t
	return t


func base_mat(color: Color, rough := 0.7) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = color
	m.roughness = rough
	return m


## Wood with triplanar mapping (works on any box), tinted and scaled.
func wood_mat(tint: Color, scale: float, nrm := 1.0) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_texture = tex("res://assets/wood_albedo.png")
	m.albedo_color = tint
	m.normal_enabled = true
	m.normal_texture = tex("res://assets/wood_normal.png")
	m.normal_scale = nrm
	m.roughness = 1.0
	m.roughness_texture = tex("res://assets/wood_rough.png")
	m.uv1_triplanar = true
	m.uv1_scale = Vector3(scale, scale, scale)
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	return m


## A carved panel texture set (name_albedo / name_normal / name_rough).
func panel_mat(prefix: String) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_texture = tex("res://assets/%s_albedo.png" % prefix)
	m.normal_enabled = true
	m.normal_texture = tex("res://assets/%s_normal.png" % prefix)
	m.normal_scale = 1.4
	m.roughness = 1.0
	m.roughness_texture = tex("res://assets/%s_rough.png" % prefix)
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	return m


func stone_mat(white: bool) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_texture = tex("res://assets/stone_white_albedo.png" if white else "res://assets/stone_black_albedo.png")
	m.normal_enabled = true
	m.normal_texture = tex("res://assets/stone_normal.png")
	m.normal_scale = 1.0
	m.albedo_color = Color(0.9, 0.89, 0.86) if white else Color(1, 1, 1)
	m.roughness = 1.0 if white else 0.85  # scaled by the dirt/dust roughness map
	m.roughness_texture = tex("res://assets/stone_rough.png")
	m.uv1_triplanar = true
	m.uv1_scale = Vector3(1.9, 1.9, 1.9)
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	return m


func add_plane(size: Vector2, at: Vector3, m: Material, yaw := 0.0, parent: Node = self) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	var pm := PlaneMesh.new()
	pm.size = size
	mi.mesh = pm
	mi.material_override = m
	mi.position = at
	mi.rotation_degrees.y = yaw
	parent.add_child(mi)
	return mi


## A wooden slab with a carved panel on top, placed by a layout transform: the slab
## has worn, rounded edges; the panel covers only its flat top.
func add_slab(size: Vector2, xf: Transform3D, slab_mat: Material, panel: Material, yaw := 0.0) -> void:
	var root := Node3D.new()
	root.transform = xf
	add_child(root)
	var slab := MeshInstance3D.new()
	slab.mesh = rounded_box(Vector3(size.x, 0.14, size.y), SLAB_R)
	slab.material_override = slab_mat
	slab.position = Vector3(0, BY - 0.072, 0)
	root.add_child(slab)
	add_plane(size - Vector2(2, 2) * SLAB_R, Vector3(0, BY, 0), panel, yaw, root)


func place_xf(x: float, z: float, yaw_deg: float) -> Transform3D:
	return Transform3D(Basis(Vector3.UP, deg_to_rad(yaw_deg)), Vector3(x, 0, z))


func board_xf() -> Transform3D:
	return place_xf(0, 0, BOARD_YAW)


func strip_xf(p: int) -> Transform3D:
	var v: Vector3 = STRIP_PLACE[p]
	return place_xf(v.x, v.y, v.z)


func plate_xf(p: int) -> Transform3D:
	var v: Vector3 = PLATE_NUDGE[p]
	return place_xf(HOME_X + v.x, home_z(p) + v.y, v.z)


## Maps the square, unrotated tray layout (TRAY) to where the tray actually lies.
func tray_xf() -> Transform3D:
	var c := Vector3(TRAY.get_center().x, 0, TRAY.get_center().y)
	return place_xf(c.x + TRAY_NUDGE.x, c.z + TRAY_NUDGE.y, TRAY_NUDGE.z) * Transform3D(Basis(), -c)


## A world point in the tray's own (unrotated) layout, as (x, z) - compare with TRAY.
func tray_local(p: Vector3) -> Vector2:
	var q := tray_xf().affine_inverse() * p
	return Vector2(q.x, q.z)


## UV-sphere style mesh; point_fn maps a unit direction to a surface point.
## The two poles are welded to single vertices so smooth normals have no seam.
func grid_mesh(point_fn: Callable, rows: int, cols: int) -> ArrayMesh:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	st.add_vertex(point_fn.call(Vector3.UP))
	for i in range(1, rows):
		var th := PI * i / rows
		for j in cols:
			var ph := TAU * j / cols
			st.add_vertex(point_fn.call(Vector3(sin(th) * cos(ph), cos(th), sin(th) * sin(ph))))
	st.add_vertex(point_fn.call(Vector3.DOWN))
	var bottom := 1 + (rows - 1) * cols
	for j in cols:
		var j2 := (j + 1) % cols
		# top fan
		st.add_index(0)
		st.add_index(1 + j)
		st.add_index(1 + j2)
		# bottom fan
		var base := 1 + (rows - 2) * cols
		st.add_index(base + j)
		st.add_index(bottom)
		st.add_index(base + j2)
	for i in range(1, rows - 1):
		for j in cols:
			var j2 := (j + 1) % cols
			var a := 1 + (i - 1) * cols + j
			var b := 1 + (i - 1) * cols + j2
			var c := 1 + i * cols + j
			var d := 1 + i * cols + j2
			st.add_index(a)
			st.add_index(c)
			st.add_index(b)
			st.add_index(b)
			st.add_index(c)
			st.add_index(d)
	st.generate_normals()
	return st.commit()


## Box with rounded edges and corners (radius r), centred on the origin.
## Vertices bunch up around the edges so the rounding stays smooth.
func rounded_box(size: Vector3, r: float, seg := 5, step := 0.25) -> ArrayMesh:
	var h := size / 2.0
	var inner := h - Vector3(r, r, r)
	var coords: Array = []
	for a in 3:
		var iv: float = inner[a]
		var c: Array = []
		for k in range(seg, 0, -1):
			c.append(-(iv + r * tan(PI / 4.0 * k / seg)))
		var mids := maxi(1, int(ceil(iv * 2.0 / step)))
		for k in mids + 1:
			c.append(-iv + 2.0 * iv * k / mids)
		for k in range(1, seg + 1):
			c.append(iv + r * tan(PI / 4.0 * k / seg))
		coords.append(c)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var base := 0
	for a in 3:
		var b := (a + 1) % 3
		var c := (a + 2) % 3
		for sgn in [-1.0, 1.0]:
			var cb: Array = coords[b]
			var cc: Array = coords[c]
			var face_n := Vector3.ZERO
			face_n[a] = sgn
			for u in cb:
				for v in cc:
					var q := Vector3.ZERO
					q[a] = sgn * h[a]
					q[b] = u
					q[c] = v
					var cl := q.clamp(-inner, inner)
					var n := (q - cl).normalized()
					var p := cl + n * r
					st.set_normal(n)
					st.set_uv(Vector2(p[b], p[c]))
					st.add_vertex(p)
			var nv := cc.size()
			for i in cb.size() - 1:
				for j in nv - 1:
					var i0 := base + i * nv + j
					var quad := [i0, i0 + nv, i0 + 1, i0 + 1, i0 + nv, i0 + nv + 1]
					# Godot front faces wind clockwise seen from outside
					var tri_n := _axis_vec(b, 1.0).cross(_axis_vec(c, 1.0))
					if tri_n.dot(face_n) > 0.0:
						quad = [i0, i0 + 1, i0 + nv, i0 + 1, i0 + nv + 1, i0 + nv]
					for idx in quad:
						st.add_index(idx)
			base += cb.size() * nv
	st.generate_tangents()
	return st.commit()


func _axis_vec(a: int, s: float) -> Vector3:
	var v := Vector3.ZERO
	v[a] = s
	return v


## A natural pebble: a flattened egg-shaped superellipsoid, chipped by a few flat
## facets, with a flat underside. Each seed gives a different stone.
func make_stone(seed_v: int) -> ArrayMesh:
	var noise := FastNoiseLite.new()
	noise.seed = seed_v
	noise.noise_type = FastNoiseLite.TYPE_SIMPLEX
	noise.frequency = 1.0
	var rng := RandomNumberGenerator.new()
	rng.seed = seed_v
	var a := PIECE_R * rng.randf_range(1.0, 1.12)
	var c := PIECE_R * rng.randf_range(0.76, 0.92)
	var b := 0.195
	var n := rng.randf_range(2.2, 2.7)
	var egg := rng.randf_range(-0.16, 0.16)
	var tilt := rng.randf_range(-0.04, 0.04)
	var off := Vector3(rng.randf() * 20, rng.randf() * 20, rng.randf() * 20)
	var hb := 0.065
	var cuts: Array = []
	for i in rng.randi_range(3, 5):
		var cn := Vector3(rng.randf_range(-1, 1), rng.randf_range(-0.1, 0.9), rng.randf_range(-1, 1)).normalized()
		var support := Vector3(a * cn.x, b * cn.y, c * cn.z).length()
		cuts.append([cn, support * rng.randf_range(0.74, 0.9)])
	var fn := func(dir: Vector3) -> Vector3:
		var q := pow(absf(dir.x) / a, n) + pow(absf(dir.y) / b, n) + pow(absf(dir.z) / c, n)
		var p := dir / pow(q, 1.0 / n)
		p.x *= 1.0 + egg * p.z / c
		p.y += tilt * p.x / a
		p *= 1.0 + 0.04 * noise.get_noise_3dv(dir * 1.3 + off)
		for cut in cuts:
			var dist: float = p.dot(cut[0]) - cut[1]
			if dist > 0.0:
				p -= (cut[0] as Vector3) * dist
		p.y = maxf(p.y, -hb)
		p.y += hb - PIECE_H / 2.0 # flat underside sits exactly on the surface
		return p
	return grid_mesh(fn, 40, 72)


func die_sdf(p: Vector3, nrm: Array) -> float:
	var s := 0.0
	for n in nrm:
		s += exp(DIE_K * ((n as Vector3).dot(p) - DIE_H))
	return log(s) / DIE_K


func die_radius(d: Vector3, nrm: Array) -> float:
	var lo := 0.05
	var hi := 2.0
	for it in 18:
		var mid := (lo + hi) * 0.5
		if die_sdf(d * mid, nrm) < 0.0:
			lo = mid
		else:
			hi = mid
	return (lo + hi) * 0.5


