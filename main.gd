const DIE_SHADER := """
shader_type spatial;
// Ivory tetrahedron die. Engravings are computed per pixel from the direction to each
// corner, so they stay crisp at any mesh resolution. Corners 0 and 1 are the marked ones.
varying vec3 lp;
const vec3 C[4] = vec3[4](
	vec3(0.57735, 0.57735, 0.57735), vec3(0.57735, -0.57735, -0.57735),
	vec3(-0.57735, 0.57735, -0.57735), vec3(-0.57735, -0.57735, 0.57735));

uniform float look_scale = 1.0;
void vertex() { lp = VERTEX * look_scale; }

float hash(vec3 p) {
	p = fract(p * 0.3183099 + 0.1);
	p *= 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}
float vnoise(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(hash(i), hash(i + vec3(1, 0, 0)), f.x), mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x), f.y),
		mix(mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x), mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}
float band(float t, float a, float b, float s) {
	return smoothstep(a - s, a, t) * (1.0 - smoothstep(b, b + s, t));
}

uniform float seed = 0.0;

void fragment() {
	vec3 d = normalize(lp);
	vec3 q = lp + vec3(seed * 7.13, seed * 3.71, seed * 5.29);
	// old bone: yellowed, blotchy brown stains, grain streaks
	vec3 col = vec3(0.6, 0.5, 0.34);
	float g = vnoise(q * 10.0) * 0.6 + vnoise(q * 34.0) * 0.4;
	col *= 0.86 + 0.18 * g;
	float stain = smoothstep(0.35, 0.7, vnoise(q * 6.5 + 9.0) * 0.7 + vnoise(q * 17.0) * 0.3);
	col = mix(col, vec3(0.38, 0.25, 0.13), stain * 0.75);
	float vein = 1.0 - smoothstep(0.0, 0.05, abs(vnoise(q * vec3(4.5, 14.0, 4.5) + 3.0) - 0.5));
	col = mix(col, col * vec3(0.78, 0.66, 0.48), vein * 0.45);
	// crazing: a fine network of age cracks
	float cz = (1.0 - smoothstep(0.0, 0.025, abs(vnoise(q * 16.0 + 1.7) - 0.5)))
		* smoothstep(0.35, 0.65, vnoise(q * 4.0 + 5.0));
	// scratches from centuries of throwing
	float sc = (1.0 - smoothstep(0.0, 0.018, abs(vnoise(q * vec3(80.0, 3.0, 3.0)) - 0.5))) * step(0.72, vnoise(q * 6.0 + 2.0))
		+ (1.0 - smoothstep(0.0, 0.018, abs(vnoise(q.zxy * vec3(70.0, 3.0, 4.0) + 4.0) - 0.5))) * step(0.75, vnoise(q * 5.0 + 8.0));
	// edges and corners (directions along the axes for this tetrahedron) are rubbed smooth and pale
	// on an edge the two largest face-normal dot products are nearly equal
	float s1 = -2.0;
	float s2 = -2.0;
	for (int k = 0; k < 4; k++) {
		float s = dot(d, -C[k]);
		if (s > s1) { s2 = s1; s1 = s; } else if (s > s2) { s2 = s; }
	}
	float edge = 1.0 - smoothstep(0.0, 0.16, s1 - s2);
	col = mix(col * (1.0 - 0.45 * cz) * (1.0 - 0.2 * sc), col * 1.06, edge * 0.5);
	// handling grime settles into the flat faces
	col *= 1.0 - 0.12 * (1.0 - edge) * vnoise(q * 7.0 + 13.0);

	float h = 0.0;
	float groove = 0.0;
	float inlay_amt = 0.0;
	for (int k = 0; k < 4; k++) {
		float marked = 1.0 - step(1.5, float(k));
		float th = acos(clamp(dot(d, C[k]), -1.0, 1.0));
		float thf = acos(clamp(dot(d, -C[k]), -1.0, 1.0));
		float w = fwidth(th) * 0.8 + 0.003;
		// corner: marked corners get a lapis inlay inside two engraved rings
		float inlay = (1.0 - smoothstep(0.17 - w, 0.17 + w, th)) * marked;
		float r1 = band(th, 0.215, 0.245, w) * marked + band(th, 0.19, 0.22, w) * (1.0 - marked);
		float r2 = band(th, 0.30, 0.322, w) * marked;
		float pit = (1.0 - smoothstep(0.05 - w, 0.05 + w, th)) * (1.0 - marked);
		// face: engraved circle with a centre dot
		float fr = band(thf, 0.47, 0.50, w);
		float fd = 1.0 - smoothstep(0.035 - w, 0.035 + w, thf);
		float gr = max(max(r1, r2), max(max(fr, fd), pit));
		// worn lapis inlay: faded, with chips missing that show the dark socket
		float chip = step(0.62, vnoise(q * 26.0 + float(k) * 3.0));
		vec3 lapis = mix(vec3(0.05, 0.09, 0.3), vec3(0.13, 0.16, 0.3), vnoise(q * 40.0)) * (0.8 + 0.3 * g);
		col = mix(col, mix(lapis, vec3(0.14, 0.09, 0.05), chip), inlay);
		// engravings packed with dark grime, the outer ring with traces of old red pigment
		col = mix(col, vec3(0.32, 0.13, 0.08), r2 * 0.7);
		col = mix(col, vec3(0.16, 0.1, 0.05), gr * (1.0 - r2 * 0.7));
		h -= inlay * (0.008 + chip * 0.006) + gr * 0.014;
		groove = max(groove, gr);
		inlay_amt = max(inlay_amt, inlay * (1.0 - chip));
	}
	h -= cz * 0.004 + sc * 0.003;
	ALBEDO = col;
	ROUGHNESS = clamp(0.62 + groove * 0.3 + cz * 0.15 - inlay_amt * 0.15 - edge * 0.25, 0.2, 1.0);
	SPECULAR = 0.3;

	// bump from the engraving height via screen-space derivatives
	vec3 dpdx = dFdx(VERTEX);
	vec3 dpdy = dFdy(VERTEX);
	vec3 r1v = cross(dpdy, NORMAL);
	vec3 r2v = cross(NORMAL, dpdx);
	float det = dot(dpdx, r1v);
	vec3 grad = sign(det) * (dFdx(h) * r1v + dFdy(h) * r2v);
	NORMAL = normalize(abs(det) * NORMAL - grad);
}
"""

const SAND_SHADER := """
shader_type spatial;
// Desert sand the board rests on (rects = centre.xz, half-size.xz, rect_cs = cos/sin of
// each one's yaw, rect_top = height of each object's top; a round object has w < 0 and
// its radius in z). Nothing just sits on sand: the
// wind banks it up against every edge, in uneven drifts that are deeper and run further
// out on the side facing the wind, and scours a shallow hollow in the lee. Where the
// drifted sand meets the wood or clay there is a dark crease, and the drift itself is
// smooth, fine sand, the ripples blown out of it. Further away the sand rolls into low dunes.
uniform sampler2D alb_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D nrm_tex : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec4 rects[8];
uniform vec2 rect_cs[8];
uniform float rect_top[8];   // world height of each object's top
uniform int rect_count = 0;
uniform float tile = 4.0;
uniform vec2 wind = vec2(0.94, 0.34);   // the way the wind blows (xz, unit)
varying vec3 wp;
varying float drift;         // how much of this sand is drifted against something (0..1)

float hash2(vec2 p) {
	p = fract(p * vec2(123.34, 456.21));
	p += dot(p, p + 45.32);
	return fract(p.x * p.y);
}
float vnoise2(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash2(i), hash2(i + vec2(1, 0)), f.x), mix(hash2(i + vec2(0, 1)), hash2(i + vec2(1, 1)), f.x), f.y);
}
// nearest object: (distance, outward normal of its nearest side xz, its top height)
vec4 nearest(vec2 p) {
	vec4 best = vec4(1e6, 0.0, 1.0, 1.0);
	for (int i = 0; i < 8; i++) {
		if (i >= rect_count) break;
		vec2 cs = rect_cs[i];
		vec2 q = p - rects[i].xy;
		q = vec2(q.x * cs.x - q.y * cs.y, q.x * cs.y + q.y * cs.x);   // into its own frame
		vec2 d = abs(q) - rects[i].zw;
		float dist = length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
		bool round_one = rects[i].w < 0.0;     // a round thing (the bowl): radius in z
		if (round_one) dist = length(q) - rects[i].z;
		if (dist < best.x) {
			vec2 nl = d.x > d.y ? vec2(sign(q.x), 0.0) : vec2(0.0, sign(q.y));
			if (d.x > 0.0 && d.y > 0.0) nl = normalize(d * sign(q));
			if (round_one) nl = q / max(length(q), 1e-4);
			best = vec4(dist, nl.x * cs.x + nl.y * cs.y, -nl.x * cs.y + nl.y * cs.x, rect_top[i]);
		}
	}
	return best;
}
float drift_amount(vec2 p, vec4 nb) {
	float ww = clamp(dot(nb.yz, -wind), 0.0, 1.0);   // this side faces the wind
	float reach = 0.16 + 0.32 * ww + 0.12 * vnoise2(p * 1.7 + 3.0);
	return exp(-max(nb.x, 0.0) / reach);
}
float dunes_at(vec2 p, float o) {
	float k = smoothstep(1.2, 7.0, o);
	if (k <= 0.0) return 0.0;
	return k * ((vnoise2(p * 0.11) - 0.5) * 1.1 + (vnoise2(p * 0.37 + 7.0) - 0.5) * 0.18);
}
// the sand's height at p, given the nearest object there
float height_at(vec2 p, vec4 nb) {
	if (nb.x < -0.15) return -0.25; // hidden under the object
	float o = max(nb.x, 0.0);
	if (o > 2.0) return dunes_at(p, o);
	float face = dot(nb.yz, -wind);
	float ww = clamp(face, 0.0, 1.0);
	float lee = clamp(-face, 0.0, 1.0);
	// uneven along the edge: lumps a hand-width apart, and the odd bigger drift; sized to
	// what it is drifted against - against a plank it laps at the top edge, against the
	// tray's rim it banks up a good way
	float lump = vnoise2(p * 2.6) * 0.65 + vnoise2(p * 7.0 + 5.0) * 0.35;
	float big = smoothstep(0.55, 0.85, vnoise2(p * 0.9 + 17.0));
	float h_obj = max(nb.w, 0.03);
	float amp = min(h_obj * (0.35 + 0.45 * lump + 0.4 * big) * (0.55 + 0.75 * ww), 0.24);
	float berm = amp * drift_amount(p, nb) + 0.25 * h_obj * exp(-o / 0.05);
	// the lee: a shallow scoop right against it, then a low tail further out
	berm -= lee * 0.014 * exp(-o / 0.1) * (1.0 - exp(-o / 0.03));
	berm += lee * 0.01 * exp(-pow((o - 0.45) / 0.3, 2.0));
	berm = min(berm, nb.w - 0.012);   // never over the top of what it is drifted against
	return berm + dunes_at(p, o);
}
void vertex() {
	vec3 w = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	float e = 0.02;
	vec4 nb = nearest(w.xz);
	float h = height_at(w.xz, nb);
	// slope: the same nearest object a step away (it does not change over 2 cm)
	float sx = (height_at(w.xz + vec2(e, 0), nearest(w.xz + vec2(e, 0))) - h) / e;
	float sz = (height_at(w.xz + vec2(0, e), nearest(w.xz + vec2(0, e))) - h) / e;
	VERTEX.y += h;
	NORMAL = normalize(vec3(-sx, 1.0, -sz));
	TANGENT = normalize(vec3(1.0, sx, 0.0));
	BINORMAL = normalize(cross(NORMAL, TANGENT));
	wp = w + vec3(0.0, h, 0.0);
	drift = nb.x < -0.15 ? 0.0 : drift_amount(w.xz, nb);
}
void fragment() {
	vec2 uv = wp.xz / tile;
	vec3 a = texture(alb_tex, uv).rgb;
	vec3 b = texture(alb_tex, uv * 0.29 + vec2(0.37, 0.71)).rgb;
	float macro = vnoise2(wp.xz * 0.22) * 0.6 + vnoise2(wp.xz * 0.8 + 3.0) * 0.4;
	vec3 col = mix(a, b, 0.3) * mix(0.9, 1.07, macro);
	col = mix(col, col * vec3(1.06, 0.96, 0.88), vnoise2(wp.xz * 0.13 + 11.0) * 0.6);
	// drifted sand is fine and fresh: a shade paler and smoother, ripples blown away
	float dr = smoothstep(0.15, 0.85, drift);
	col *= mix(1.0, 1.05, dr);
	// the crease where the sand meets the object: it sees little sky and little bounce
	float d = max(nearest(wp.xz).x, 0.0);
	float crease = 1.0 - smoothstep(0.0, 0.06, d);
	col *= 1.0 - 0.38 * crease * crease;
	ALBEDO = col;
	AO = 1.0 - 0.7 * (1.0 - smoothstep(0.0, 0.16, d));
	AO_LIGHT_AFFECT = 0.45;
	NORMAL_MAP = texture(nrm_tex, uv).rgb;
	NORMAL_MAP_DEPTH = mix(1.0, 0.25, dr);
	ROUGHNESS = 0.94;
	SPECULAR = 0.3;
}
"""


func _ready() -> void:
	ui_font = SystemFont.new()
	ui_font.font_names = PackedStringArray(["Copperplate", "Optima", "Georgia"])
	ui_font.font_weight = 700
	build_environment()
	build_board()
	build_bowl()
	build_tray()
	build_pieces()
	build_dice()
	build_hands()
	build_ui()
	build_audio()
	new_game()


# ======================================================================
# Materials and meshes
# ======================================================================

func tex(path: String) -> ImageTexture:
	if tex_cache.has(path):
		return tex_cache[path]
	var img: Image = (load(path) as Texture2D).get_image()
	if img.is_compressed():
		img.decompress()
	img.generate_mipmaps()
	var t := ImageTexture.create_from_image(img)
	tex_cache[path] = t
	return t


func base_mat(color: Color, rough := 0.7) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = color
	m.roughness = rough
	return m


## Wood with triplanar mapping (works on any box), tinted and scaled.
func wood_mat(tint: Color, scale: float, nrm := 1.0) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_texture = tex("res://assets/wood_albedo.png")
	m.albedo_color = tint
	m.normal_enabled = true
	m.normal_texture = tex("res://assets/wood_normal.png")
	m.normal_scale = nrm
	m.roughness = 1.0
	m.roughness_texture = tex("res://assets/wood_rough.png")
	m.uv1_triplanar = true
	m.uv1_scale = Vector3(scale, scale, scale)
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	return m


## A carved panel texture set (name_albedo / name_normal / name_rough).
func panel_mat(prefix: String) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_texture = tex("res://assets/%s_albedo.png" % prefix)
	m.normal_enabled = true
	m.normal_texture = tex("res://assets/%s_normal.png" % prefix)
	m.normal_scale = 1.4
	m.roughness = 1.0
	m.roughness_texture = tex("res://assets/%s_rough.png" % prefix)
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	return m


func stone_mat(white: bool) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_texture = tex("res://assets/stone_white_albedo.png" if white else "res://assets/stone_black_albedo.png")
	m.normal_enabled = true
	m.normal_texture = tex("res://assets/stone_normal.png")
	m.normal_scale = 1.0
	m.albedo_color = Color(0.9, 0.89, 0.86) if white else Color(1, 1, 1)
	m.roughness = 1.0 if white else 0.85  # scaled by the dirt/dust roughness map
	m.roughness_texture = tex("res://assets/stone_rough.png")
	m.uv1_triplanar = true
	m.uv1_scale = Vector3(1.9, 1.9, 1.9)
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	return m


func add_plane(size: Vector2, at: Vector3, m: Material, yaw := 0.0, parent: Node = self) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	var pm := PlaneMesh.new()
	pm.size = size
	mi.mesh = pm
	mi.material_override = m
	mi.position = at
	mi.rotation_degrees.y = yaw
	parent.add_child(mi)
	return mi


## A wooden slab with a carved panel on top, placed by a layout transform: the slab
## has worn, rounded edges; the panel covers only its flat top.
func add_slab(size: Vector2, xf: Transform3D, slab_mat: Material, panel: Material, dust: String, yaw := 0.0) -> void:
	var root := Node3D.new()
	root.transform = xf
	add_child(root)
	var slab := MeshInstance3D.new()
	slab.mesh = rounded_box(Vector3(size.x, 0.14, size.y), SLAB_R)
	slab.material_override = slab_mat
	slab.position = Vector3(0, BY - 0.072, 0)
	slab.layers = 1 | DUSTED
	root.add_child(slab)
	var top := add_plane(size - Vector2(2, 2) * SLAB_R, Vector3(0, BY, 0), panel, yaw, root)
	top.layers = 1 | DUSTED
	add_dust(dust, root, Vector3(size.x + 0.02, 0.24, size.y + 0.02), Vector3(0, BY, 0))


## Wind-blown sand lying on a piece of wood or clay (assets/dust_<name>.png, made by
## tools/make_dust.py): a decal over its top, `size` (x, height, z) centred at `at` in
## `parent`'s frame. It settles only on surfaces in the DUSTED layer - the board, strips,
## plates, tray and tablet - never on the stones, dice or hands moving over them.
func add_dust(name: String, parent: Node3D, size: Vector3, at: Vector3) -> void:
	var dc := Decal.new()
	dc.texture_albedo = tex("res://assets/dust_%s.png" % name)
	dc.size = size
	dc.position = at
	dc.cull_mask = DUSTED
	dc.normal_fade = 0.35       # a little down the rounded edges, none on the sides
	dc.upper_fade = 0.1
	dc.lower_fade = 0.1
	parent.add_child(dc)


func place_xf(x: float, z: float, yaw_deg: float) -> Transform3D:
	return Transform3D(Basis(Vector3.UP, deg_to_rad(yaw_deg)), Vector3(x, 0, z))


func board_xf() -> Transform3D:
	return place_xf(0, 0, BOARD_YAW)


func strip_xf(p: int) -> Transform3D:
	var v: Vector3 = STRIP_PLACE[p]
	return place_xf(v.x, v.y, v.z)


func plate_xf(p: int) -> Transform3D:
	var v: Vector3 = PLATE_NUDGE[p]
	return place_xf(HOME_X + v.x, home_z(p) + v.y, v.z)


## Maps the square, unrotated tray layout (TRAY) to where the tray actually lies.
func tray_xf() -> Transform3D:
	var c := Vector3(TRAY.get_center().x, 0, TRAY.get_center().y)
	return place_xf(c.x + TRAY_NUDGE.x, c.z + TRAY_NUDGE.y, TRAY_NUDGE.z) * Transform3D(Basis(), -c)


## A world point in the tray's own (unrotated) layout, as (x, z) - compare with TRAY.
func tray_local(p: Vector3) -> Vector2:
	var q := tray_xf().affine_inverse() * p
	return Vector2(q.x, q.z)


## UV-sphere style mesh; point_fn maps a unit direction to a surface point.
## The two poles are welded to single vertices so smooth normals have no seam.
func grid_mesh(point_fn: Callable, rows: int, cols: int) -> ArrayMesh:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	st.add_vertex(point_fn.call(Vector3.UP))
	for i in range(1, rows):
		var th := PI * i / rows
		for j in cols:
			var ph := TAU * j / cols
			st.add_vertex(point_fn.call(Vector3(sin(th) * cos(ph), cos(th), sin(th) * sin(ph))))
	st.add_vertex(point_fn.call(Vector3.DOWN))
	var bottom := 1 + (rows - 1) * cols
	for j in cols:
		var j2 := (j + 1) % cols
		# top fan
		st.add_index(0)
		st.add_index(1 + j)
		st.add_index(1 + j2)
		# bottom fan
		var base := 1 + (rows - 2) * cols
		st.add_index(base + j)
		st.add_index(bottom)
		st.add_index(base + j2)
	for i in range(1, rows - 1):
		for j in cols:
			var j2 := (j + 1) % cols
			var a := 1 + (i - 1) * cols + j
			var b := 1 + (i - 1) * cols + j2
			var c := 1 + i * cols + j
			var d := 1 + i * cols + j2
			st.add_index(a)
			st.add_index(c)
			st.add_index(b)
			st.add_index(b)
			st.add_index(c)
			st.add_index(d)
	st.generate_normals()
	return st.commit()


## Box with rounded edges and corners (radius r), centred on the origin.
## Vertices bunch up around the edges so the rounding stays smooth.
func rounded_box(size: Vector3, r: float, seg := 5, step := 0.25) -> ArrayMesh:
	var h := size / 2.0
	var inner := h - Vector3(r, r, r)
	var coords: Array = []
	for a in 3:
		var iv: float = inner[a]
		var c: Array = []
		for k in range(seg, 0, -1):
			c.append(-(iv + r * tan(PI / 4.0 * k / seg)))
		var mids := maxi(1, int(ceil(iv * 2.0 / step)))
		for k in mids + 1:
			c.append(-iv + 2.0 * iv * k / mids)
		for k in range(1, seg + 1):
			c.append(iv + r * tan(PI / 4.0 * k / seg))
		coords.append(c)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var base := 0
	for a in 3:
		var b := (a + 1) % 3
		var c := (a + 2) % 3
		for sgn in [-1.0, 1.0]:
			var cb: Array = coords[b]
			var cc: Array = coords[c]
			var face_n := Vector3.ZERO
			face_n[a] = sgn
			for u in cb:
				for v in cc:
					var q := Vector3.ZERO
					q[a] = sgn * h[a]
					q[b] = u
					q[c] = v
					var cl := q.clamp(-inner, inner)
					var n := (q - cl).normalized()
					var p := cl + n * r
					st.set_normal(n)
					st.set_uv(Vector2(p[b], p[c]))
					st.add_vertex(p)
			var nv := cc.size()
			for i in cb.size() - 1:
				for j in nv - 1:
					var i0 := base + i * nv + j
					var quad := [i0, i0 + nv, i0 + 1, i0 + 1, i0 + nv, i0 + nv + 1]
					# Godot front faces wind clockwise seen from outside
					var tri_n := _axis_vec(b, 1.0).cross(_axis_vec(c, 1.0))
					if tri_n.dot(face_n) > 0.0:
						quad = [i0, i0 + 1, i0 + nv, i0 + 1, i0 + nv + 1, i0 + nv]
					for idx in quad:
						st.add_index(idx)
			base += cb.size() * nv
	st.generate_tangents()
	return st.commit()


func _axis_vec(a: int, s: float) -> Vector3:
	var v := Vector3.ZERO
	v[a] = s
	return v


## A natural pebble: a flattened egg-shaped superellipsoid, chipped by a few flat
## facets, with a flat underside. Each seed gives a different stone.
func make_stone(seed_v: int) -> ArrayMesh:
	var noise := FastNoiseLite.new()
	noise.seed = seed_v
	noise.noise_type = FastNoiseLite.TYPE_SIMPLEX
	noise.frequency = 1.0
	var rng := RandomNumberGenerator.new()
	rng.seed = seed_v
	var a := PIECE_R * rng.randf_range(1.0, 1.12)
	var c := PIECE_R * rng.randf_range(0.76, 0.92)
	var b := 0.195
	var n := rng.randf_range(2.2, 2.7)
	var egg := rng.randf_range(-0.16, 0.16)
	var tilt := rng.randf_range(-0.04, 0.04)
	var off := Vector3(rng.randf() * 20, rng.randf() * 20, rng.randf() * 20)
	var hb := 0.065
	var cuts: Array = []
	for i in rng.randi_range(3, 5):
		var cn := Vector3(rng.randf_range(-1, 1), rng.randf_range(-0.1, 0.9), rng.randf_range(-1, 1)).normalized()
		var support := Vector3(a * cn.x, b * cn.y, c * cn.z).length()
		cuts.append([cn, support * rng.randf_range(0.74, 0.9)])
	var fn := func(dir: Vector3) -> Vector3:
		var q := pow(absf(dir.x) / a, n) + pow(absf(dir.y) / b, n) + pow(absf(dir.z) / c, n)
		var p := dir / pow(q, 1.0 / n)
		p.x *= 1.0 + egg * p.z / c
		p.y += tilt * p.x / a
		p *= 1.0 + 0.04 * noise.get_noise_3dv(dir * 1.3 + off)
		for cut in cuts:
			var dist: float = p.dot(cut[0]) - cut[1]
			if dist > 0.0:
				p -= (cut[0] as Vector3) * dist
		p.y = maxf(p.y, -hb)
		p.y += hb - PIECE_H / 2.0 # flat underside sits exactly on the surface
		return p
	return grid_mesh(fn, 40, 72)


func die_sdf(p: Vector3, nrm: Array) -> float:
	var s := 0.0
	for n in nrm:
		s += exp(DIE_K * ((n as Vector3).dot(p) - DIE_H))
	return log(s) / DIE_K


func die_radius(d: Vector3, nrm: Array) -> float:
	var lo := 0.05
	var hi := 2.0
	for it in 18:
		var mid := (lo + hi) * 0.5
		if die_sdf(d * mid, nrm) < 0.0:
			lo = mid
		else:
			hi = mid
	return (lo + hi) * 0.5


